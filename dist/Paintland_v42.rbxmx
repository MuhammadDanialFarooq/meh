<?xml version='1.0' encoding='utf-8'?>
<roblox version="4"><External>null</External><External>nil</External><Item class="Folder" referent="RBXPaintlandV42"><Properties><string name="Name">PaintlandV42</string></Properties><Item class="Folder" referent="RBXInstallReplicatedStorage"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBXPaintlandModules"><Properties><string name="Name">PaintlandModules</string></Properties><Item class="ModuleScript" referent="RBXModuleAbilityHUD"><Properties><string name="Name">AbilityHUD</string><ProtectedString name="Source">local Registry=require(script.Parent.AbilityRegistry)
local Fonts=require(script.Parent.Fonts)
local ButtonEffects=require(script.Parent.ButtonEffects)
local UIS=game:GetService("UserInputService")
local HUD={};HUD.__index=HUD
local INK=Color3.fromRGB(40,35,76)
local function make(parent,class,name,p)
    local o=Instance.new(class);o.Name=name;for k,v in pairs(p) do o[k]=v end;o.Parent=parent;return o
end
function HUD.new(screen,cfg,onRequest)
    local self=setmetatable({cfg=cfg,onRequest=onRequest,active=false,buttons={},remaining={},pending={}},HUD)
    self.root=make(screen,"Frame","Abilities",{BackgroundTransparency=1,Visible=false,ZIndex=150,Active=false})
    for _,ability in ipairs(Registry.List) do
        local button=make(self.root,"TextButton",ability.Id,{AnchorPoint=Vector2.new(.5,.5),Text="",
            BackgroundColor3=ability.Color,BorderSizePixel=0,AutoButtonColor=false,ZIndex=151})
        make(button,"UICorner","Round",{CornerRadius=UDim.new(0,16)})
        make(button,"UIStroke","Outline",{Color=INK,Thickness=2})
        local title=make(button,"TextLabel","Name",{Position=UDim2.fromOffset(2,8),Size=UDim2.new(1,-4,0,17),
            Text=ability.Name,TextColor3=INK,FontFace=Fonts.Bold,TextSize=11,BackgroundTransparency=1,Active=false,ZIndex=152})
        local status=make(button,"TextLabel","Cooldown",{Position=UDim2.fromOffset(2,29),Size=UDim2.new(1,-4,0,22),
            Text=ability.Key,TextColor3=INK,FontFace=Fonts.Bold,TextSize=16,BackgroundTransparency=1,Active=false,ZIndex=152})
        ButtonEffects.SetSize(button,UDim2.fromOffset(68,60));ButtonEffects.Bind(button,cfg)
        button.Activated:Connect(function() self:Request(ability.Id) end)
        self.buttons[ability.Id]={button=button,title=title,status=status,definition=ability}
    end
    self.input=UIS.InputBegan:Connect(function(input,processed)
        if processed or UIS:GetFocusedTextBox() then return end
        for _,ability in ipairs(Registry.List) do
            if input.KeyCode==Enum.KeyCode[ability.Key] or input.KeyCode==Enum.KeyCode[ability.Gamepad] then
                self:Request(ability.Id);return
            end
        end
    end)
    return self
end
function HUD:Request(id)
    if not self.active or (self.remaining[id] or 0)&gt;0 or (self.pending[id] or 0)&gt;0 then return end
    self.pending[id]=1
    self.onRequest(id)
    self:Update(0)
end
function HUD:SetActive(active)
    self.active=active and self.cfg.AbilitiesEnabled~=false
    self.root.Visible=self.active
    if not self.active then table.clear(self.pending) end
end
function HUD:SetState(state)
    self.remaining=table.clone(state.cooldowns or {})
    if state.id then self.pending[state.id]=nil end
    self:Update(0)
end
function HUD:Update(dt)
    for id,view in pairs(self.buttons) do
        local left=math.max(0,(self.remaining[id] or 0)-(self.active and dt or 0));self.remaining[id]=left
        local waiting=math.max(0,(self.pending[id] or 0)-dt);self.pending[id]=waiting
        view.status.Text=waiting&gt;0 and "…" or (left&gt;0 and (tostring(math.ceil(left)).."s") or (UIS.TouchEnabled and "READY" or view.definition.Key))
        view.status.TextSize=UIS.TouchEnabled and left&lt;=0 and 11 or 16
        view.button.BackgroundTransparency=(left&gt;0 or waiting&gt;0) and .4 or 0
    end
end
function HUD:Resize(size)
    local portrait=size.X&lt;600 and size.Y&gt;=500
    local columns=math.min(portrait and 2 or 4,#Registry.List)
    local rows=math.ceil(#Registry.List/math.max(1,columns))
    self.root.Size=UDim2.fromOffset(columns*76-8,rows*68-8)
    self.root.AnchorPoint=Vector2.new(portrait and 1 or .5,1)
    self.root.Position=portrait and UDim2.new(1,-12,1,-68) or UDim2.new(.5,0,1,-12)
    for i,ability in ipairs(Registry.List) do
        self.buttons[ability.Id].button.Position=UDim2.fromOffset(((i-1)%columns)*76+34,math.floor((i-1)/columns)*68+30)
    end
end
function HUD:Destroy()
    self.input:Disconnect();self.root:Destroy()
end
return HUD
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleAbilityRegistry"><Properties><string name="Name">AbilityRegistry</string><ProtectedString name="Source">-- Register future modules here; the server and HUD both consume this list.
-- Contract: Id, Name, Key, Gamepad, Color, Cooldown(config), Activate(world, actor, config).
local Registry={List={require(script.Parent.Splash),require(script.Parent.Dash)},ById={}}
for _,ability in ipairs(Registry.List) do
    assert(type(ability.Id)=="string" and not Registry.ById[ability.Id],"Duplicate ability id")
    Registry.ById[ability.Id]=ability
end
return Registry
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleAbilityService"><Properties><string name="Name">AbilityService</string><ProtectedString name="Source">-- The authority supplies the world and actor; client payloads contain only an ID.
local Registry=require(script.Parent.AbilityRegistry)
local Service={};Service.__index=Service
function Service.new(cfg) return setmetatable({cfg=cfg},Service) end
function Service:State(world,actor)
    local state={}
    for _,ability in ipairs(Registry.List) do
        state[ability.Id]=math.max(0,((actor.abilityReadyAt or {})[ability.Id] or 0)-world.time)
    end
    return state
end
function Service:Use(world,actor,id,running)
    local ability=type(id)=="string" and Registry.ById[id]
    if not ability then return false,"Unknown ability" end
    if self.cfg.AbilitiesEnabled==false then return false,"Abilities are disabled" end
    if not running or not world or world.completed or not actor or not actor.alive then
        return false,"Abilities need an active match"
    end
    actor.abilityReadyAt=actor.abilityReadyAt or {}
    if (actor.abilityReadyAt[id] or 0)&gt;world.time then return false,"Ability is cooling down" end
    -- Reserve before activation, including any capture/elimination callbacks.
    local previous=actor.abilityReadyAt[id]
    actor.abilityReadyAt[id]=world.time+ability.Cooldown(self.cfg)
    local ok,result=ability.Activate(world,actor,self.cfg)
    if not ok then actor.abilityReadyAt[id]=previous;return false,result end
    return true,result
end
return Service
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleArcadeEffects"><Properties><string name="Name">ArcadeEffects</string><ProtectedString name="Source">-- Visual-only, pooled impact effects. This never changes territory or kills.
-- Screen-space drawing follows a world-space origin so the camera may keep moving.
local ArcadeEffects = {}
ArcadeEffects.__index = ArcadeEffects

local function makeLayer(parent)
    local f = Instance.new("Frame")
    f.Name = "ArcadeEffectsLayer"
    f.BackgroundTransparency = 1
    f.BorderSizePixel = 0
    f.Size = UDim2.fromScale(1, 1)
    f.ClipsDescendants = true
    f.Active = false
    f.ZIndex = 18
    f.Parent = parent
    return f
end

local function ring(parent)
    local f = Instance.new("Frame")
    f.Name = "ImpactRipple"
    f.BackgroundTransparency = 1
    f.BorderSizePixel = 0
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Visible = false
    f.ZIndex = 18
    f.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = f
    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Thickness = 2.3
    stroke.Parent = f
    return {frame = f, stroke = stroke}
end

local function shard(parent)
    local f = Instance.new("Frame")
    f.Name = "ImpactSpark"
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.BorderSizePixel = 0
    f.ZIndex = 19
    f.Visible = false
    f.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0.32, 0)
    corner.Parent = f
    return f
end

local function easeOut(t)
    return 1 - (1 - t)^3
end

function ArcadeEffects.new(renderer, cfg)
    return setmetatable({
        renderer = renderer,
        cfg = cfg,
        layer = makeLayer(renderer.screen),
        activeRings = {}, activeSparks = {},
        freeRings = {}, freeSparks = {},
        totalRings = 0, totalSparks = 0,
        rng = Random.new(),
    }, ArcadeEffects)
end

function ArcadeEffects:_project(point, camera)
    return self.renderer:GetPlayerScreenPosition(point, 0.5)
end

function ArcadeEffects:_visible(point)
    local world = self.renderer.world
    if not world then return false end
    local size = self.renderer.viewport.AbsoluteSize
    local center = self:_project(point, world.entities[1] and
        (self.currentCamera or world.entities[1].pos) or Vector2.zero)
    return center.X &gt; -120 and center.X &lt; size.X + 120
        and center.Y &gt; -120 and center.Y &lt; size.Y + 120
end

function ArcadeEffects:_ring(point, color, width, duration, delay)
    if self.cfg.ImpactEffectsEnabled == false or self.cfg.ReducedMotion then return end
    local maxRings = self.cfg.ImpactMaxRings or 14
    if #self.activeRings &gt;= maxRings then return end
    if not self:_visible(point) then return end
    local obj = table.remove(self.freeRings)
    if not obj then
        if self.totalRings &gt;= maxRings then return end
        obj = ring(self.layer)
        self.totalRings += 1
    end
    obj.frame.Visible = false
    obj.stroke.Color = color
    obj.stroke.Thickness = 2.4
    self.activeRings[#self.activeRings + 1] = {
        obj = obj, pos = point, age = -(delay or 0),
        duration = duration, radius = width, color = color,
    }
end

function ArcadeEffects:_burst(point, color, amount, strength)
    if self.cfg.ImpactEffectsEnabled == false or self.cfg.ReducedMotion then return end
    if not self:_visible(point) then return end
    local max = self.cfg.ImpactMaxSparks or 64
    local mobile = self.renderer.viewport.AbsoluteSize.X &lt; 700
    local count = math.min(mobile and math.ceil(amount * 0.55) or amount,
        max - #self.activeSparks)
    for _ = 1, count do
        local obj = table.remove(self.freeSparks)
        if not obj then
            if self.totalSparks &gt;= max then break end
            obj = shard(self.layer)
            self.totalSparks += 1
        end
        local angle = self.rng:NextNumber(0, math.pi * 2)
        local length = self.rng:NextNumber(strength * 0.38, strength)
        local velocity = Vector2.new(math.cos(angle), math.sin(angle)) * length
        local size = self.rng:NextNumber(3, 6)
        obj.BackgroundColor3 = color:Lerp(Color3.new(1,1,1), self.rng:NextNumber(0.15, 0.6))
        obj.Size = UDim2.fromOffset(size, size * self.rng:NextNumber(1, 2.1))
        obj.BackgroundTransparency = 0
        obj.Visible = true
        self.activeSparks[#self.activeSparks + 1] = {
            gui = obj, pos = point, velocity = velocity,
            age = 0, lifetime = self.rng:NextNumber(0.32, 0.65),
            rotation = self.rng:NextNumber(-180, 180),
            spin = self.rng:NextNumber(-240, 240),
        }
    end
end

function ArcadeEffects:Capture(entity, count)
    if not entity or not entity.alive or count &lt;= 0 then return end
    if not entity.isHuman and self.cfg.ImpactShowBotCaptures == false then return end
    local magnitude = math.clamp(math.sqrt(count) / 8, 0.6, 2.1)
    self:_ring(entity.pos, entity.color, 36 * magnitude, 0.48, 0)
    if entity.isHuman then
        self:_ring(entity.pos, Color3.new(1, 1, 1), 26 * magnitude, 0.33, 0.10)
        self:_burst(entity.pos, entity.color, math.clamp(math.floor(4 + math.sqrt(count) * 0.5), 6, 15), 68)
    end
end

function ArcadeEffects:Elimination(victim, killer, hit)
    if not victim then return end
    local color = killer and killer.color or victim.color
    local origin = hit and hit.position or victim.pos
    self:_ring(origin, Color3.new(1, 1, 1), 42, 0.22, 0)
    self:_ring(origin, color, 80, 0.42, 0.035)
    local humanInvolved = victim.isHuman or (killer and killer.isHuman)
    self:_burst(origin, color, humanInvolved and 14 or 4,
        humanInvolved and 125 or 55)
end

function ArcadeEffects:Merge(killer, cells, grid)
    if not killer or not cells or not grid then return end
    local chosen = {}
    local seen = 0
    -- Reservoir sample is constant-memory even when a huge region is absorbed.
    for index in pairs(cells) do
        seen += 1
        if #chosen &lt; 3 then
            chosen[#chosen + 1] = index
        else
            local j = self.rng:NextInteger(1, seen)
            if j &lt;= 3 then chosen[j] = index end
        end
    end
    for _, index in ipairs(chosen) do
        local x = (index - 1) % grid.size + 1
        local y = math.floor((index - 1) / grid.size) + 1
        self:_ring(grid:Center(x, y), killer.color, 56, 0.55, 0.06)
    end
end

function ArcadeEffects:Spawn(entity)
    if not entity or not entity.isHuman then return end
    self:_ring(entity.pos, entity.color, 52, 0.46, 0)
end

function ArcadeEffects:Ability(id,entity,effect)
    if not entity then return end
    local origin=effect and effect.x and Vector2.new(effect.x,effect.y) or entity.pos
    if id=="Splash" then
        self:_ring(origin,entity.color,100,.5,0)
        self:_ring(origin,Color3.new(1,1,1),70,.4,.08)
        self:_burst(origin,entity.color,18,100)
    else
        self:_ring(origin,Color3.new(1,1,1),32,.25,0)
        self:_burst(origin,entity.color,9,75)
    end
end

function ArcadeEffects:Update(dt, cameraPosition)
    self.currentCamera = cameraPosition
    dt = math.clamp(dt or 0, 0, 0.07)
    for i = #self.activeRings, 1, -1 do
        local item = self.activeRings[i]
        item.age += dt
        local t = item.age / item.duration
        if t &gt;= 1 then
            item.obj.frame.Visible = false
            table.insert(self.freeRings, item.obj)
            table.remove(self.activeRings, i)
        elseif t &gt;= 0 then
            local p = self:_project(item.pos, cameraPosition)
            local radius = (8 + item.radius * easeOut(t)) * self.renderer.pixelScale / 4
            local obj = item.obj
            obj.frame.Visible = true
            obj.frame.Position = UDim2.fromOffset(p.X, p.Y)
            obj.frame.Size = UDim2.fromOffset(radius * 2, radius * 2)
            obj.stroke.Transparency = math.clamp(0.16 + t^1.8 * 0.84, 0, 1)
            obj.stroke.Thickness = 2.5 * (1 - t * 0.5)
        end
    end
    for i = #self.activeSparks, 1, -1 do
        local item = self.activeSparks[i]
        item.age += dt
        local t = item.age / item.lifetime
        if t &gt;= 1 then
            item.gui.Visible = false
            table.insert(self.freeSparks, item.gui)
            table.remove(self.activeSparks, i)
        else
            local gravity = Vector2.new(0, 30)
            local travel = item.velocity * (item.age * (1 - t * 0.38)) + gravity * (item.age^2 * 0.5)
            local p = self:_project(item.pos, cameraPosition) + travel
            item.gui.Position = UDim2.fromOffset(p.X, p.Y)
            item.gui.Rotation = item.rotation + item.spin * item.age
            item.gui.BackgroundTransparency = math.clamp(t * t, 0, 1)
        end
    end
end

function ArcadeEffects:Clear()
    self.currentCamera = nil
    for i = #self.activeRings, 1, -1 do
        local item = self.activeRings[i]
        item.obj.frame.Visible = false
        table.insert(self.freeRings, item.obj)
        self.activeRings[i] = nil
    end
    for i = #self.activeSparks, 1, -1 do
        local item = self.activeSparks[i]
        item.gui.Visible = false
        table.insert(self.freeSparks, item.gui)
        self.activeSparks[i] = nil
    end
end

function ArcadeEffects:Destroy()
    self:Clear()
    self.layer:Destroy()
end

return ArcadeEffects
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleAudioController"><Properties><string name="Name">AudioController</string><ProtectedString name="Source">-- Local, bounded, non-spatial arcade feedback. No downloaded assets are required
-- for the default bundled Roblox ping. Replace cue IDs with permitted audio.
local SoundService = game:GetService("SoundService")
local Cues = require(script.Parent.AudioCues)
local Audio = {}
Audio.__index = Audio

function Audio.new(cfg)
    local self = setmetatable({cfg=cfg, muted=cfg.SoundMutedByDefault==true, destroyed=false, pools={}, cursors={}}, Audio)
    self.folder = Instance.new("Folder")
    self.folder.Name = "PaintlandAudio"
    self.folder.Parent = SoundService
    self.group = Instance.new("SoundGroup")
    self.group.Name = "PaintlandEffects"
    self.group.Volume = math.clamp(cfg.SoundMasterVolume or 0.65, 0, 1)
    self.group.Parent = SoundService
    for _, channel in ipairs({"Kill", "Capture", "Spawn", "Death", "Victory"}) do
        local pool = {}
        self.pools[channel] = pool
        for i=1, (channel == "Kill" and 5 or channel == "Capture" and 3 or 1) do
            local sound = Instance.new("Sound")
            sound.Name = channel .. i
            sound.SoundGroup = self.group
            sound.Looped = false
            sound.Parent = self.folder
            pool[i] = sound
        end
        self.cursors[channel] = 0
    end
    return self
end

function Audio:Play(channel, id, pitch, volume)
    if self.destroyed or self.muted or self.cfg.SoundEnabled == false or not id or id == "" then return end
    local pool = self.pools[channel]
    if not pool then return end
    local cursor = self.cursors[channel] % #pool + 1
    self.cursors[channel] = cursor
    local sound = pool[cursor]
    -- A channel reuses its oldest voice rather than allocating on every event.
    sound:Stop()
    sound.SoundId = tostring(id):match("^%d+$") and ("rbxassetid://" .. id) or id
    sound.PlaybackSpeed = math.clamp(pitch or 1, 0.5, 3)
    sound.Volume = math.clamp(volume or 0.5, 0, 1)
    sound.TimePosition = 0
    sound:Play()
end

function Audio:Kill(streak)
    local id, pitch = Cues.Kill(self.cfg, streak)
    self:Play("Kill", id, pitch, self.cfg.KillSoundVolume or 0.75)
end

function Audio:Capture(count, playableTotal)
    if self.destroyed or self.muted or self.cfg.SoundEnabled==false then return end
    local repeats=Cues.CaptureRepeats(count,playableTotal)
    local id=Cues.Capture(self.cfg,count,playableTotal)
    if repeats==0 or not id or id=="" then return end
    -- Replace the unfinished reward instead of accumulating asynchronous jobs.
    for _,sound in ipairs(self.pools.Capture) do sound:Stop() end
    self.captureSequence={id=id,total=repeats,played=0,wait=0,
        interval=math.clamp(self.cfg.CaptureRepeatInterval or .045,.03,.15),
        startPitch=math.clamp(self.cfg.CaptureSequenceStartPitch or 1,.5,3),
        endPitch=math.clamp(self.cfg.CaptureSequenceEndPitch or 1.6,.5,3)}
    self:Update(0)
end

function Audio:Update(dt)
    if self.destroyed or not self.captureSequence then return end
    if self.muted or self.cfg.SoundEnabled==false then
        self.captureSequence=nil
        for _,sound in ipairs(self.pools.Capture) do sound:Stop() end
        return
    end
    if type(dt)~="number" or dt~=dt or dt&lt;0 then return end
    local sequence=self.captureSequence
    sequence.wait-=dt
    if sequence.wait&gt;0 then return end
    -- At most one note per rendered frame. A stall stretches the sequence;
    -- it never fires a pile of overdue sounds in one frame.
    local t=sequence.played/math.max(1,sequence.total-1)
    self:Play("Capture",sequence.id,sequence.startPitch+(sequence.endPitch-sequence.startPitch)*t,
        self.cfg.CaptureSoundVolume or .35)
    sequence.played+=1
    sequence.wait=sequence.interval
    if sequence.played&gt;=sequence.total then self.captureSequence=nil end
end

function Audio:Spawn()
    self:Play("Spawn", self.cfg.SpawnSoundId or self.cfg.SoundBaseId, 1.1, 0.3)
end

function Audio:Death()
    self:Reset()
    self:Play("Death", self.cfg.DeathSoundId or self.cfg.SoundBaseId, 0.55, 0.45)
end

function Audio:Victory()
    self:Play("Victory", self.cfg.VictorySoundId or self.cfg.SoundBaseId, 1.8, 0.6)
end

function Audio:Reset()
    if self.destroyed then return end
    self.captureSequence=nil
    for channel, pool in pairs(self.pools) do
        for _, sound in ipairs(pool) do sound:Stop() end
        self.cursors[channel] = 0
    end
end

function Audio:SetMuted(muted)
    self.muted = muted == true
    if self.muted then self:Reset() end
end

function Audio:Destroy()
    if self.destroyed then return end
    self:Reset()
    self.destroyed = true
    self.folder:Destroy()
    self.group:Destroy()
end

return Audio
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleAudioCues"><Properties><string name="Name">AudioCues</string><ProtectedString name="Source">-- Pure cue selection, shared by the controller and deterministic tests.
local Cues = {}

function Cues.Kill(cfg, streak)
    local tier = math.clamp(math.floor(streak or 1), 1, 5)
    local ids = cfg.KillSoundIds or {}
    local custom = ids[tier]
    if custom and custom ~= "" and custom ~= 0 then
        return tostring(custom):match("^%d+$") and ("rbxassetid://" .. custom) or custom, 1, tier
    end
    local pitches = cfg.KillSoundPitches or {0.9, 1.01, 1.13, 1.35, 1.51}
    return cfg.SoundBaseId or "rbxasset://sounds/electronicpingshort.wav", pitches[tier], tier
end

function Cues.Capture(cfg, count, playableTotal)
    if not count or count &lt;= 0 or not playableTotal or playableTotal &lt;= 0 then return nil end
    local gain = cfg.CaptureSoundMetric == "Tiles" and count or count / playableTotal * 100
    local step = math.max(0.001, cfg.CaptureSoundStep or 5)
    -- Thresholds are per completed capture, not total territory held.
    local tier = math.floor(gain / step + 1e-9)
    local pitch = math.clamp((cfg.CaptureSoundBasePitch or 0.9)
        * 2 ^ (tier * (cfg.CaptureSoundSemitonesPerStep or 0.6) / 12), 0.5, 3)
    local id = cfg.CaptureSoundId or cfg.SoundBaseId or "rbxasset://sounds/electronicpingshort.wav"
    if tostring(id):match("^%d+$") then id = "rbxassetid://" .. id end
    return id, pitch, tier
end

-- Positive net percentage-point gain determines the number of reward notes.
-- 0.5 points -&gt; 5, 1.0 -&gt; 13 (rounded), 1.5 or more -&gt; 20.
function Cues.CaptureRepeats(count, playableTotal)
    if type(count)~="number" or type(playableTotal)~="number"
        or count~=count or playableTotal~=playableTotal or count&lt;=0 or playableTotal&lt;=0
        or count==math.huge or playableTotal==math.huge then return 0 end
    local gain=count/playableTotal*100
    return math.floor(5+15*math.clamp((gain-.5),0,1)+.5)
end

return Cues
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleAvatarThumbnails"><Properties><string name="Name">AvatarThumbnails</string><ProtectedString name="Source">-- Lazy, cached avatar thumbnails for real Roblox UserIds.
-- Fake/offline AI identities get a fallback icon, not an invented face.
local Players = game:GetService("Players")
local Avatars = {}
Avatars.__index = Avatars

function Avatars.new()
    return setmetatable({cache={}, pending={}, failures={}}, Avatars)
end

function Avatars:Get(userId)
    if type(userId) ~= "number" or userId &lt;= 0 then return nil end
    userId = math.floor(userId)
    if self.cache[userId] then return self.cache[userId] end
    if self.pending[userId] or self.failures[userId] then return nil end

    self.pending[userId] = true
    task.spawn(function()
        local ok, url, ready = pcall(function()
            return Players:GetUserThumbnailAsync(
                userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150
            )
        end)
        self.pending[userId] = nil
        if ok and type(url) == "string" and url ~= "" then
            self.cache[userId] = url
        else
            self.failures[userId] = true
            warn("[Paintland] Avatar thumbnail unavailable for UserId", userId)
        end
    end)
    return nil
end

function Avatars:Destroy()
    table.clear(self.pending)
    table.clear(self.cache)
end

return Avatars
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleBotAI"><Properties><string name="Name">BotAI</string><ProtectedString name="Source">local BotAI = {}
BotAI.__index = BotAI

function BotAI.new(cfg)
    return setmetatable({cfg = cfg, rng = Random.new()}, BotAI)
end

function BotAI:Plan(e, world)
    local rng = self.rng
    local home = world.grid:FindNearestOwned(e.id, e.pos)
    if home then e.home = home end
    local angle = rng:NextNumber(-math.pi, math.pi)
    local forward = Vector2.new(math.cos(angle), math.sin(angle))
    local side = Vector2.new(-forward.Y, forward.X)
    local base = e.personality == "Greedy" and 74
        or e.personality == "Defensive" and 35 or 51
    local reach = base * rng:NextNumber(0.82, 1.15)
    local lateral = reach * rng:NextNumber(0.75, 1.05)
    if rng:NextNumber() &lt; 0.5 then lateral = -lateral end
    local bound = world.grid.maskRadius - 14
    local function clamp(v)
        if v.Magnitude &gt; bound then return v.Unit * bound end
        return v
    end
    e.waypoints = {
        clamp(e.home + forward * reach),
        clamp(e.home + forward * reach + side * lateral),
        e.home,
    }
    e.waypoint = 1
    e.aiState = "Expand"
    e.aiStuck = 0
    e.aiLastPosition = e.pos
end

function BotAI:Update(e, world, dt)
    e.aiTimer -= dt
    if e.aiTimer &gt; 0 then return end
    e.aiTimer = self.rng:NextNumber(0.08, 0.15)

    if not e.waypoints or #e.waypoints == 0 then self:Plan(e, world) end
    if world.grid:GetOwnerAt(e.home) ~= e.id then
        local home = world.grid:FindNearestOwned(e.id, e.pos)
        if home then
            e.home = home
            e.waypoints[3] = home
        end
    end

    local target = e.waypoints[e.waypoint]
    if (target - e.pos).Magnitude &lt; 8 then
        e.waypoint += 1
        if e.waypoint &gt; #e.waypoints then
            self:Plan(e, world)
        end
        target = e.waypoints[e.waypoint]
    end
    if e.drawing and e.outsideDistance &gt; 205 then
        e.waypoint = 3
        e.aiState = "Return"
        target = e.home
    end
    if e.drawing and e.waypoint == 3 and world.grid:GetOwnerAt(e.home) ~= e.id then
        target = world.grid:FindNearestOwned(e.id, e.pos) or Vector2.zero
    end

    if not e.drawing and e.waypoint == 3 then
        self:Plan(e, world)
        target = e.waypoints[1]
    end

    if e.personality == "Aggressive" or e.personality == "Opportunist" then
        -- Opportunistic targeting is brief; otherwise triangle loop behavior
        -- produces more believable territory growth than endless chasing.
        if not e.drawing and self.rng:NextNumber() &lt; 0.04 then
            local nearest, distance = nil, 42
            for _, other in ipairs(world.entities) do
                if other.alive and other.id ~= e.id and other.drawing then
                    local d = (other.pos - e.pos).Magnitude
                    if d &lt; distance then nearest, distance = other, d end
                end
            end
            if nearest then target = nearest.pos end
        end
    end

    local off = world.grid.maskRadius - 15
    if e.pos.Magnitude &gt; off then
        target = Vector2.zero
    end
    local dir = target - e.pos
    if dir.Magnitude &gt; 0.5 then
        e.targetHeading = math.atan2(dir.Y, dir.X)
    end

    if (e.pos - e.aiLastPosition).Magnitude &lt; 1 then
        e.aiStuck += e.aiTimer
        if e.aiStuck &gt; 2 then self:Plan(e, world) end
    else
        e.aiStuck = 0
    end
    e.aiLastPosition = e.pos
end

return BotAI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleButtonEffects"><Properties><string name="Name">ButtonEffects</string><ProtectedString name="Source">-- V40: tween Size around a fixed center; never combine this with a button UIScale.
local TweenService=game:GetService("TweenService")
local Effects={}
local bindings=setmetatable({},{__mode="k"})
local function scaled(size,factor)
    return UDim2.new(size.X.Scale*factor,size.X.Offset*factor,size.Y.Scale*factor,size.Y.Offset*factor)
end
function Effects.SetSize(button,size)
    local state=bindings[button]
    if state then
        state.baseSize=size
        state:Animate(state.factor)
    else button.Size=size end
end
function Effects.Bind(button,cfg,options)
    if bindings[button] then return bindings[button] end
    options=options or {}
    local p,s,a=button.Position,button.Size,button.AnchorPoint
    button.Position=UDim2.new(p.X.Scale+s.X.Scale*(.5-a.X),p.X.Offset+s.X.Offset*(.5-a.X),
        p.Y.Scale+s.Y.Scale*(.5-a.Y),p.Y.Offset+s.Y.Offset*(.5-a.Y))
    button.AnchorPoint=Vector2.new(.5,.5);button.AutoButtonColor=false
    local oldScale=button:FindFirstChild("InteractionScale")
    if oldScale then oldScale:Destroy() end
    local state={baseSize=s,depthSize=options.depth and options.depth.Size,factor=1,motion={},fx={},idle={},particles={},connections={},serial=0,
        hovered=false,focused=false,pressed=false,lastBurst=-math.huge,destroyed=false}
    bindings[button]=state
    local function cancel(list)
        for _,t in ipairs(list) do t:Cancel() end
        table.clear(list)
    end
    local function connect(signal,fn)
        table.insert(state.connections,signal:Connect(fn))
    end
    local function visible()
        local ancestor=button
        while ancestor do
            if ancestor:IsA("GuiObject") and not ancestor.Visible then return false end
            if ancestor:IsA("ScreenGui") and not ancestor.Enabled then return false end
            ancestor=ancestor.Parent
        end
        return true
    end
    function state:Animate(factor,instant)
        cancel(self.motion)
        if self.destroyed or not button.Active or not visible() then factor=1;instant=true end
        self.factor=cfg.ReducedMotion and 1 or factor
        -- Both UDim components scale, keeping the pixel center fixed at every parent size.
        for _,object in ipairs(options.depth and {button,options.depth} or {button}) do
            local goal=scaled(object==button and self.baseSize or self.depthSize,self.factor)
            if instant or cfg.ReducedMotion then object.Size=goal
            else
                local t=TweenService:Create(object,TweenInfo.new(.14,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=goal})
                table.insert(self.motion,t);t:Play()
            end
        end
    end
    function state:ClearFX()
        self.serial+=1;cancel(self.fx)
        for _,spark in ipairs(self.particles) do spark.Visible=false end
        if self.slashLayer then self.slashLayer.Visible=false end
    end
    -- Adapted from the supplied UIEffects Shine/Sparkles. No tag observer,
    -- spring or sound-library dependency is required by these local effects.
    function state:StopIdle()
        cancel(self.idle)
        if self.shine then self.shine.Visible=false end
        if self.sparkleLayer then self.sparkleLayer.Visible=false end
    end
    function state:StartIdle()
        if not options.play or self.destroyed or cfg.ReducedMotion or not button.Active or not visible() then return end
        if #self.idle&gt;0 then return end
        if cfg.ButtonSlashEnabled~=false then
            if not self.shine then
                local layer=Instance.new("Frame");layer.Name="PlayShine"
                layer.Size=UDim2.new(1,-12,1,-12);layer.AnchorPoint=Vector2.new(.5,.5);layer.Position=UDim2.fromScale(.5,.5)
                layer.BackgroundTransparency=1;layer.BorderSizePixel=0;layer.ClipsDescendants=true
                layer.Active=false;layer.Selectable=false;layer.ZIndex=button.ZIndex+1;layer.Parent=button
                local inner=Instance.new("Frame");inner.Name="ShineSlash"
                inner.Size=UDim2.fromScale(1,1);inner.AnchorPoint=Vector2.new(0,.5)
                inner.BackgroundColor3=Color3.new(1,1,1);inner.BackgroundTransparency=.6;inner.BorderSizePixel=0
                inner.Active=false;inner.Selectable=false;inner.ZIndex=button.ZIndex+2;inner.Parent=layer
                local gradient=Instance.new("UIGradient");gradient.Rotation=23
                gradient.Transparency=NumberSequence.new({
                    NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(.182,.494),
                    NumberSequenceKeypoint.new(.308,1),NumberSequenceKeypoint.new(.484,1),
                    NumberSequenceKeypoint.new(.752,0),NumberSequenceKeypoint.new(.753,1),NumberSequenceKeypoint.new(1,1)})
                gradient.Parent=inner;self.shine=layer;self.shineInner=inner
            end
            self.shine.Visible=true;self.shineInner.Position=UDim2.fromScale(-2,.5)
            local t=TweenService:Create(self.shineInner,TweenInfo.new(1,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut,-1,false,1.5),
                {Position=UDim2.fromScale(1,.5)})
            table.insert(self.idle,t);t:Play()
        end
        if cfg.ButtonParticlesEnabled~=false then
            if not self.sparkleLayer then
                local layer=Instance.new("Frame");layer.Name="PlaySparkles";layer.Size=UDim2.fromScale(1,1)
                layer.BackgroundTransparency=1;layer.BorderSizePixel=0;layer.Active=false;layer.Selectable=false
                layer.ZIndex=button.ZIndex+3;layer.Parent=button;self.sparkleLayer=layer;self.sparkles={}
                for i,xy in ipairs({{.934,.581},{.143,.57},{.091,.266},{.12,.751},{.962,.281}}) do
                    local spark=Instance.new("ImageLabel");spark.Name="Sparkle"..i
                    spark.AnchorPoint=Vector2.new(.5,.5);spark.BackgroundTransparency=1
                    spark.Position=UDim2.fromScale(xy[1],xy[2]);spark.Image="rbxassetid://96254055681570"
                    spark.Active=false;spark.Selectable=false;spark.ZIndex=button.ZIndex+4;spark.Parent=layer
                    self.sparkles[i]=spark
                end
            end
            self.sparkleLayer.Visible=true
            for i,spark in ipairs(self.sparkles) do
                spark.Size=UDim2.fromOffset(10+i,10+i);spark.Rotation=i*37;spark.ImageTransparency=.15
                local t=TweenService:Create(spark,TweenInfo.new(.6,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true,.3+i*.12),
                    {Size=UDim2.fromOffset(0,0),Rotation=i*37+50,ImageTransparency=.8})
                table.insert(self.idle,t);t:Play()
            end
        end
    end
    function state:Reset()
        self.hovered=false;self.focused=false;self.pressed=false
        self:Animate(1,true);self:ClearFX();self:StopIdle()
    end
    function state:Burst()
        if self.destroyed or not button.Active or not visible() or cfg.ReducedMotion then return end
        if os.clock()-self.lastBurst&lt;.35 then return end
        self.lastBurst=os.clock();self:ClearFX()
        local serial=self.serial
        local function fx(object,duration,goals)
            local t=TweenService:Create(object,TweenInfo.new(duration,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),goals)
            table.insert(self.fx,t);t:Play()
        end
        if cfg.ButtonParticlesEnabled~=false then
            for i=1,8 do
                local spark=self.particles[i]
                if not spark then
                    spark=Instance.new("Frame");spark.Name="ButtonPaintSpark"
                    spark.AnchorPoint=Vector2.new(.5,.5);spark.BorderSizePixel=0
                    spark.Active=false;spark.Selectable=false;spark.ZIndex=button.ZIndex+3;spark.Parent=button
                    local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(1,0);corner.Parent=spark
                    self.particles[i]=spark
                end
                local angle=(i-1)*math.pi/4
                -- Start near the rim so paint remains visible against the button face.
                spark.Position=UDim2.new(.5+math.cos(angle)*.43,0,.5+math.sin(angle)*.38,0)
                spark.Size=UDim2.fromOffset(i%2==0 and 6 or 4,i%2==0 and 6 or 4)
                spark.BackgroundColor3=i%2==0 and Color3.new(1,1,1) or button.BackgroundColor3
                spark.BackgroundTransparency=.08;spark.Rotation=i*29;spark.Visible=true
                fx(spark,.46,{Position=UDim2.new(.5+math.cos(angle)*.56,math.cos(angle)*14,
                    .5+math.sin(angle)*.7,math.sin(angle)*15),Size=UDim2.fromOffset(1,1),BackgroundTransparency=1,Rotation=i*61})
            end
        end
        if options.play and cfg.ButtonSlashEnabled~=false then
            if not self.slashLayer then
                local layer=Instance.new("Frame");layer.Name="PlaySlashLayer";layer.Size=UDim2.new(1,-12,1,-12)
                layer.AnchorPoint=Vector2.new(.5,.5);layer.Position=UDim2.fromScale(.5,.5)
                layer.BackgroundTransparency=1;layer.ClipsDescendants=true;layer.BorderSizePixel=0
                layer.Active=false;layer.Selectable=false;layer.ZIndex=button.ZIndex+1;layer.Parent=button
                self.slashLayer=layer;self.slashes={}
                for i=1,2 do
                    local slash=Instance.new("Frame");slash.Name="Slash"..i;slash.AnchorPoint=Vector2.new(.5,.5)
                    slash.Size=UDim2.new(i==1 and .6 or .35,0,1,0);slash.Rotation=0
                    slash.BorderSizePixel=0;slash.BackgroundColor3=Color3.new(1,1,1)
                    slash.Active=false;slash.Selectable=false;slash.ZIndex=button.ZIndex+2;slash.Parent=layer
                    -- Draw the diagonal in a gradient so clipping does not depend
                    -- on the place's rotated-descendant clipping setting.
                    local band=Instance.new("UIGradient");band.Rotation=23
                    band.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),
                        NumberSequenceKeypoint.new(i==1 and .35 or .47,1),NumberSequenceKeypoint.new(.5,0),
                        NumberSequenceKeypoint.new(i==1 and .65 or .53,1),NumberSequenceKeypoint.new(1,1)})
                    band.Parent=slash
                    self.slashes[i]=slash
                end
            end
            self.slashLayer.Visible=true
            for i,slash in ipairs(self.slashes) do
                slash.Position=UDim2.new(-.2,-(i-1)*24,.5,0);slash.BackgroundTransparency=i==1 and .72 or .45
                fx(slash,.5,{Position=UDim2.new(1.2,-(i-1)*24,.5,0),BackgroundTransparency=1})
            end
        end
        task.delay(.52,function()
            if not self.destroyed and self.serial==serial then self:ClearFX() end
        end)
    end
    local function rest() return (state.hovered or state.focused) and 1.045 or 1 end
    local function enter()
        if not button.Active or not visible() then return end
        state.hovered=true;state:Animate(state.pressed and .95 or rest())
        if options.play then state:Burst() end
    end
    connect(button.MouseEnter,enter)
    connect(button.MouseLeave,function() state.hovered=false;state.pressed=false;state:Animate(rest()) end)
    connect(button.SelectionGained,function()
        if not button.Active or not visible() then return end
        state.focused=true;state:Animate(rest());if options.play then state:Burst() end
    end)
    connect(button.SelectionLost,function() state.focused=false;state.pressed=false;state:Animate(rest()) end)
    local function primary(input)
        return input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch
            or input.KeyCode==Enum.KeyCode.ButtonA
    end
    connect(button.InputBegan,function(input)
        if not primary(input) or not button.Active or not visible() then return end
        state.pressed=true;state:Animate(.95)
        if options.play then state:Burst() end
    end)
    connect(button.InputEnded,function(input)
        if primary(input) then state.pressed=false;state:Animate(rest()) end
    end)
    connect(button.Activated,function()
        if not button.Active or not visible() then return end
        state.pressed=false;state:Animate(rest());state:Burst()
    end)
    connect(button:GetPropertyChangedSignal("Active"),function()
        if not button.Active then state:Reset() else state:StartIdle() end
    end)
    -- Ancestor changes matter: menu and results screens hide their parent overlay.
    local ancestor=button
    while ancestor do
        if ancestor:IsA("GuiObject") or ancestor:IsA("ScreenGui") then
            connect(ancestor:GetPropertyChangedSignal(ancestor:IsA("ScreenGui") and "Enabled" or "Visible"),function()
                if not visible() then state:Reset() else state:StartIdle() end
            end)
        end
        ancestor=ancestor.Parent
    end
    connect(button.Destroying,function()
        state.destroyed=true;state:Reset()
        for _,connection in ipairs(state.connections) do connection:Disconnect() end
        table.clear(state.connections);bindings[button]=nil
    end)
    state:StartIdle()
    return state
end
return Effects
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleCameraController"><Properties><string name="Name">CameraController</string><ProtectedString name="Source">-- V21: stable 3/4-overhead camera, independent of input position or UI layout.
local UIS=game:GetService("UserInputService")
local Camera={}
Camera.__index=Camera
local function damp(pos,vel,target,frequency,dt)
    local w=math.max(.01,frequency)
    local d=pos-target
    local decay=math.exp(-w*dt)
    local temp=(vel+d*w)*dt
    return target+(d+temp)*decay,(vel-temp*w)*decay
end
function Camera.new(cfg)
    local self=setmetatable({cfg=cfg,position=Vector2.zero,base=Vector2.zero,
        velocity=Vector2.zero,kick=Vector2.zero,kickVelocity=Vector2.zero,initialized=false},Camera)
    self:Apply()
    return self
end
function Camera:Reset(target)
    self.position=target
    self.base=target
    self.velocity=Vector2.zero
    self.kick=Vector2.zero
    self.kickVelocity=Vector2.zero
    self.initialized=true
    self:Apply()
end
function Camera:CapturePulse(heading,count)
    if UIS.TouchEnabled or self.cfg.CaptureCameraEnabled==false then return end
    local scale=math.clamp(math.sqrt(math.max(count or 0,0))*.06,0,.4)
    self.kickVelocity+=Vector2.new(-math.cos(heading),-math.sin(heading))*scale*2.5
end
function Camera:KillPulse(heading,streak)
    if UIS.TouchEnabled or self.cfg.KillCameraEnabled==false then return end
    self.kickVelocity+=Vector2.new(-math.cos(heading),-math.sin(heading))*
        math.min(1.8,.7+(streak or 1)*.14)
end
function Camera:Update(target,dt)
    if not self.initialized then self:Reset(target) end
    dt=math.clamp(dt or 0,0,.05)
    self.base,self.velocity=damp(self.base,self.velocity,target,
        self.cfg.CameraSpringFrequency or 14,dt)
    self.kick,self.kickVelocity=damp(self.kick,self.kickVelocity,Vector2.zero,18,dt)
    self.position=self.base+self.kick
end
function Camera:Apply()
    local cam=workspace.CurrentCamera
    if not cam then return end
    cam.CameraType=Enum.CameraType.Scriptable
    cam.FieldOfView=self.cfg.WorkspaceCameraFOV or 48
    local screenHeight=cam.ViewportSize.Y
    local phone=UIS.TouchEnabled or (screenHeight&gt;0 and cam.ViewportSize.X&lt;650)
    local visible=phone and (self.cfg.MobileWorldViewHeight or 136) or
        (self.cfg.WorldViewHeightStuds or 124)
    local dist=(visible/2)/math.tan(math.rad(cam.FieldOfView)/2)
    local angle=math.rad(self.cfg.CameraTiltDegrees or 21)
    -- A small Z offset reveals the front and height of the toy characters.
    local center=Vector3.new(self.position.X,1.2,self.position.Y)
    local eye=center+Vector3.new(0,dist*math.cos(angle),dist*math.sin(angle))
    cam.CFrame=CFrame.lookAt(eye,center,Vector3.new(0,1,0))
    cam.Focus=CFrame.new(center)
end
return Camera
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleCaptureParticles"><Properties><string name="Name">CaptureParticles</string><ProtectedString name="Source">-- Cosmetic-only particle system. Spawns from *actual newly owned grid cells*,
-- and attracts toward the capturing actor as the camera moves. GUI is fully runtime-built.
-- Small bounded object pool; no per-particle tweens/connections or physics instances.
local CaptureParticles = {}
CaptureParticles.__index = CaptureParticles

local function makeParticle(parent)
    local body = Instance.new("Frame")
    body.Name = "LandSpark"
    body.AnchorPoint = Vector2.new(0.5, 0.5)
    body.BorderSizePixel = 0
    body.ZIndex = 16
    body.Visible = false
    body.Parent = parent
    local round = Instance.new("UICorner")
    round.CornerRadius = UDim.new(0.28, 0)
    round.Parent = body
    return body
end

function CaptureParticles.new(renderer, cfg)
    local layer = Instance.new("Frame")
    layer.Name = "CaptureParticleLayer"
    layer.BackgroundTransparency = 1
    layer.BorderSizePixel = 0
    layer.Size = UDim2.fromScale(1, 1)
    layer.ClipsDescendants = true
    layer.ZIndex = 15
    layer.Parent = renderer.screen
    return setmetatable({
        cfg = cfg,
        renderer = renderer,
        layer = layer,
        active = {},
        free = {},
        rng = Random.new(),
        total = 0,
    }, CaptureParticles)
end

function CaptureParticles:_get()
    local object = table.remove(self.free)
    if not object and self.total &lt; (self.cfg.CaptureParticlePoolLimit or 96) then
        object = makeParticle(self.layer)
        self.total += 1
    end
    return object
end

function CaptureParticles:_recycle(index)
    local particle = self.active[index]
    particle.gui.Visible = false
    table.insert(self.free, particle.gui)
    local last = #self.active
    self.active[index] = self.active[last]
    self.active[last] = nil
end

function CaptureParticles:Clear()
    for i = #self.active, 1, -1 do self:_recycle(i) end
end

function CaptureParticles:Emit(entity, grid, changedCells, cameraPosition)
    if not self.cfg.CaptureParticlesEnabled or self.cfg.ReducedMotion or not entity.alive then return end
    if type(changedCells) ~= "table" then return end
    local desired = entity.isHuman
        and (self.cfg.CaptureParticlesPlayerCount or 19)
        or (self.cfg.CaptureParticlesBotCount or 6)
    if desired &lt; 1 then return end

    local maxDistance = self.cfg.CaptureParticleMaxDistance or 100
    local possible = {}
    local visited = 0
    local rng = self.rng
    -- Uniform reservoir sample: fast, capped memory, independent of size of capture.
    for index in pairs(changedCells) do
        local x = (index - 1) % grid.size + 1
        local y = math.floor((index - 1) / grid.size) + 1
        local source = grid:Center(x, y)
        if (source - entity.pos).Magnitude &lt;= maxDistance then
            visited += 1
            if #possible &lt; desired then
                possible[#possible + 1] = source
            else
                local swap = rng:NextInteger(1, visited)
                if swap &lt;= desired then possible[swap] = source end
            end
        end
    end
    if #possible == 0 then return end

    local viewport = self.renderer.viewport
    local size = viewport.AbsoluteSize
    if size.X &lt; 1 or size.Y &lt; 1 then return end
    for _, source in ipairs(possible) do
        local screenStart = self.renderer:GetPlayerScreenPosition(source, 0.5)
        if screenStart.X &gt;= -24 and screenStart.X &lt;= size.X + 24
            and screenStart.Y &gt;= -24 and screenStart.Y &lt;= size.Y + 24 then
            local gui = self:_get()
            if not gui then break end
            local baseSize = rng:NextNumber(4.5, 8)
            gui.BackgroundColor3 = entity.color:Lerp(Color3.new(1, 1, 1), rng:NextNumber(0.14, 0.48))
            gui.Rotation = rng:NextInteger(-30, 30)
            gui.BackgroundTransparency = 0.08
            gui.Size = UDim2.fromOffset(baseSize, baseSize)
            gui.Position = UDim2.fromOffset(screenStart.X, screenStart.Y)
            gui.Visible = true
            self.active[#self.active + 1] = {
                gui = gui,
                source = source,
                target = entity,
                age = -rng:NextNumber(0, 0.10),
                duration = rng:NextNumber(0.40, 0.73),
                bend = rng:NextNumber(-21, 21),
                baseSize = baseSize,
            }
        end
    end
end

function CaptureParticles:Update(dt, cameraPosition)
    if #self.active == 0 then return end
    dt = math.clamp(dt, 0, 0.07)
    for i = #self.active, 1, -1 do
        local p = self.active[i]
        p.age += dt
        if p.age &gt; p.duration or not p.target.alive then
            self:_recycle(i)
        elseif p.age &gt;= 0 then
            p.gui.Visible = true
            local t = math.clamp(p.age / p.duration, 0, 1)
            local eased = 1 - (1 - t)^3
            local origin = self.renderer:GetPlayerScreenPosition(p.source, 0.5)
            local destination = self.renderer:GetPlayerScreenPosition(p.target.pos)
            local d = destination - origin
            local unitNormal = d.Magnitude &gt; 0.1 and Vector2.new(-d.Y, d.X).Unit or Vector2.zero
            local curved = origin:Lerp(destination, eased) + unitNormal * (math.sin(math.pi * t) * p.bend)
            local particleSize = math.max(1, p.baseSize * (1 - t * 0.82))
            p.gui.Position = UDim2.fromOffset(curved.X, curved.Y)
            p.gui.Size = UDim2.fromOffset(particleSize, particleSize)
            p.gui.BackgroundTransparency = math.clamp(0.1 + t^3 * 0.87, 0, 1)
            p.gui.Rotation += dt * 110
        else
            p.gui.Visible = false
        end
    end
end

function CaptureParticles:Destroy()
    self.active = {}
    self.free = {}
    self.layer:Destroy()
end

return CaptureParticles
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleCharacterVisuals"><Properties><string name="Name">CharacterVisuals</string><ProtectedString name="Source">-- V42: elastic slime character. Visual deformation never changes the PaperIO collider.
-- No external character models, MeshIds, uploaded hats, or invisible face plates.
local SlimeVisuals=require(script.Parent.SlimeVisuals)
local Fonts=require(script.Parent.Fonts)
local CharacterVisuals = {}
CharacterVisuals.__index = CharacterVisuals

local function make(parent, name, size, cf, color, shape, material)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = cf
    p.Shape = shape or Enum.PartType.Block
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Parent = parent
    return p
end

local function assetUri(value)
    if type(value) == "number" and value &gt; 0 then
        return "rbxassetid://" .. tostring(math.floor(value))
    end
    if type(value) == "string" then
        if value:match("^%d+$") then return "rbxassetid://" .. value end
        if value:match("^rbxassetid://%d+$") then return value end
    end
    return nil
end

local function newLabel(root, entity)
    local bb = Instance.new("BillboardGui")
    bb.Name = "PlayerName"
    bb.Adornee = root
    bb.Size = UDim2.fromOffset(172, 30)
    bb.StudsOffsetWorldSpace = Vector3.new(0, 4.55, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = 240
    bb.Parent = root
    local text = Instance.new("TextLabel")
    text.Name = "Name"
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.FontFace = Fonts.Bold
    text.TextSize = 15
    text.TextColor3 = Color3.fromRGB(255,255,255)
    text.TextStrokeColor3 = Color3.fromRGB(38,44,71)
    text.TextStrokeTransparency = 0
    text.Text = entity.name
    text.Parent = bb
    local crown = Instance.new("TextLabel")
    crown.Name = "LeaderCrown"
    crown.AnchorPoint = Vector2.new(0.5,1)
    crown.Position = UDim2.fromScale(0.5,0)
    crown.Size = UDim2.fromOffset(32,27)
    crown.BackgroundTransparency = 1
    crown.FontFace = Fonts.Bold
    crown.Text = "👑"
    crown.TextScaled = true
    crown.Visible = false
    crown.Parent = bb
    return text,crown
end

local function addHat(model, kind, color)
    local created = {}
    local function shape(name, size, cf, tone, typeShape)
        local p = make(model,name,size,model:GetPivot()*CFrame.new(0,-.8,0)*cf,tone,typeShape)
        created[#created+1] = p
        return p
    end
    if kind == "Crown" then
        local gold = Color3.fromRGB(255,208,54)
        shape("GoldBand",Vector3.new(3.6,.62,3.35),CFrame.new(0,3.23,0),gold,Enum.PartType.Ball)
        for i=-2,2 do
            local h = (i == 0) and 1.55 or 1.15
            shape("GoldPoint"..i,Vector3.new(.48,h,.5),CFrame.new(i*.63,3.70+(h-1.1)*.5,-.20),gold,Enum.PartType.Block)
        end
        shape("CrownGem",Vector3.new(.55,.55,.20),CFrame.new(0,3.40,-1.68),Color3.fromRGB(78,180,255),Enum.PartType.Ball)
    elseif kind == "Cap" then
        -- A curved cap, with a short rounded brim: no large blue cuboid in front.
        shape("CapCrown",Vector3.new(4.6,1.12,4.25),CFrame.new(0,3.0,0.15),color,Enum.PartType.Ball)
        shape("CapBrim",Vector3.new(3.0,.23,1.10),CFrame.new(0,2.77,-2.14),color,Enum.PartType.Ball)
    elseif kind == "TopHat" then
        local ink = Color3.fromRGB(39,38,69)
        shape("Brim",Vector3.new(4.6,.18,4.2),CFrame.new(0,3.20,0),ink,Enum.PartType.Ball)
        shape("Top",Vector3.new(3.1,2.12,3.0),CFrame.new(0,4.18,0),ink,Enum.PartType.Block)
        shape("Ribbon",Vector3.new(3.22,.30,3.1),CFrame.new(0,3.52,0),Color3.fromRGB(255,200,71))
    end
    return created
end

function CharacterVisuals.new(folder, cfg)
    return setmetatable({folder=folder,cfg=cfg,objects={},equipped={}},CharacterVisuals)
end

function CharacterVisuals:Create(entity)
    self:Remove(entity.id)
    local model=Instance.new("Model")
    model.Name="Player_"..entity.id
    model.Parent=self.folder
    local root=make(model,"Pivot",Vector3.new(.15,.15,.15),CFrame.new(),entity.color)
    root.Transparency=1
    model.PrimaryPart=root
    -- Body and lobes use actual rounded geometry. No invisible accessory plates.
    local shadow=make(model,"SoftShadow",Vector3.new(5.5,.14,4.5),CFrame.new(0,-2.35,.38),
        Color3.fromRGB(43,54,73),Enum.PartType.Ball)
    shadow.Transparency=.65
    -- Intersecting rounded lobes share the owner's paint color and lag separately
    -- on turns, making the silhouette behave like a soft puddle rather than feet.
    local lobes={}
    for i=1,4 do
        local angle=(i-1)*math.pi/2+math.pi/4
        lobes[i]=make(model,"SlimeLobe"..i,Vector3.new(2.7,1.45,2.8),
            CFrame.new(math.cos(angle)*1.65,-1.62,math.sin(angle)*1.65),entity.color,Enum.PartType.Ball)
    end
    local body=make(model,"SlimeBody",Vector3.new(5.8,4.8,5.5),
        CFrame.new(),entity.color,Enum.PartType.Ball)
    -- Small glossy cheek highlight placed on the visible curved body.
    local shine=make(model,"CheekLight",Vector3.new(.65,.88,.32),
        CFrame.new(-1.38,1.25,-2.14)*CFrame.Angles(0,0,math.rad(-18)),
        Color3.fromRGB(255,255,255),Enum.PartType.Ball)
    shine.Transparency=.38
    -- Large expressive eyeballs, facing -Z in the model's local coordinates.
    local face=Instance.new("Folder")
    face.Name="ProceduralFace"
    face.Parent=model
    for _,x in ipairs({-.91,.91}) do
        make(face,"EyeWhite",Vector3.new(1.28,1.41,.60),CFrame.new(x,.35,-2.48),
            Color3.fromRGB(255,252,250),Enum.PartType.Ball)
        make(face,"Pupil",Vector3.new(.53,.76,.29),CFrame.new(x+.07,.3,-2.82),
            Color3.fromRGB(32,40,62),Enum.PartType.Ball)
        make(face,"EyeShine",Vector3.new(.19,.22,.09),CFrame.new(x-.10,.56,-2.995),
            Color3.fromRGB(255,255,255),Enum.PartType.Ball)
    end
    local mouth=make(face,"Smile",Vector3.new(.72,.27,.18),CFrame.new(0,-.74,-2.48),
        Color3.fromRGB(42,43,65),Enum.PartType.Ball)
    for _,x in ipairs({-1.65,1.65}) do
        local blush=make(face,"Blush",Vector3.new(.48,.23,.17),CFrame.new(x,-.28,-2.11),
            Color3.fromRGB(255,138,149),Enum.PartType.Ball)
        blush.Transparency=.27
    end
    -- Decal on the body, not a visible part in front of the camera.
    local faceDecal=Instance.new("Decal")
    faceDecal.Name="CustomFace"
    faceDecal.Face=Enum.NormalId.Front
    faceDecal.Transparency=1
    faceDecal.Parent=body
    local name,crown=newLabel(root,entity)
    local record={model=model,root=root,body=body,shine=shine,face=face,faceDecal=faceDecal,lobes=lobes,shadow=shadow,
        elastic=SlimeVisuals.new(entity.pos,entity.heading),lastTime=os.clock(),rest={},
        name=name,crown=crown,hatParts={},cosmetics={},createdAt=os.clock()}
    self.objects[entity.id]=record
    local cosmetics=self.equipped[entity.id] or
        (entity.isHuman and self.cfg.PlayerCosmetics or self.cfg.BotCosmetics) or {}
    self:SetCosmetics(entity.id,cosmetics)
    return record
end

function CharacterVisuals:SetCosmetics(id,cosmetics)
    cosmetics=cosmetics or {}
    self.equipped[id]=cosmetics
    local r=self.objects[id]
    if not r then return end
    for _,p in ipairs(r.hatParts) do p:Destroy() end
    r.hatParts={}
    r.hatParts=addHat(r.model,cosmetics.Hat or "None",
        cosmetics.HatColor or Color3.fromRGB(59,138,242))
    local image=assetUri(cosmetics.FaceImageId)
    r.faceDecal.Texture=image or ""
    r.faceDecal.Transparency=image and 0 or 1
    for _,p in ipairs(r.face:GetChildren()) do
        if p:IsA("BasePart") then p.Transparency=image and 1 or (p.Name=="Blush" and .27 or 0) end
    end
    -- A 2D hat badge is optional, but never creates opaque geometry in the scene.
    if r.hatBadge then r.hatBadge:Destroy(); r.hatBadge=nil end
    local hatImage=assetUri(cosmetics.HatImageId)
    if hatImage then
        local gui=Instance.new("BillboardGui")
        gui.Name="HatBadge"
        gui.Adornee=r.root
        gui.AlwaysOnTop=true
        gui.Size=UDim2.fromOffset(42,42)
        gui.StudsOffsetWorldSpace=Vector3.new(0,5.6,0)
        gui.MaxDistance=180
        gui.Parent=r.root
        local img=Instance.new("ImageLabel")
        img.Size=UDim2.fromScale(1,1)
        img.BackgroundTransparency=1
        img.Image=hatImage
        img.Parent=gui
        r.hatBadge=gui
    end
    r.cosmetics=cosmetics
    -- Keep original local transforms; never recapture already-deformed body parts.
    for _,part in ipairs(r.model:GetDescendants()) do
        if part:IsA("BasePart") and part~=r.root and not r.rest[part] then
            r.rest[part]={size=part.Size,cf=r.root.CFrame:ToObjectSpace(part.CFrame)}
        end
    end
    for part in pairs(r.rest) do if not part.Parent then r.rest[part]=nil end end
end

function CharacterVisuals:Update(entity,isLeader)
    if not entity.alive then self:Remove(entity.id); return end
    local r=self.objects[entity.id] or self:Create(entity)
    r.name.Text=entity.name
    r.crown.Visible=isLeader
    r.body.Color=entity.color
    local now=os.clock()
    local elastic=SlimeVisuals.Step(r.elastic,entity.pos,entity.heading,now-r.lastTime,
        self.cfg.ReducedMotion or self.cfg.SlimeVisualsEnabled==false)
    r.lastTime=now
    local yaw=-entity.heading-math.pi/2
    local rootCF=CFrame.new(entity.pos.X,(self.cfg.CharacterHeight or 3.7)-1+elastic.bob,entity.pos.Y)
        *CFrame.Angles(0,yaw,0)
    r.root.CFrame=rootCF
    local deformation=CFrame.Angles(-elastic.lean,0,-elastic.turn*.7)
    for part,rest in pairs(r.rest) do
        if part.Parent then
            local at=rest.cf.Position
            if part==r.shadow then
                part.Size=Vector3.new(rest.size.X*elastic.x,rest.size.Y,rest.size.Z*elastic.z)
                part.CFrame=rootCF*rest.cf
            else
                local isLobe=table.find(r.lobes,part)
                local isBody=part==r.body or isLobe
                if isBody then
                    part.Color=entity.color
                    local wave=isLobe and math.sin(elastic.phase+isLobe*1.5)*.035 or 0
                    part.Size=Vector3.new(rest.size.X*(elastic.x+wave),rest.size.Y*elastic.y,rest.size.Z*(elastic.z-wave))
                end
                -- Face and accessories follow the same soft displacement without
                -- stretching their shapes, so eyes remain clear and readable.
                local localPosition=Vector3.new(at.X*elastic.x,at.Y*elastic.y-(1-elastic.y)*2.3,at.Z*elastic.z)
                if isLobe then localPosition+=Vector3.new(elastic.turn*math.sin(isLobe)*.65,0,elastic.lean*.8) end
                part.CFrame=rootCF*deformation*CFrame.new(localPosition)*rest.cf.Rotation
            end
        end
    end
end

function CharacterVisuals:Remove(id)
    local r=self.objects[id]
    if r then r.model:Destroy() end
    self.objects[id]=nil
end
function CharacterVisuals:Clear()
    for id in pairs(self.objects) do self:Remove(id) end
end
function CharacterVisuals:Destroy()
    self:Clear()
    table.clear(self.equipped)
end
return CharacterVisuals
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleChunkGeometry"><Properties><string name="Name">ChunkGeometry</string><ProtectedString name="Source">-- Compress rectangular runs of same-owner cells; used by arena and minimap.
local Geometry = {}

function Geometry.Rectangles(grid, cfg, chunkId, chunksWide)
    local n = cfg.Grid
    local zero = chunkId - 1
    local cx, cy = zero % chunksWide, math.floor(zero / chunksWide)
    local x1 = cx * cfg.Chunk + 1
    local y1 = cy * cfg.Chunk + 1
    local x2 = math.min(n, x1 + cfg.Chunk - 1)
    local y2 = math.min(n, y1 + cfg.Chunk - 1)
    local active, rectangles = {}, {}
    for y = y1, y2 do
        local nextActive = {}
        local x = x1
        while x &lt;= x2 do
            local owner = grid.owners[(y - 1) * n + x]
            if owner and owner &gt; 0 then
                local startX = x
                repeat
                    x += 1
                until x &gt; x2 or grid.owners[(y - 1) * n + x] ~= owner
                local key = owner .. ":" .. startX .. ":" .. (x - 1)
                local rect = active[key]
                if not rect then
                    rect = {x1 = startX, x2 = x - 1, y1 = y, y2 = y, owner = owner}
                    rectangles[#rectangles + 1] = rect
                else
                    rect.y2 = y
                end
                nextActive[key] = rect
            else
                x += 1
            end
        end
        active = nextActive
    end
    return rectangles
end


-- Pack an arbitrary set of grid indices into vertically merged rectangles.
-- Used for animated death absorptions. No one-Frame-per-cell allocations.
function Geometry.RectanglesFromSet(cells, n)
    if not cells or not next(cells) then return {} end
    local active, result = {}, {}
    for y = 1, n do
        local following = {}
        local x = 1
        while x &lt;= n do
            local index = (y - 1) * n + x
            if cells[index] then
                local firstX = x
                repeat
                    x += 1
                until x &gt; n or not cells[(y - 1) * n + x]
                local key = firstX .. ':' .. (x - 1)
                local rect = active[key]
                if rect then
                    rect.y2 = y
                else
                    rect = {x1 = firstX, x2 = x - 1, y1 = y, y2 = y}
                    result[#result + 1] = rect
                end
                following[key] = rect
            else
                x += 1
            end
        end
        active = following
    end
    return result
end

return Geometry
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleCollisionSystem"><Properties><string name="Name">CollisionSystem</string><ProtectedString name="Source">local CollisionSystem = {}

-- Sweep sampling is performed by Trails.Advance. This module only resolves
-- victims in nearby grid buckets, including optional old self-trail hits.
function CollisionSystem.Check(world, mover, position, time)
    if world.completed then return false end
    local victims = world.trails:HitList(mover, position, time)
    for id, hit in pairs(victims) do
        local victim = world.entities[id]
        if victim and victim.alive then
            if victim.id == mover.id then
                world:Eliminate(mover, mover, "self-trail")
                return false
            end
            world:Eliminate(victim, mover, "trail", nil, {index=hit.index,position=position})
        end
    end
    return mover.alive
end

return CollisionSystem
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleConfig"><Properties><string name="Name">Config</string><ProtectedString name="Source">local Config = {}

Config.Grid = 112
Config.Cell = 4
Config.Chunk = 28
Config.BotCount = 12
-- V14 input and HUD: one-finger drag steering, clean mobile presentation.
Config.TouchDeadzone = 18
Config.MouseDeadzone = 15
Config.LeaderboardRows = 4
Config.MinimapPhoneSize = 144
Config.MinimapDesktopSize = 190
Config.MinimapUpdateRate = 0.12


-- REVIVE WINDOW: game stays frozen while a real ad / Robux prompt is active.
-- Persistent additive wallet rewards (server-authoritative).
Config.CurrencyPersistenceEnabled = true
Config.CurrencyPersistInStudio = false -- Studio uses an isolated temporary wallet
Config.CurrencyDataStoreName = "PaintlandWalletV1"
Config.CurrencyAutosaveSeconds = 60
Config.CurrencyCaptureBaseCoins = 5
Config.CurrencyCoinsPerPercent = 10
Config.CurrencyKillCoins = 25
Config.CurrencyGemMinCapturePercent = .5
Config.CurrencyCaptureGemChance = .01
Config.CurrencyKillGemChance = .05
Config.CurrencyGemCooldownSeconds = 60
Config.AbilitiesEnabled = true
Config.SplashCooldownSeconds = 18
Config.SplashRadiusCells = 6
Config.DashCooldownSeconds = 8
Config.DashDurationSeconds = .65
Config.DashSpeedMultiplier = 2.25
Config.MultiplayerEnabled = true
Config.MultiplayerMaxPlayers = 8
Config.MultiplayerMinPlayers = 2
Config.MultiplayerFreeRevivesPerRun = 1
Config.MultiplayerSnapshotRate = 10
Config.MultiplayerInterpolationDelay = .12
Config.SlimeVisualsEnabled = true
Config.ReviveWindowSeconds = 4
Config.ReviveCountdownSoundId = "rbxasset://sounds/electronicpingshort.wav" -- replace with rbxassetid://...
Config.ReviveCountdownVolume = .35
Config.ResultsRevealSeconds = 2.0
Config.ReviveMaxAdsPerRun = 2
Config.ReviveTransactionTimeout = 90


-- === ARENA APPEARANCE (all generated at runtime) ===
-- Paste your uploaded Roblox image/decal ID here, e.g. 1234567890,
-- or "rbxassetid://1234567890". Keep 0 for the built-in subtle dotted floor.
Config.FloorTextureId = 0
Config.FloorTextureTileStuds = 32
Config.FloorTextureTransparency = 0.42
Config.FloorTextureTint = Color3.fromRGB(255, 255, 255)
Config.FloorColor = Color3.fromRGB(251, 249, 246)
Config.FloorDotColor = Color3.fromRGB(170, 206, 184)
Config.OutsideColor = Color3.fromRGB(174, 213, 222)
Config.BorderOuterColor = Color3.fromRGB(45, 50, 87)
Config.BorderInnerColor = Color3.fromRGB(250, 146, 114)
Config.BorderOuterThickness = 13 -- pixels at any zoom
Config.BorderInnerThickness = 5  -- pixels at any zoom
-- Toggle off only for debugging; exposed enemy trails are part of the gameplay.
Config.ShowBotTrails = true


-- Sample existing Roblox accounts, then use their verified display names.
-- An invalid ID is silently ignored by UserService. These are not live players.
Config.RandomUserIdMin = 10000000
Config.RandomUserIdMax = 2000000000
Config.NameLookupBatchSize = 44
Config.NameLookupAttempts = 3
Config.PlayerSpeed = 29
Config.BotSpeed = 27
Config.TurnRate = math.rad(610)
Config.TrailThickness = 3.3
Config.WorkspaceMergePartLimit = 26
Config.TrailSpacing = 3.5
Config.HitRadius = 3.4
Config.SpawnRadiusCells = 4
Config.RespawnDelay = 2.6
-- Safe-spawn: dead bots WAIT if no unclaimed, trail-free space exists.
Config.SpawnPaddingCells = 2
Config.SpawnMinEntityDistance = 36
Config.SpawnRetrySeconds = 2.5

-- Kill streaks: spring bounce and restrained arcade typography.
Config.KillPopupSpring = 17
Config.KillPopupDuration = 0.9
Config.KillComboWindowSeconds = 3
Config.KillCameraEnabled = true
Config.KillCameraImpulse = 5
Config.SimulationSubstep = 1 / 60
Config.MaxSubsteps = 4
Config.MaxChunksPerFrame = 6
-- V8 capture feedback: subtle world-space camera impulse; no strong shakes or zooms.
Config.CameraSpringFrequency = 25
Config.CameraKickSpringFrequency = 14
Config.CaptureCameraEnabled = true
Config.CaptureCameraImpulse = 18
Config.CameraKickMaxVelocity = 18
-- V8 cosmetic sparks originate in newly captured cells and curve toward the actor.
Config.CaptureParticlesEnabled = true
Config.CaptureParticlesPlayerCount = 19
Config.CaptureParticlesBotCount = 6
Config.CaptureParticlePoolLimit = 96
Config.CaptureParticleMaxDistance = 100
-- V12 arcade polish: all visual, pooled and mobile-aware.
Config.ImpactEffectsEnabled = true
Config.ButtonSlashEnabled = true -- diagonal highlight sweep on Play buttons
Config.ButtonParticlesEnabled = true -- bounded paint flecks on UI activation
Config.ReducedMotion = false -- disable moving sparks and trailing motes
Config.ImpactMaxRings = 14
Config.ImpactMaxSparks = 64
Config.ImpactShowBotCaptures = true
Config.MotionEffectsEnabled = true
Config.MotionDustPool = 14
Config.MotionDustInterval = 0.095
-- V31: Trail kills connect via recorded trails; other inheritance transfers directly.
-- The local HUMAN's land is reserved during their revive decision.
Config.DeathLandMergeMode = "TrailTakeover"
Config.TerritoryMergeEffectsEnabled = true
Config.TerritoryMergeOverlayLimit = 170
Config.TerritoryMergeDuration = 0.45
Config.TerritoryMergeWaveDelay = 0.25
-- Old all-land inheritance options are intentionally disabled.
Config.EnclosureTransfersAllLand = true
Config.TrailKillTransfersLand = true
Config.SelfTrailKills = true

-- V21 presentation: toy arena and stable phone framing.
Config.ArenaTileStuds = 16
Config.ArenaGridThickness = 0.10
Config.ArenaGridColor = Color3.fromRGB(219, 222, 228)
Config.CameraTiltDegrees = 21
Config.MobileWorldViewHeight = 144
Config.MouseWorldDeadzone = 2.5
Config.Colors = {
    Color3.fromRGB(23, 196, 158),
    Color3.fromRGB(253, 119, 95),
    Color3.fromRGB(70, 150, 250),
    Color3.fromRGB(172, 107, 250),
    Color3.fromRGB(253, 195, 65),
    Color3.fromRGB(250, 105, 163),
    Color3.fromRGB(98, 205, 101),
    Color3.fromRGB(60, 202, 221),
    Color3.fromRGB(235, 147, 85),
    Color3.fromRGB(127, 137, 248),
    Color3.fromRGB(188, 205, 57),
    Color3.fromRGB(234, 106, 190),
    Color3.fromRGB(81, 174, 116),
}

Config.BotNames = {
    "NeonFox", "SlyFox", "PixelKing", "Tornado", "Rex", "Doodle",
    "Pancake", "Shadow", "Flash", "Banana", "Squiggle", "Nova",
    "Orbit", "Goblin", "Vortex", "Jelly", "Cosmic", "Kiki",
}

Config.BotStyles = {"Farmer", "Aggressive", "Greedy", "Defensive", "Opportunist"}
-- V16: Smooth *curved* territories, not faceted polygons. The hidden
-- ownership grid still determines kills and scoring. Only the paint is softened.
Config.SmoothTerritoryEdges = true
Config.SmoothPixelsPerCell = 5          -- 560x560 image on desktop (112x5)
Config.SmoothPixelsPerCellMobile = 3    -- 336x336 on low-resolution phones
Config.SmoothDistanceBlur = 0.95      -- signed-distance smoothing; larger = rounder
Config.SmoothThinLandProtection = 0.35 -- keep narrow 1-cell land connections visible
Config.SmoothEdgeFeather = 0.15        -- antialias distance (cell units)
Config.SmoothCanvasInterval = 0.16     -- seconds between desktop canvas updates
Config.SmoothCanvasIntervalMobile = 0.32 -- less expensive on phones
-- V17 world-space character and camera. Real Parts live in Workspace.PaintlandRuntime.
Config.WorkspacePixelsPerStud = 4 -- legacy; no world SurfaceGui used
Config.Use3DTerritoryBackup = true -- single 3D land layer only
Config.WorkspaceBorderWidth = 6
Config.WorkspaceBorderInnerWidth = 2
Config.WorkspaceCameraFOV = 48
Config.WorldViewHeightStuds = 124
Config.CharacterHeight = 3.7
Config.DisableMobileCameraKick = true
Config.CameraSpringFrequency = 14
Config.CaptureCameraImpulse = 1.6
Config.KillCameraImpulse = 1.1
Config.CameraKickMaxVelocity = 4
-- Change these to accessible image/decal IDs, or 0 to leave the face empty.
Config.PlayerCosmetics = {
    Hat = "None",            -- "None", "Cap", "Crown", "TopHat"
    HatColor = Color3.fromRGB(42, 94, 210),
    FaceImageId = 0,        -- Image visible on top AND front of the character
    HatImageId = 0,         -- Optional image icon attached above the hat
}
Config.BotCosmetics = {Hat = "None", FaceImageId = 0, HatImageId = 0}

-- V22: circular playable arena and localized capture feedback
Config.CircleArena = true
Config.ArenaRadius = Config.Grid * Config.Cell * 0.5 - Config.Cell * 2
Config.ArenaBoundaryMargin = Config.Cell * 0.85
Config.CircleBorderStuds = 8
Config.CaptureWorldPopupDuration = 0.8
Config.CaptureWorldPopupMinCells = 3
Config.CaptureFlashMaxRegions = 24
Config.CaptureFlashMaxActive = 72
Config.CaptureFlashDuration = 0.24
Config.ExpandComboWindow = 6
Config.ExpandComboMax = 99
Config.ShowBotLandBillboards = false

-- Circular edge assist (must be declared BEFORE return).
Config.BoundaryAssistDepthCells = 2.5
Config.BoundaryAssistInwardCells = 2

-- Completion celebration; limited effects for mobile devices.
Config.VictoryEffectsEnabled = true
Config.VictoryConfettiCount = 34
Config.VictoryConfettiCountMobile = 20
Config.VictoryWorldSparkCount = 22
Config.VictoryWorldSparkCountMobile = 12
Config.VictoryTransitionSeconds = 0.35
-- Studio-only quick victory check; always ignored in published servers.
Config.StudioVictoryTest = false

-- Studio-only deterministic test for the 74%-to-0% ownership regression.
Config.RunVictoryRegressionTests = true

-- V28 local arcade audio. Five kill tiers; tier five repeats for streaks &gt;= 5.
Config.SoundEnabled = true
Config.SoundMutedByDefault = false -- Toggle SOUND in the UI to enable; replace the placeholder pings below.
Config.SoundMasterVolume = 0.65
Config.SoundBaseId = "rbxasset://sounds/electronicpingshort.wav"
Config.KillSoundIds = {} -- Optional five permitted rbxassetid:// IDs; custom cues play at native pitch.
Config.KillSoundPitches = {0.9, 1.01, 1.13, 1.35, 1.51}
Config.KillSoundVolume = 0.75
Config.CaptureSoundId = "rbxassetid://106879573498735"
Config.CaptureRepeatInterval = .045
Config.CaptureSequenceStartPitch = 1
Config.CaptureSequenceEndPitch = 1.6
Config.CaptureSoundVolume = 0.22
Config.SpawnSoundId = Config.SoundBaseId
Config.DeathSoundId = Config.SoundBaseId
Config.VictorySoundId = Config.SoundBaseId
Config.CaptureSoundMetric = "Percentage" -- "Tiles" uses raw cell gain instead.
Config.CaptureSoundStep = 5 -- 0..&lt;5, 5..&lt;10, 10..&lt;15 percentage points gained per capture.
Config.CaptureSoundBasePitch = 0.9
Config.CaptureSoundSemitonesPerStep = 0.6

-- Optional full-image replacements for the death buttons. Empty = Material sprite icons.
Config.DefeatPlayIconId = ""
Config.DefeatMenuIconId = ""

-- Silent bot-only backdrop in the main menu.
Config.MenuDemoBots = 8
Config.MenuDemoRoundSeconds = 55
Config.MenuDemoFollowSeconds = 12

return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleCoreGuiController"><Properties><string name="Name">CoreGuiController</string><ProtectedString name="Source">-- Hide Roblox's default player-list leaderboard, while preserving the
-- Roblox menu and accessibility/platform controls.
local StarterGui = game:GetService("StarterGui")

local CoreGuiController = {}

function CoreGuiController.DisablePlayerList()
    -- CoreGui may not be initialized on the first client frame.
    task.spawn(function()
        for attempt = 1, 12 do
            local ok = pcall(function()
                StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
            end)
            if ok then return end
            task.wait(0.3)
        end
        warn("[Paintland] Could not hide Roblox player list")
    end)
end

return CoreGuiController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleCosmeticController"><Properties><string name="Name">CosmeticController</string><ProtectedString name="Source">-- Public, runtime cosmetic API for your own skin shop / game passes.
-- CosmeticController.Equip(1, {Hat = "Crown", FaceImageId = 12345})
-- Uses local Workspace models; never trusts this table for paid ownership.
local Cosmetics = {}
local renderer = nil
local pending = {}

function Cosmetics.Bind(activeRenderer)
    renderer = activeRenderer
    for id, cosmetics in pairs(pending) do renderer:SetCosmetics(id, cosmetics) end
end

function Cosmetics.Equip(entityId, cosmetics)
    assert(type(entityId) == "number", "Entity ID must be a number")
    assert(type(cosmetics) == "table", "Cosmetics must be a table")
    pending[entityId] = cosmetics
    if renderer then renderer:SetCosmetics(entityId, cosmetics) end
end

function Cosmetics.EquipLocal(cosmetics)
    Cosmetics.Equip(1, cosmetics)
end

function Cosmetics.Get(entityId)
    return pending[entityId]
end

return Cosmetics
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleCurrencyService"><Properties><string name="Name">CurrencyService</string><ProtectedString name="Source">-- Server wallet. Clients cannot submit amounts or roll rewards.
-- Cumulative session receipts make retries and concurrent additive saves idempotent.
local Currency={};Currency.__index=Currency
local LIMIT=2147483647
local function amount(n)
    if type(n)~="number" or n~=n or n==math.huge or n==-math.huge then return 0 end
    return math.clamp(math.floor(n),0,LIMIT)
end
local function record(old)
    old=type(old)=="table" and old or {}
    return {version=1,coins=amount(old.coins),gems=amount(old.gems),lastGem=amount(old.lastGem),
        sessions=type(old.sessions)=="table" and table.clone(old.sessions) or {}}
end
function Currency.new(cfg,notify,deps)
    deps=deps or {}
    local store=deps.store
    local studio=deps.studio
    if studio==nil then studio=game:GetService("RunService"):IsStudio() end
    local persistent=cfg.CurrencyPersistenceEnabled~=false and (not studio or cfg.CurrencyPersistInStudio==true)
    if persistent and not store then store=game:GetService("DataStoreService"):GetDataStore(cfg.CurrencyDataStoreName or "PaintlandWalletV1") end
    local self=setmetatable({cfg=cfg,notify=notify,store=persistent and store or nil,entries={},timer=0,joinSerial=0,
        rng=deps.rng or Random.new(),spawn=deps.spawn or task.spawn,wait=deps.wait or task.wait,
        now=deps.now or os.time,session=deps.session or (persistent and game:GetService("HttpService"):GenerateGUID(false) or "studio")},Currency)
    return self
end
function Currency:Publish(player,reward)
    local e=self.entries[player];if not e then return end
    self.notify(player,{kind="wallet",coins=e.coins,gems=e.gems,loaded=e.loaded,
        persistent=self.store~=nil,saving=e.failed==true,deltaCoins=reward and reward.coins or 0,
        deltaGems=reward and reward.gems or 0,reason=reward and reward.reason or nil})
end
function Currency:Add(player)
    if self.entries[player] then return end
    self.joinSerial+=1
    local e={coins=0,gems=0,earnedCoins=0,earnedGems=0,savedCoins=0,savedGems=0,
        loaded=not self.store,failed=false,busy=false,lastGem=-math.huge,active=true,
        session=self.session..":"..self.joinSerial}
    self.entries[player]=e;self:Publish(player)
    if self.store then self.spawn(function() self:Save(player) end) end
end
function Currency:Grant(player,coins,gems,reason)
    local e=self.entries[player]
    if not e or not e.active then return end
    coins=math.min(amount(coins),LIMIT-e.earnedCoins);gems=math.min(amount(gems),LIMIT-e.earnedGems)
    e.earnedCoins+=coins;e.earnedGems+=gems
    e.coins=math.min(LIMIT,e.coins+coins);e.gems=math.min(LIMIT,e.gems+gems)
    if not self.store then e.savedCoins=e.earnedCoins;e.savedGems=e.earnedGems end
    self:Publish(player,{coins=coins,gems=gems,reason=reason})
end
function Currency:Gem(player,chance)
    local e=self.entries[player]
    if not e or not e.active or not e.loaded or self.now()-e.lastGem&lt;math.max(0,self.cfg.CurrencyGemCooldownSeconds or 60) then return 0 end
    if self.rng:NextNumber()&lt;math.clamp(chance or 0,0,1) then e.lastGem=self.now();return 1 end
    return 0
end
function Currency:Capture(player,count,total)
    if type(count)~="number" or count~=count or count&lt;=0 or count==math.huge or not total or total&lt;=0 then return end
    local points=math.min(100,count/total*100)
    local coins=amount(self.cfg.CurrencyCaptureBaseCoins or 5)+amount(points*(self.cfg.CurrencyCoinsPerPercent or 10))
    local gems=points&gt;=(self.cfg.CurrencyGemMinCapturePercent or .5) and self:Gem(player,self.cfg.CurrencyCaptureGemChance or .01) or 0
    self:Grant(player,coins,gems,"capture")
end
function Currency:Kill(player)
    self:Grant(player,self.cfg.CurrencyKillCoins or 25,self:Gem(player,self.cfg.CurrencyKillGemChance or .05),"kill")
end
function Currency:Save(player)
    local e=self.entries[player];if not e then return true end
    if not self.store then return true end
    if e.busy then return false end
    e.busy=true
    local coins,gems=e.earnedCoins,e.earnedGems
    local session,lastGem=e.session,e.lastGem
    local timestamp=self.now();local result,ok
    for attempt=1,3 do
        ok,result=pcall(function()
            return self.store:UpdateAsync("u_"..player.UserId,function(old)
                local data=record(old)
                local prior=data.sessions[session]
                local oldCoins=type(prior)=="table" and amount(prior.coins) or 0
                local oldGems=type(prior)=="table" and amount(prior.gems) or 0
                data.coins=math.min(LIMIT,data.coins+math.max(0,coins-oldCoins))
                data.gems=math.min(LIMIT,data.gems+math.max(0,gems-oldGems))
                data.lastGem=math.max(data.lastGem,lastGem)
                data.sessions[session]={coins=math.max(coins,oldCoins),gems=math.max(gems,oldGems),time=timestamp}
                -- Active sessions refresh every minute. Only long-expired receipts are pruned.
                for key,receipt in pairs(data.sessions) do
                    if key~=session and type(receipt)=="table" and type(receipt.time)=="number"
                        and timestamp-receipt.time&gt;30*86400 then data.sessions[key]=nil end
                end
                return data
            end)
        end)
        if ok and type(result)=="table" then break end
        ok=false
        if attempt&lt;3 then self.wait(attempt) end
    end
    e.busy=false;e.failed=not ok
    if ok then
        e.loaded=true;e.savedCoins=coins;e.savedGems=gems
        e.lastGem=math.max(e.lastGem,amount(result.lastGem))
        e.coins=math.min(LIMIT,amount(result.coins)+e.earnedCoins-coins)
        e.gems=math.min(LIMIT,amount(result.gems)+e.earnedGems-gems)
    end
    self:Publish(player)
    return ok
end
function Currency:Flush(player)
    local e=self.entries[player];if not e then return true end
    local started=os.clock()
    while e.busy and os.clock()-started&lt;12 do self.wait(.1) end
    if e.busy then return false end
    return self:Save(player)
end
function Currency:Remove(player)
    local e=self.entries[player];if not e then return end
    e.active=false
    if not self.store then self.entries[player]=nil;return end
    self.spawn(function()
        local ok=self:Flush(player)
        if ok then self.entries[player]=nil
        else warn("[Paintland Currency] Save pending for user "..tostring(player.UserId)) end
    end)
end
function Currency:Update(dt)
    if not self.store then return end
    self.timer+=math.max(0,dt)
    if self.timer&lt;math.max(15,self.cfg.CurrencyAutosaveSeconds or 60) then return end
    self.timer=0
    for player,e in pairs(self.entries) do
        if not e.busy then
            self.spawn(function()
                if self:Save(player) and not e.active then self.entries[player]=nil end
            end)
        end
    end
end
function Currency:Shutdown()
    if not self.store then table.clear(self.entries);return end
    local pending=0
    for player,e in pairs(self.entries) do
        e.active=false;pending+=1
        self.spawn(function() self:Flush(player);pending-=1 end)
    end
    local started=os.clock()
    while pending&gt;0 and os.clock()-started&lt;25 do self.wait(.1) end
end
return Currency
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleDash"><Properties><string name="Name">Dash</string><ProtectedString name="Source">-- Movement consumes this timed boost; no position teleport or collision bypass.
local Dash={Id="Dash",Name="DASH",Key="E",Gamepad="ButtonY",Color=Color3.fromRGB(255,210,85)}
function Dash.Cooldown(cfg) return math.clamp(cfg.DashCooldownSeconds or 8,1,300) end
function Dash.Activate(_,actor,cfg)
    actor.dashRemaining=math.clamp(cfg.DashDurationSeconds or .65,.1,2)
    actor.dashMultiplier=math.clamp(cfg.DashSpeedMultiplier or 2.25,1,3)
    return true,{duration=actor.dashRemaining,multiplier=actor.dashMultiplier}
end
return Dash
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleExpandComboController"><Properties><string name="Name">ExpandComboController</string><ProtectedString name="Source">-- V22: HUD ONLY. One reusable arcade callout for chained territory captures.
-- Individual +percent rewards live in TerritoryVFX's world BillboardGui.
local TweenService = game:GetService("TweenService")

local ExpandCombo = {}
ExpandCombo.__index = ExpandCombo

local function make(parent, kind, name)
    local inst = Instance.new(kind)
    inst.Name = name
    inst.Parent = parent
    return inst
end

function ExpandCombo.new(screen, cfg)
    local self = setmetatable({}, ExpandCombo)
    self.cfg = cfg
    self.streak = 0
    self.lastCapture = -math.huge
    self.generation = 0
    self.tweens = {}

    local holder = make(screen, "Frame", "ExpandComboHUD")
    holder.BackgroundTransparency = 1
    holder.AnchorPoint = Vector2.new(0.5, 0)
    holder.Position = UDim2.new(0.5, 0, 0.16, 0)
    holder.Size = UDim2.fromOffset(410, 105)
    holder.Visible = false
    holder.ZIndex = 90
    self.holder = holder

    local main = make(holder, "TextLabel", "ExpandCallout")
    main.BackgroundTransparency = 1
    main.AnchorPoint = Vector2.new(0.5, 0)
    main.Position = UDim2.fromScale(0.5, 0)
    main.Size = UDim2.new(1, 0, 0, 61)
    main.Font = Enum.Font.GothamBlack
    main.TextSize = 38
    main.Text = "EXPAND!"
    main.TextColor3 = Color3.new(1, 1, 1)
    main.TextStrokeColor3 = Color3.fromRGB(34, 38, 75)
    main.TextStrokeTransparency = 0.05
    main.TextXAlignment = Enum.TextXAlignment.Center
    main.ZIndex = 91
    self.main = main

    local combo = make(holder, "TextLabel", "ComboCounter")
    combo.BackgroundTransparency = 1
    combo.AnchorPoint = Vector2.new(0.5, 0)
    combo.Position = UDim2.new(0.5, 0, 0, 53)
    combo.Size = UDim2.new(1, 0, 0, 28)
    combo.Font = Enum.Font.GothamBlack
    combo.TextSize = 21
    combo.TextColor3 = Color3.fromRGB(255, 224, 91)
    combo.TextStrokeColor3 = Color3.fromRGB(42, 48, 83)
    combo.TextStrokeTransparency = 0.08
    combo.ZIndex = 92
    self.combo = combo

    self.scale = make(holder, "UIScale", "ExpandSpringScale")
    self.scale.Scale = 1
    return self
end

function ExpandCombo:Reset()
    self.generation += 1
    self.streak = 0
    self.lastCapture = -math.huge
    for _, t in ipairs(self.tweens) do t:Cancel() end
    table.clear(self.tweens)
    self.holder.Visible = false
end

function ExpandCombo:Show(percent, color)
    if percent &lt;= 0 then return end
    local now = time()
    local chainSeconds = self.cfg.ExpandComboWindow or 6
    self.streak = now - self.lastCapture &lt;= chainSeconds and self.streak + 1 or 1
    self.streak = math.min(self.streak, self.cfg.ExpandComboMax or 99)
    self.lastCapture = now
    self.generation += 1
    local version = self.generation
    for _, t in ipairs(self.tweens) do t:Cancel() end
    table.clear(self.tweens)

    local name = "EXPAND!"
    if percent &gt;= 1.2 then name = "MASSIVE EXPAND!"
    elseif percent &gt;= 0.65 then name = "AMAZING EXPAND!"
    elseif percent &gt;= 0.32 then name = "GREAT EXPAND!"
    elseif percent &gt;= 0.12 then name = "NICE EXPAND!" end

    self.holder.Visible = true
    self.main.Text = name
    self.main.TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.48)
    self.combo.Text = self.streak &gt;= 2 and ("CHAIN  x" .. self.streak) or "TERRITORY CAPTURED"
    self.main.TextTransparency = 0
    self.combo.TextTransparency = 0
    self.main.TextStrokeTransparency = 0.05
    self.combo.TextStrokeTransparency = 0.08
    self.holder.Position = UDim2.new(0.5, 0, 0.16, 13)
    self.scale.Scale = 0.68

    local spring = TweenService:Create(self.scale,
        TweenInfo.new(0.26, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Scale = 1})
    local rise = TweenService:Create(self.holder,
        TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        {Position = UDim2.new(0.5, 0, 0.16, 0)})
    self.tweens = {spring, rise}
    spring:Play()
    rise:Play()

    task.delay(0.75, function()
        if version ~= self.generation or not self.holder.Parent then return end
        local fadeInfo = TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        local a = TweenService:Create(self.main, fadeInfo,
            {TextTransparency = 1, TextStrokeTransparency = 1})
        local b = TweenService:Create(self.combo, fadeInfo,
            {TextTransparency = 1, TextStrokeTransparency = 1})
        self.tweens = {a, b}
        a:Play()
        b:Play()
        task.delay(0.3, function()
            if version == self.generation and self.holder.Parent then
                self.holder.Visible = false
            end
        end)
    end)
end

function ExpandCombo:Destroy()
    self:Reset()
    if self.holder then self.holder:Destroy() end
end

return ExpandCombo
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleFonts"><Properties><string name="Name">Fonts</string><ProtectedString name="Source">-- Roblox's built-in Montserrat family; no uploaded font or permission required.
-- https://create.roblox.com/docs/reference/engine/datatypes/Font
local FAMILY = "rbxasset://fonts/families/Montserrat.json"
return {
    Bold = Font.new(FAMILY, Enum.FontWeight.Bold, Enum.FontStyle.Normal),
    Regular = Font.new(FAMILY, Enum.FontWeight.Regular, Enum.FontStyle.Normal),
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleGameLoader"><Properties><string name="Name">GameLoader</string><ProtectedString name="Source">local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Modules = script.Parent
local Config = require(Modules.Config)
local Renderer = require(Modules.Renderer)
local CameraController = require(Modules.CameraController)
local InputController = require(Modules.InputController)
local UIController = require(Modules.UIController)
local World = require(Modules.World)
local NameService = require(Modules.NameService)
local ReviveController = require(Modules.ReviveController)
local CaptureParticles = require(Modules.CaptureParticles)
local KillFeedback = require(Modules.KillFeedback)
local LandMergeEffects = require(Modules.LandMergeEffects)
local ArcadeEffects = require(Modules.ArcadeEffects)
local MotionEffects = require(Modules.MotionEffects)
local CoreGuiController = require(Modules.CoreGuiController)
local CosmeticController = require(Modules.CosmeticController)
local ToyWorldFX = require(Modules.ToyWorldFX)
local ExpandComboController = require(Modules.ExpandComboController)
local TerritoryVFX = require(Modules.TerritoryVFX)
local VictoryController = require(Modules.VictoryController)
local VictoryWorldFX = require(Modules.VictoryWorldFX)

local AudioController = require(Modules.AudioController)

local MenuDemo = require(Modules.MenuDemo)
local MultiplayerClient = require(Modules.MultiplayerClient)
local AbilityService = require(Modules.AbilityService)
local MatchmakingUI = require(Modules.MatchmakingUI)

local Loader = {}

function Loader.Start()
    CoreGuiController.DisablePlayerList()
    local audio = AudioController.new(Config)
    if RunService:IsStudio() and Config.RunVictoryRegressionTests == true then
        local ok, err = xpcall(function()
            require(Modules.RegressionTests).Run(Config)
        end, debug.traceback)
        if not ok then warn("[Paintland V26 TEST FAILED] " .. tostring(err)) end
    end
    local localPlayer = Players.LocalPlayer
    local renderer = Renderer.new(Config, localPlayer:WaitForChild("PlayerGui"))
    CosmeticController.Bind(renderer)
    local camera = CameraController.new(Config)
    local particles = CaptureParticles.new(renderer, Config)
    local killFeedback = KillFeedback.new(renderer.screen, Config)
    local mergeEffects = LandMergeEffects.new(renderer, Config)
    local arcadeEffects = ArcadeEffects.new(renderer, Config)
    local motionEffects = MotionEffects.new(renderer, Config)
    local toyFX = ToyWorldFX.new(renderer, Config)
    local expandCombo = ExpandComboController.new(renderer.screen, Config)
    local territoryVFX = TerritoryVFX.new(renderer, Config)
    local input = InputController.new(Config)
    local world = nil
    local nameService = NameService.new(Config)
    local running, frozenForRevive = false, false
    local hudTimer = 0
    local ui, revive, victory, network, matchmaking
    local practiceAbilities=AbilityService.new(Config)
    local victoryFX = VictoryWorldFX.new(renderer, Config)
    local newMatch, startMenu
    local function clearPresentation()
        victoryFX:Clear();particles:Clear();mergeEffects:Clear();audio:Reset()
        killFeedback:Reset();arcadeEffects:Clear();motionEffects:Clear();toyFX:Clear()
        expandCombo:Reset();territoryVFX:Clear()
    end
    local demo=MenuDemo.new(Config,renderer,{
        onReset=clearPresentation,
        onCapture=function(e,count,cells,demoWorld)
            if count&gt;0 then
                territoryVFX:Play(e,count,cells,demoWorld.grid)
                toyFX:Capture(e,count)
            end
        end,
        onMerge=function(killer,victim,cells,hit)
            mergeEffects:Emit(killer,victim,cells,hit)
        end,
        onEliminate=function(victim,killer,_,hit)
            toyFX:Elimination(victim,killer,hit)
        end,
    })
    startMenu=function()
        if network and network.room and network.accepting~=false then network:Command("leave") end
        if matchmaking then matchmaking:Hide() end
        running=false;frozenForRevive=false
        if revive then revive:Close() end
        if victory then victory:Hide() end
        world=demo:Start()
        camera:Reset(demo.focus)
        ui:SetMode("menu")
    end

    -- A fresh game clears all previous actors, bots, trails, land and minimap data.
    newMatch = function(skin)
        if Config.MultiplayerEnabled~=false then
            demo:Stop();running=false;frozenForRevive=false
            if revive then revive:Close() end
            if victory then victory:Hide() end
            ui:NewRun();ui:SetMode("lobby")
            matchmaking:Show({private=false,code="",players={},capacity=Config.MultiplayerMaxPlayers or 8,state="lobby"})
            matchmaking:SetStatus("Connecting to an arena…")
            network:Command(network.room and "replay" or "quick",{skin=skin})
            return
        end
        -- Replay is the ONLY action that discards a completed arena.
        if victory then victory:Hide() end
        demo:Stop()
        frozenForRevive = false
        clearPresentation()
        if ui then ui:NewRun() end
        running = true
        if revive then revive:NewRun() end
        local nextWorld = World.new(Config, function(index)
            renderer:MarkCell(index)
            if ui and ui.minimap then ui.minimap:MarkCell(index) end
        end, {
            onSpawn = function(entity)
                renderer:ResetEntityVisual(entity.id)
                if entity.isHuman then
                    audio:Spawn()
                    camera:Reset(entity.pos)
                    arcadeEffects:Spawn(entity)
                    toyFX:Spawn(entity)
                    ui:SetMode("playing")
                    ui:Toast("CAPTURE THE ARENA!", entity.color)
                end
            end,
            onCapture = function(entity, count, changedCells)
                if entity.isHuman then audio:Capture(count, world.grid.playableTotal) end
                renderer:ClearTrail(entity.id)
                if count &gt; 0 then
                    territoryVFX:Play(entity, count, changedCells, world.grid)
                    particles:Emit(entity, world.grid, changedCells, camera.position)
                    arcadeEffects:Capture(entity, count)
                    toyFX:Capture(entity, count)
                end
                if entity.isHuman and count &gt; 0 then
                    camera:CapturePulse(entity.heading, count)
                    expandCombo:Show(count / world.grid.playableTotal * 100, entity.color)
                end
            end,
            onMerge = function(killer, victim, takenCells, hit)
                mergeEffects:Emit(killer, victim, takenCells, hit)
                arcadeEffects:Merge(killer, takenCells, world.grid)
            end,
            onAbsorb = function(killer, amount, takenCells)
                if amount &gt; 0 then
                    particles:Emit(killer, world.grid, takenCells, camera.position)
                    territoryVFX:Play(killer, amount, takenCells, world.grid)
                    if killer.isHuman then
                        camera:CapturePulse(killer.heading, amount)
                    end
                end
            end,
            onVictory = function(winner, wonWorld)
                audio:Victory()
                -- Irreversible game state. Do not let later callbacks restart it.
                running = false
                frozenForRevive = false
                print(string.format("[Paintland V26] Win event: %d/%d cells, alive=%s",
                    wonWorld.grid.counts[winner.id] or 0, wonWorld.grid.playableTotal,
                    tostring(winner.alive)))

                local function visual(actionName, callback)
                    local ok, err = xpcall(callback, debug.traceback)
                    if not ok then
                        warn("[Paintland V26] " .. actionName .. " failed: " .. tostring(err))
                    end
                    return ok
                end
                visual("CloseRevive", function() if revive then revive:Close() end end)
                visual("VictoryMode", function() ui:SetMode("victory") end)
                -- Show the result FIRST, so broken particles cannot hide it.
                local shown = visual("VictoryScreen", function()
                    assert(victory, "VictoryController not ready")
                    victory:Show(wonWorld)
                end)
                if not shown then
                    visual("HideBrokenVictoryScreen", function()
                        if victory then victory:Hide() end
                    end)
                    visual("VictoryFallback", function() ui:SetMode("win") end)
                end
                visual("FreezeHudAt100", function()
                    ui:Update(wonWorld)
                    ui.progress:Update(100, winner.color)
                end)
                visual("VictoryWorldParticles", function() victoryFX:Play(winner) end)
            end,
            onEliminate = function(victim, killer, cause, hit)
                if victim.isHuman then ui:RecordDefeat(world) end
                if killer and killer.isHuman and killer ~= victim and killer.alive then
                    audio:Kill(killer.killStreak)
                end
                if victim.isHuman then audio:Death() end
                arcadeEffects:Elimination(victim, killer, hit)
                toyFX:Elimination(victim, killer, hit)
                renderer:RemoveEntityVisual(victim.id)
                if killer and killer.isHuman and killer ~= victim and killer.alive then
                    killFeedback:OnKill(victim, killer)
                    camera:KillPulse(killer.heading, killer.killStreak)
                end
                if victim.isHuman then
                    killFeedback:Reset()
                    expandCombo:Reset()
                    -- Do not advance bots, captures or respawn timers while choosing.
                    frozenForRevive = true
                    ui:SetMode("revive")
                    revive:Open()
                end
            end,
        })
        world = nextWorld
        renderer:SetWorld(world)
        world:Start(localPlayer.DisplayName, skin)
        ui.minimap:SetWorld(world)
        nameService:Assign(world)
        ui:SetMode("playing")
        ui:Update(world)
        -- An optional Studio-only end-state test; disabled in published play.
        if RunService:IsStudio() and Config.StudioVictoryTest == true then
            for index = 1, world.grid.total do
                if world.grid.mask[index] then world.grid:Set(index, 1) end
            end
            world:CheckVictory()
        end
        if RunService:IsStudio() then
            local auditedWorld = world
            task.delay(2.5, function()
                if world ~= auditedWorld or not renderer.arena then return end
                local count = 0
                for _, actor in ipairs(auditedWorld.entities) do
                    if actor.alive then count += 1 end
                end
                local models = #renderer.arena.actorsFolder:GetChildren()
                local physicalLand = #renderer.arena.landFolder:GetChildren()
                local trails3d = #renderer.arena.trailFolder:GetChildren()
                print(string.format(
                    "[Paintland V22 Render Audit] alive=%d models=%d landParts=%d trailParts=%d camera=%s",
                    count, models, physicalLand, trails3d,
                    workspace.CurrentCamera and tostring(workspace.CurrentCamera.CameraType) or "nil"
                ))
                if count &gt; 0 and models == 0 then
                    warn("[Paintland V22] World has live actors but no 3D models: check CharacterVisuals errors")
                end
                if physicalLand == 0 then
                    warn("[Paintland V22] No physical land geometry: check renderer chunk updates")
                end
            end)
        end
    end

    ui = UIController.new(renderer, Config, {
        onAbility=function(id)
            if not running or frozenForRevive or not world then return end
            if network then network:UseAbility(id)
            else
                local actor=world.entities[1]
                local accepted,result=practiceAbilities:Use(world,actor,id,true)
                ui:SetAbilityState({id=id,accepted=accepted,reason=not accepted and result or nil,
                    cooldowns=practiceAbilities:State(world,actor)})
                if accepted then arcadeEffects:Ability(id,actor,result) end
            end
        end,
        onSoundToggle = function(muted) audio:SetMuted(muted) end,
        onMainMenu = function() startMenu() end,
        onRooms = function(action)
            if not network then return end
            ui:SetMode("lobby")
            matchmaking:Show(nil)
            if action=="create" then
                matchmaking:SetStatus("Creating your private room…")
                network:Command("create",{skin=ui.skin})
            end
        end,
        onPlay = function(skin)
            local ok, err = xpcall(function()
                newMatch(skin)
            end, debug.traceback)
            if not ok then
                warn("[Paintland V22] Match creation failed: " .. tostring(err))
                ui:Toast("MATCH ERROR — CHECK STUDIO OUTPUT", Color3.fromRGB(240, 85, 83))
            end
        end,
    })
    victory = VictoryController.new(renderer.screen, Config, function()
        newMatch(ui.skin)
    end)
    revive = ReviveController.new(renderer.screen, Config, {
        isMuted = function() return audio.muted end,
        onRevive = function()
            if world and world:ReviveHuman() then
                frozenForRevive = false
                ui:SetMode("playing")
                ui:Toast("REVIVED!", world.entities[1].color)
            end
        end,
        onTimeout = function()
            if world and (world.completed or world:CheckVictory()) then return end
            -- End the run without silently launching another match.
            running=false
            frozenForRevive=false
            revive:Close()
            audio:Reset()
            ui:ShowDefeat(world)
        end,
    })

    if Config.MultiplayerEnabled~=false then
        matchmaking=MatchmakingUI.new(renderer.screen,Config,function(action,fields)
            fields=fields or {};fields.skin=ui.skin
            if action=="leave" then network:Command("leave");startMenu() else network:Command(action,fields) end
        end)
        local function showNetworkResult(snapshot)
            revive:Close();running=false;frozenForRevive=false;matchmaking:Hide()
            audio:Reset();ui.defeatStats=snapshot;ui:ShowDefeat(world)
        end
        network=MultiplayerClient.new(Config,{
            onWallet=function(wallet) ui:SetWallet(wallet) end,
            onAbilityState=function(state) ui:SetAbilityState(state) end,
            onAbility=function(id,actorId,effect)
                arcadeEffects:Ability(id,world and world.entities[actorId],effect)
            end,
            onChanged=function(index)
                renderer:MarkCell(index);ui.minimap:MarkCell(index)
            end,
            onWorld=function(replica)
                demo:Stop();clearPresentation();world=replica
                renderer:SetWorld(world);ui.minimap:SetWorld(world)
                camera:Reset(world.entities[1].pos)
            end,
            onRespawn=function(entity)
                renderer:ResetEntityVisual(entity.id)
                if entity.id==1 then camera:Reset(entity.pos) end
            end,
            onLobby=function(lobby)
                if lobby.state=="running" then
                    matchmaking:Hide()
                    if ui.mode=="lobby" or ui.mode=="menu" then ui:SetMode("playing");running=true end
                elseif lobby.state=="lobby" then
                    demo:Stop();ui:SetMode("lobby");matchmaking:Show(lobby);running=false
                end
            end,
            onSnapshot=function(replica)
                world=replica
                if replica.roomState=="running" and ui.mode=="lobby" then
                    matchmaking:Hide();ui:SetMode("playing");running=true
                end
            end,
            onDeath=function(snapshot,remaining,credits)
                running=false;frozenForRevive=true;ui.defeatStats=snapshot;audio:Death()
                ui:SetMode("revive");killFeedback:Reset();expandCombo:Reset()
                revive:OpenServer(remaining,credits,function() network:Command("revive") end,
                    function() network:Command("decline") end)
            end,
            onResult=showNetworkResult,
            onRevived=function()
                revive:Close();frozenForRevive=false;running=true;ui:SetMode("playing");audio:Spawn()
            end,
            onCapture=function(id,count,total)
                if world and id==1 then
                    audio:Capture(count,total);expandCombo:Show(count/math.max(1,total)*100,world.entities[1].color)
                    camera:CapturePulse(world.entities[1].heading,count)
                end
            end,
            onElimination=function(victimId,killerId)
                local victim=world and world.entities[victimId]
                local killer=world and killerId and world.entities[killerId]
                if victim then renderer:RemoveEntityVisual(victimId) end
                if killerId==1 and victimId~=1 and killer then
                    audio:Kill((killer.killStreak or 0)+1);killFeedback:OnKill(victim,killer)
                    camera:KillPulse(killer.heading,(killer.killStreak or 0)+1)
                end
            end,
            onVictory=function(winnerId,replica)
                world=replica;running=false;frozenForRevive=false;revive:Close();matchmaking:Hide()
                if winnerId==1 then
                    ui:SetMode("victory");victory:Show(world);audio:Victory();victoryFX:Play(world.entities[1])
                else
                    ui:RecordDefeat(world);showNetworkResult(ui.defeatStats)
                end
            end,
            onJoining=function(message) ui:SetMode("lobby");matchmaking:Show(nil);matchmaking:SetStatus(message) end,
            onError=function(message)
                if revive.active and revive.serverMode then revive:ServerRejected(message) end
                if matchmaking.root.Visible then matchmaking:SetStatus(message)
                else ui:Toast(message,Color3.fromRGB(255,210,180)) end
            end,
            onLeft=function() startMenu() end,
        })
    end
    startMenu()

    local lastFrameError = nil
    local function updateFrame(dt)
        if not renderer.screen.Parent then return end
        local realDt = dt
        dt = math.min(dt, 0.08)
        if network and network:GetWorld() and network.accepting~=false then
            network:Update(realDt,function(entity) return input:GetHeading(entity,renderer,camera) end)
            world=network:GetWorld()
        elseif demo.active then
            demo:Update(realDt)
            world=demo.world
            camera:Update(demo.focus,dt)
        elseif running and not frozenForRevive and world then
            local steps = math.min(Config.MaxSubsteps,
                math.max(1, math.ceil(dt / Config.SimulationSubstep)))
            local each = math.min(dt / steps, Config.SimulationSubstep)
            for _ = 1, steps do
                world:Step(each, function(e)
                    return input:GetHeading(e, renderer, camera)
                end)
                if frozenForRevive or (world and world.completed) then break end
            end
        end
        if world and not demo.active then
            local player = world.entities[1]
            if player and player.alive then camera:Update(player.pos, dt) end
        end
        camera:Apply()
        toyFX:Update(realDt)
        renderer:Render(camera.position, realDt)
        arcadeEffects:Update(realDt, camera.position)
        motionEffects:Update(realDt, world and world.entities[1] or nil,
            camera.position, running and not frozenForRevive)
        if not frozenForRevive then
            particles:Update(realDt, camera.position)
            killFeedback:Update(realDt)
            mergeEffects:Update(realDt)
        end
        if not demo.active and world and world.completed and victory and not victory.active then
            -- Backup if an earlier presentation callback was interrupted.
            running = false
            local ok, err = pcall(function() victory:Show(world) end)
            if not ok then warn("[Paintland V26] Victory screen retry failed: " .. tostring(err)) end
        end
        if not demo.active then ui.minimap:Render(dt, camera.position) end
        if victory then victory:Update(realDt) end
        -- Countdown uses real elapsed frame time, not capped simulation delta.
        revive:Update(realDt)
        audio:Update(realDt)
        ui:UpdatePresentation(realDt)
        if not network and running and world and world.entities[1] then
            ui:SetAbilityState({cooldowns=practiceAbilities:State(world,world.entities[1])})
        end
        if world and not demo.active then
            -- Diagnostic only when near completion. Actual completion is
            -- inside World and never depends on this HUD refresh.
            hudTimer += dt
            if hudTimer &gt;= 0.25 then
                hudTimer = 0
                ui:Update(world)
                -- Winning is settled by World:CheckVictory, not a HUD timer.
            end
        end
    end

    RunService:BindToRenderStep("PaintlandWorldRenderV24", Enum.RenderPriority.Camera.Value + 2, function(dt)
        local ok, err = xpcall(function()
            updateFrame(dt)
        end, debug.traceback)
        if not ok and err ~= lastFrameError then
            lastFrameError = err
            warn("[Paintland V22] Render error: " .. tostring(err))
            if ui then
                ui:Toast("RENDER ERROR — CHECK STUDIO OUTPUT", Color3.fromRGB(240, 85, 83))
            end
        end
    end)
    return {Network=network,Matchmaking=matchmaking,MenuDemo = demo, Audio = audio, UI = ui, Input = input, Renderer = renderer, Revive = revive,
        Particles = particles, Camera = camera, KillFeedback = killFeedback,
        LandMergeEffects = mergeEffects, ArcadeEffects = arcadeEffects, MotionEffects = motionEffects,
        ExpandCombo = expandCombo, TerritoryVFX = territoryVFX, Cosmetics = CosmeticController,
        Victory = victory, VictoryFX = victoryFX}
end

return Loader
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleGrid"><Properties><string name="Name">Grid</string><ProtectedString name="Source">local Grid = {}
Grid.__index = Grid

function Grid.new(cfg, onChange)
    local self = setmetatable({}, Grid)
    self.cfg = cfg
    self.size = cfg.Grid
    self.cell = cfg.Cell
    self.total = cfg.Grid * cfg.Grid
    self.half = cfg.Grid * cfg.Cell / 2
    self.radius = cfg.ArenaRadius or (self.half - self.cell * 2)
    self.maskRadius = self.radius - (cfg.ArenaBoundaryMargin or self.cell * 0.85)
    self.mask = table.create(self.total, false)
    self.owners = table.create(self.total, -1)
    self.playableTotal = 0
    for y = 1, self.size do
        for x = 1, self.size do
            local index = (y - 1) * self.size + x
            local center = self:Center(x, y)
            if center:Dot(center) &lt;= self.maskRadius * self.maskRadius then
                self.mask[index] = true
                self.owners[index] = 0
                self.playableTotal += 1
            end
        end
    end
    self.counts = {}
    self.changed = onChange
    return self
end

function Grid:Index(x, y)
    if x &lt; 1 or x &gt; self.size or y &lt; 1 or y &gt; self.size then return nil end
    local index = (y - 1) * self.size + x
    return self.mask[index] and index or nil
end

function Grid:Coords(p)
    return math.floor((p.X + self.half) / self.cell) + 1,
        math.floor((p.Y + self.half) / self.cell) + 1
end

-- A point can lie inside the round arena while its square grid cell's
-- CENTER falls outside the playable mask. Snap to the nearest valid rim cell.
-- Otherwise the last edge cells are impossible to step on or claim.
function Grid:At(p)
    local x, y = self:Coords(p)
    local exact = self:Index(x, y)
    if exact then return exact end
    if p.Magnitude &gt; self.radius + self.cell * 0.25 then return nil end

    local nearest, nearestDist
    for dy = -2, 2 do
        for dx = -2, 2 do
            local i = self:Index(x + dx, y + dy)
            if i then
                local c = self:Center(x + dx, y + dy)
                local delta = c - p
                local d = delta:Dot(delta)
                if not nearestDist or d &lt; nearestDist then
                    nearest, nearestDist = i, d
                end
            end
        end
    end
    return nearest
end

function Grid:Center(x, y)
    return Vector2.new(-self.half + (x - 0.5) * self.cell,
        -self.half + (y - 0.5) * self.cell)
end

function Grid:GetOwnerAt(p)
    local i = self:At(p)
    return i and self.owners[i] or -1
end

function Grid:Set(index, owner)
    if not index or not self.mask[index] then return false end
    local old = self.owners[index]
    if old == owner then return false end
    self.owners[index] = owner
    if old and old &gt; 0 then self.counts[old] = (self.counts[old] or 0) - 1 end
    if owner &gt; 0 then self.counts[owner] = (self.counts[owner] or 0) + 1 end
    if self.changed then self.changed(index) end
    return true
end

-- Recalculate territory counts from the actual ownership array. Called
-- at end-of-match checks; never trusts HUD or visuals as source of truth.
function Grid:Recount()
    local actual = {}
    for i = 1, self.total do
        if self.mask[i] then
            local owner = self.owners[i]
            if owner and owner &gt; 0 then
                actual[owner] = (actual[owner] or 0) + 1
            end
        end
    end
    local mismatch = false
    for id, count in pairs(actual) do
        if count ~= (self.counts[id] or 0) then mismatch = true; break end
    end
    if not mismatch then
        for id, count in pairs(self.counts) do
            if count ~= (actual[id] or 0) then mismatch = true; break end
        end
    end
    if mismatch then
        warn("[Paintland V26] Grid counters disagreed with ownership; repaired cached counts")
        self.counts = actual
    end
end

-- Retain the largest owned component after a genuine split. A head near a
-- tiny sliver must never erase the main territory. Head position only breaks
-- equal-size ties. Any alternate OWNED bridge is naturally part of the flood.
function Grid:RemoveDetachedLand(id, headPosition)
    if (self.counts[id] or 0)&lt;=0 then return 0 end
    local headIndex=headPosition and self:At(headPosition)
    local hx=headPosition and ((headPosition.X+self.half)/self.cell+.5)
    local hy=headPosition and ((headPosition.Y+self.half)/self.cell+.5)
    local seen=table.create(self.total,false)
    local best,bestHasHead,bestDistance=nil,false,math.huge
    local width=self.size
    for seed=1,self.total do
        if self.owners[seed]==id and not seen[seed] then
            local queue={seed}
            seen[seed]=true
            local front,hasHead,nearest=1,false,math.huge
            local function visit(index)
                if not seen[index] and self.owners[index]==id then
                    seen[index]=true;queue[#queue+1]=index
                end
            end
            while front&lt;=#queue do
                local index=queue[front];front+=1
                hasHead=hasHead or index==headIndex
                local x,y=(index-1)%width+1,math.floor((index-1)/width)+1
                if headPosition then
                    local dx,dy=x-hx,y-hy
                    nearest=math.min(nearest,dx*dx+dy*dy)
                end
                if x&gt;1 then visit(index-1) end
                if x&lt;width then visit(index+1) end
                if y&gt;1 then visit(index-width) end
                if y&lt;width then visit(index+width) end
            end
            if #queue&gt;=(self.counts[id] or 0) then return 0 end
            if not best or #queue&gt;#best or (#queue==#best and
                ((hasHead and not bestHasHead) or (hasHead==bestHasHead and nearest&lt;bestDistance))) then
                best,bestHasHead,bestDistance=queue,hasHead,nearest
            end
        end
    end
    if not best or #best&gt;=(self.counts[id] or 0) then return 0 end
    local keep={}
    for _,index in ipairs(best) do keep[index]=true end
    local removed=0
    for index=1,self.total do
        if self.owners[index]==id and not keep[index] then
            self:Set(index,0);removed+=1
        end
    end
    return removed
end

function Grid:SpawnLand(id, position)
    local gx, gy = self:Coords(position)
    local radius = self.cfg.SpawnRadiusCells
    local affectedOwners = {}
    for y = gy - radius, gy + radius do
        for x = gx - radius, gx + radius do
            if (x - gx)^2 + (y - gy)^2 &lt;= radius^2 then
                local index = self:Index(x, y)
                if index then
                    local previous = self.owners[index]
                    if previous and previous &gt; 0 and previous ~= id then
                        affectedOwners[previous] = true
                    end
                    self:Set(index, id)
                end
            end
        end
    end
    return affectedOwners
end

-- Boundary-connected regions are exterior candidates. Interior pockets are
-- always enclosed, even when larger than the remaining outside region.
-- For loops dividing the circular wall, retain the largest boundary region.
function Grid:Capture(id, trailCells)
    local claimed = 0
    local changedCells = {}
    local affectedOwners = {}

    local function claim(index)
        if not index or not self.mask[index] then return end
        local old = self.owners[index]
        if old and old &gt; 0 and old ~= id then
            affectedOwners[old] = true
        end
        if self:Set(index, id) then
            claimed += 1
            changedCells[index] = true
        end
    end

    for _, index in ipairs(trailCells) do
        claim(index)
    end

    local n = self.size
    local visited = table.create(self.total, false)
    local components = {}

    for seed = 1, self.total do
        if self.mask[seed] and self.owners[seed] ~= id and not visited[seed] then
            local component = {cells = {}, size = 0, perimeter = 0}
            local queue = {seed}
            local head, tail = 1, 1
            visited[seed] = true

            -- One visitor per component (not thousands of closures per cell).
            local function visit(nx, ny)
                local other = self:Index(nx, ny)
                if not other then
                    component.perimeter += 1
                elseif self.owners[other] ~= id and not visited[other] then
                    visited[other] = true
                    tail += 1
                    queue[tail] = other
                end
            end

            while head &lt;= tail do
                local index = queue[head]
                head += 1
                component.size += 1
                component.cells[#component.cells + 1] = index

                local x = (index - 1) % n + 1
                local y = math.floor((index - 1) / n) + 1
                visit(x-1, y)
                visit(x+1, y)
                visit(x, y-1)
                visit(x, y+1)
            end
            components[#components + 1] = component
        end
    end

    local exterior = nil
    for i, component in ipairs(components) do
        if component.perimeter &gt; 0 then
            local current = exterior and components[exterior]
            if not current or component.size &gt; current.size
                or (component.size == current.size and component.perimeter &gt; current.perimeter) then
                exterior = i
            end
        end
    end
    for i, component in ipairs(components) do
        if i ~= exterior then
            for _, cellIndex in ipairs(component.cells) do claim(cellIndex) end
        end
    end

    -- The playable mask uses cell CENTERS but the player's physical position
    -- follows a perfect circle. Close shallow neutral gaps along the rim when
    -- the INNER side is already owned by the capturing player. This is not an
    -- artificial 100% score: every filled cell is actually assigned to them.
    self:ClaimBoundaryFringe(id, claim)

    return claimed, changedCells, affectedOwners
end

-- Automatically finish the last ~2 cells of a circular wall when their
-- inward neighbour belongs to this player. Avoid stealing rivals' cells.
-- Operates only on neutral cells and runs after a real loop is completed.
function Grid:ClaimBoundaryFringe(id, claim)
    local maxDepth = (self.cfg.BoundaryAssistDepthCells or 2.5) * self.cell
    local reach = (self.cfg.BoundaryAssistInwardCells or 2) * self.cell
    for pass = 1, 2 do
        local pending = {}
        for i = 1, self.total do
            if self.mask[i] and self.owners[i] == 0 then
                local x = (i - 1) % self.size + 1
                local y = math.floor((i - 1) / self.size) + 1
                local center = self:Center(x,y)
                local radius = center.Magnitude
                if radius &gt; 0.001 and self.maskRadius - radius &lt;= maxDepth then
                    local inward = center.Unit * math.max(0, radius - reach)
                    local ix, iy = self:Coords(inward)
                    local innerIndex = self:Index(ix, iy)
                    if innerIndex and self.owners[innerIndex] == id then
                        pending[#pending + 1] = i
                    end
                end
            end
        end
        if #pending == 0 then break end
        for _, i in ipairs(pending) do claim(i) end
    end
end

-- Defeated land transfers without manufacturing thin neutral corridors.
-- Disconnected inherited islands are valid ownership, just like preserved land.
function Grid:AbsorbDefeatedLand(victimId, killerId, route)
    local taken, claimedCount, affectedOwners = {}, 0, {}
    if victimId == killerId then return taken, 0 end
    if not killerId or killerId &lt;= 0 then
        self:TransferAll(victimId, 0)
        return taken, 0
    end
    -- Flood from the actual cut through the recorded trail, including crossed
    -- rival tiles. Only actual trail cells may cross third-party ownership;
    -- never search arbitrary neutral or rival land for a shortcut.
    local connected=false
    if route and route.cells and route.cut then
        local seen,queue={},{}
        local hasKiller,hasVictim=false,false
        local function visit(index)
            if not index or seen[index] or not self.mask[index] then return end
            local owner=self.owners[index]
            if owner==killerId or owner==victimId or route.cells[index] then
                seen[index]=true;queue[#queue+1]=index
                hasKiller=hasKiller or owner==killerId
                hasVictim=hasVictim or owner==victimId
            end
        end
        visit(route.cut)
        local head=1
        while head&lt;=#queue do
            local index=queue[head];head+=1
            local x,y=(index-1)%self.size+1,math.floor((index-1)/self.size)+1
            if x&gt;1 then visit(index-1) end
            if x&lt;self.size then visit(index+1) end
            if y&gt;1 then visit(index-self.size) end
            if y&lt;self.size then visit(index+self.size) end
        end
        connected=hasKiller and hasVictim and seen[route.contact]==true
        for _,index in ipairs(route.required or {}) do
            if not seen[index] then connected=false;break end
        end
        if connected then
            for index in pairs(route.cells) do
                if seen[index] then
                    local old=self.owners[index]
                    if self:Set(index,killerId) then
                        taken[index]=true;claimedCount+=1
                        if old and old&gt;0 and old~=killerId and old~=victimId then
                            affectedOwners[old]=true
                        end
                    end
                end
            end
        end
    end
    for i = 1, self.total do
        if self.owners[i] == victimId and self:Set(i, killerId) then
            taken[i] = true
            claimedCount += 1
        end
    end
    return taken, claimedCount, connected, affectedOwners
end

function Grid:TransferAll(fromId, toId)
    for i = 1, self.total do
        if self.owners[i] == fromId then self:Set(i, toId) end
    end
end

function Grid:FindNearestOwned(id, position)
    if (self.counts[id] or 0) &lt;= 0 then return nil end
    local ix, iy = self:Coords(position)
    for radius = 0, self.size do
        local best, bestD
        local function consider(x, y)
            local i = self:Index(x, y)
            if i and self.owners[i] == id then
                local p = self:Center(x, y)
                local d = (p - position).Magnitude
                if not bestD or d &lt; bestD then best, bestD = p, d end
            end
        end
        for x = ix - radius, ix + radius do
            consider(x, iy - radius)
            if radius &gt; 0 then consider(x, iy + radius) end
        end
        for y = iy - radius + 1, iy + radius - 1 do
            consider(ix - radius, y)
            if radius &gt; 0 then consider(ix + radius, y) end
        end
        if best then return best end
    end
    return nil
end

return Grid
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleHUDCanvas"><Properties><string name="Name">HUDCanvas</string><ProtectedString name="Source">-- Clear territory meter with a single animated fill and readable live value.
local TweenService = game:GetService("TweenService")
local HUD = {}
HUD.__index = HUD
local function make(parent, class, name, props)
    local item=Instance.new(class)
    item.Name=name
    for key,value in pairs(props) do item[key]=value end
    item.Parent=parent
    return item
end
function HUD.new(parent,cfg)
    local self=setmetatable({cfg=cfg,value=0},HUD)
    self.canvas=make(parent,"Frame","TerritoryMeter",{
        AnchorPoint=Vector2.new(0.5,0),Position=UDim2.new(0.5,0,0,56),
        Size=UDim2.fromOffset(350,76),BackgroundColor3=Color3.fromRGB(19,30,48),
        BackgroundTransparency=0.06,BorderSizePixel=0,ZIndex=30})
    make(self.canvas,"UICorner","Round",{CornerRadius=UDim.new(0,18)})
    make(self.canvas,"UIStroke","Edge",{Color=Color3.fromRGB(80,108,134),Transparency=0.6,Thickness=1})
    self.caption=make(self.canvas,"TextLabel","Caption",{BackgroundTransparency=1,
        Position=UDim2.fromOffset(18,10),Size=UDim2.new(1,-100,0,22),Text="YOUR TERRITORY",
        TextColor3=Color3.fromRGB(166,187,205),Font=Enum.Font.GothamBold,TextSize=11,
        TextXAlignment=Enum.TextXAlignment.Left,ZIndex=31})
    self.percent=make(self.canvas,"TextLabel","Percent",{BackgroundTransparency=1,
        AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,-18,0,8),Size=UDim2.fromOffset(90,26),
        Text="0.0%",TextColor3=Color3.fromRGB(244,250,255),Font=Enum.Font.GothamBold,
        TextSize=22,TextXAlignment=Enum.TextXAlignment.Right,ZIndex=31})
    self.track=make(self.canvas,"Frame","Track",{Position=UDim2.fromOffset(18,44),
        Size=UDim2.new(1,-36,0,10),BackgroundColor3=Color3.fromRGB(43,59,78),BorderSizePixel=0,
        ClipsDescendants=true,ZIndex=31})
    make(self.track,"UICorner","Round",{CornerRadius=UDim.new(1,0)})
    self.fill=make(self.track,"Frame","Fill",{Size=UDim2.fromScale(0,1),
        BackgroundColor3=Color3.fromRGB(82,230,186),BorderSizePixel=0,ZIndex=32})
    make(self.fill,"UICorner","Round",{CornerRadius=UDim.new(1,0)})
    self:Reset()
    return self
end
function HUD:Resize(viewport)
    self.canvas.Size=UDim2.fromOffset(math.min(350,math.max(180,viewport.X-32)),68)
end
function HUD:Reset()
    if self.tween then self.tween:Cancel() end
    self.value=0
    self.fill.Size=UDim2.fromScale(0,1)
    self.percent.Text="0.0%"
end
function HUD:Update(percent,color)
    percent=math.clamp(percent,0,100)
    local value=percent/100
    self.percent.Text=string.format("%.1f%%",percent&gt;=100 and 100 or math.min(99.9,percent))
    self.fill.BackgroundColor3=color or Color3.fromRGB(82,230,186)
    if math.abs(value-self.value)&lt;0.0001 then return end
    self.value=value
    if self.tween then self.tween:Cancel() end
    self.tween=TweenService:Create(self.fill,TweenInfo.new(0.22,Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out),{Size=UDim2.fromScale(value,1)})
    self.tween:Play()
end
function HUD:Destroy()
    if self.tween then self.tween:Cancel() end
    self.canvas:Destroy()
end
return HUD
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleInputController"><Properties><string name="Name">InputController</string><ProtectedString name="Source">-- V14 touch steering: never substitute a synthetic mouse position after release.
-- Drag is relative to the initial finger position, not the avatar or the camera.
local UIS = game:GetService("UserInputService")

local Input = {}
Input.__index = Input
local keys = {
    [Enum.KeyCode.W]="W", [Enum.KeyCode.Up]="Up",
    [Enum.KeyCode.A]="A", [Enum.KeyCode.Left]="Left",
    [Enum.KeyCode.S]="S", [Enum.KeyCode.Down]="Down",
    [Enum.KeyCode.D]="D", [Enum.KeyCode.Right]="Right",
}

local function v2(v) return Vector2.new(v.X, v.Y) end

function Input.new(config)
    local self = setmetatable({}, Input)
    self.config = config or {}
    self.pressed = {}
    self.stick = Vector2.zero
    self.touchObject = nil
    self.touchStart = nil
    self.touchCurrent = nil
    self.connections = {}
    self.connections[#self.connections+1] = UIS.InputBegan:Connect(function(i, processed)
        if keys[i.KeyCode] and not processed then self.pressed[keys[i.KeyCode]] = true end
        -- One active finger at a time. UI touches are never steering touches.
        if i.UserInputType == Enum.UserInputType.Touch and not processed and not self.touchObject then
            self.touchObject = i
            self.touchStart = v2(i.Position)
            self.touchCurrent = self.touchStart
        end
    end)
    self.connections[#self.connections+1] = UIS.InputChanged:Connect(function(i)
        if i == self.touchObject then
            self.touchCurrent = v2(i.Position)
        elseif i.KeyCode == Enum.KeyCode.Thumbstick1 then
            self.stick = Vector2.new(i.Position.X, -i.Position.Y)
        end
    end)
    self.connections[#self.connections+1] = UIS.InputEnded:Connect(function(i)
        if keys[i.KeyCode] then self.pressed[keys[i.KeyCode]] = nil end
        if i == self.touchObject then self:ClearTouch() end
        if i.KeyCode == Enum.KeyCode.Thumbstick1 then self.stick = Vector2.zero end
    end)
    -- Touch events preserve the same InputObject across finger movements.
    self.connections[#self.connections+1] = UIS.TouchMoved:Connect(function(i)
        if i == self.touchObject then self.touchCurrent = v2(i.Position) end
    end)
    self.connections[#self.connections+1] = UIS.TouchEnded:Connect(function(i)
        if i == self.touchObject then self:ClearTouch() end
    end)
    self.connections[#self.connections+1] = UIS.WindowFocusReleased:Connect(function()
        self:ClearTouch()
        table.clear(self.pressed)
        self.stick = Vector2.zero
    end)
    return self
end

function Input:ClearTouch()
    self.touchObject = nil
    self.touchStart = nil
    self.touchCurrent = nil
end

function Input:GetHeading(entity, renderer, camera)
    local p = self.pressed
    local direction = Vector2.new(
        ((p.D or p.Right) and 1 or 0) - ((p.A or p.Left) and 1 or 0),
        ((p.S or p.Down) and 1 or 0) - ((p.W or p.Up) and 1 or 0)
    )
    if direction.Magnitude &gt; 0 then
        return math.atan2(direction.Y, direction.X)
    end
    if self.stick.Magnitude &gt; 0.20 then
        return math.atan2(self.stick.Y, self.stick.X)
    end

    if self.touchObject then
        local delta = (self.touchCurrent or self.touchStart) - self.touchStart
        local deadzone = self.config.TouchDeadzone or 18
        if delta.Magnitude &gt;= deadzone then
            -- Convert the drag through the tilted camera's ground-plane basis.
            -- No stale touch target is retained when the finger lifts.
            local cam = workspace.CurrentCamera
            if cam then
                local at = Vector3.new(entity.pos.X, 0, entity.pos.Y)
                local p0 = cam:WorldToViewportPoint(at)
                local px = cam:WorldToViewportPoint(at + Vector3.new(12,0,0))
                local pz = cam:WorldToViewportPoint(at + Vector3.new(0,0,12))
                local ax, ay = px.X-p0.X, px.Y-p0.Y
                local bx, by = pz.X-p0.X, pz.Y-p0.Y
                local determinant = ax*by-ay*bx
                if math.abs(determinant)&gt;0.01 then
                    local dx = (delta.X*by-delta.Y*bx)/determinant
                    local dz = (ax*delta.Y-ay*delta.X)/determinant
                    return math.atan2(dz, dx)
                end
            end
            return math.atan2(delta.Y,delta.X)
        end
        return nil
    end

    -- Touch-capable clients never use mouse fallback when the finger lifts.
    -- This covers mobile emulation and hybrid touch/mouse setups.
    if UIS.TouchEnabled then return nil end
    if UIS.MouseEnabled then
        local cam=workspace.CurrentCamera
        if cam then
            local mouse=UIS:GetMouseLocation()
            local ray=cam:ViewportPointToRay(mouse.X,mouse.Y)
            if math.abs(ray.Direction.Y)&gt;0.0001 then
                local distance=-ray.Origin.Y/ray.Direction.Y
                if distance&gt;0 then
                    local hit=ray.Origin+ray.Direction*distance
                    local delta=Vector2.new(hit.X-entity.pos.X,hit.Z-entity.pos.Y)
                    if delta.Magnitude&gt;(self.config.MouseWorldDeadzone or 3) then
                        return math.atan2(delta.Y,delta.X)
                    end
                end
            end
        end
    end
    return nil
end

function Input:Destroy()
    for _, connection in ipairs(self.connections) do connection:Disconnect() end
    table.clear(self.connections)
    self:ClearTouch()
end

return Input
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleKillFeedback"><Properties><string name="Name">KillFeedback</string><ProtectedString name="Source">-- Runtime-generated kill-streak callouts. No TweenService churn per kill:
-- just two critically damped springs and a short fade updated each frame.
local KillFeedback = {}
KillFeedback.__index = KillFeedback

local STAGES = {"ELIMINATED", "DOUBLE KILL", "TRIPLE KILL", "QUADRA KILL", "ACE!"}

local INK = Color3.fromRGB(36, 46, 61)
local WHITE = Color3.fromRGB(255, 255, 255)
local YELLOW = Color3.fromRGB(255, 214, 105)

local function make(parent, class, name, properties)
    local inst = Instance.new(class)
    inst.Name = name
    for key, value in pairs(properties) do inst[key] = value end
    inst.Parent = parent
    return inst
end

local function text(parent, name, textValue, size, color, weight, z)
    return make(parent, "TextLabel", name, {
        BackgroundTransparency = 1,
        Text = textValue,
        TextColor3 = color,
        TextStrokeColor3 = INK,
        TextStrokeTransparency = 0.42,
        Font = weight or Enum.Font.GothamBlack,
        TextScaled = false,
        TextSize = size,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = z,
    })
end

local function spring(x, velocity, target, omega, dt)
    local decay = math.exp(-omega * dt)
    local delta = x - target
    local impulse = (velocity + delta * omega) * dt
    return target + (delta + impulse) * decay,
        (velocity - impulse * omega) * decay
end

function KillFeedback.new(screen, cfg)
    local self = setmetatable({}, KillFeedback)
    self.cfg = cfg
    self.age = 0
    self.clock, self.lastKill, self.combo = 0, -math.huge, 0
    self.alive = false
    self.scaleValue = 1
    self.scaleVelocity = 0
    self.offset = 0
    self.offsetVelocity = 0
    self.streak = 0

    self.layer = make(screen, "Frame", "KillFeedbackLayer", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 60,
        Active = false,
    })
    self.group = make(self.layer, "Frame", "KillAnnouncement", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.25, 0),
        Size = UDim2.fromOffset(390, 136),
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = 61,
    })
    self.scale = make(self.group, "UIScale", "PopSpring", {Scale = 1})
    self.shadow = text(self.group, "TypeShadow", "ELIMINATED", 34, INK,
        Enum.Font.GothamBlack, 62)
    self.shadow.Position = UDim2.fromOffset(3, 5)
    self.shadow.Size = UDim2.new(1, 0, 0, 66)
    self.shadow.TextStrokeTransparency = 1
    self.shadow.TextTransparency = 0.82

    self.primary = text(self.group, "Callout", "ELIMINATED", 34, WHITE,
        Enum.Font.GothamBlack, 63)
    self.primary.Size = UDim2.new(1, 0, 0, 66)
    self.primary.TextStrokeTransparency = 0.08
    self.primary.TextStrokeColor3 = INK

    self.subtitle = text(self.group, "Streak", "1ST KILL", 17, YELLOW,
        Enum.Font.GothamBlack, 63)
    self.subtitle.Position = UDim2.fromOffset(0, 62)
    self.subtitle.Size = UDim2.new(1, 0, 0, 28)

    self.victim = text(self.group, "Victim", "", 13,
        Color3.fromRGB(241, 249, 245), Enum.Font.GothamBold, 63)
    self.victim.Position = UDim2.fromOffset(0, 89)
    self.victim.Size = UDim2.new(1, 0, 0, 25)

    local function sparkle(name, x, y, symbol)
        local obj = text(self.group, name, symbol, 24, YELLOW,
            Enum.Font.GothamBlack, 62)
        obj.Position = UDim2.new(0.5, x, 0, y)
        obj.Size = UDim2.fromOffset(25, 25)
        obj.Visible = false
        return obj
    end
    self.sparks = {
        sparkle("SparkA", -158, 4, "✦"),
        sparkle("SparkB", 147, 18, "✦"),
        sparkle("SparkC", -134, 75, "✧"),
        sparkle("SparkD", 128, 80, "✧"),
    }
    return self
end

function KillFeedback:Reset()
    self.alive = false
    self.streak = 0
    self.combo, self.lastKill = 0, -math.huge
    self.age = 0
    self.group.Visible = false
end

function KillFeedback:OnKill(victim, killer)
    local count = killer.killStreak or 1
    self.combo = self.clock-self.lastKill &lt;= (self.cfg.KillComboWindowSeconds or 3)
        and (self.combo+1) or 1
    self.lastKill=self.clock
    self.streak = count
    self.age = 0
    self.alive = true
    self.scaleValue = 0.42
    self.scaleVelocity = 16
    self.offset = 35
    self.offsetVelocity = -480

    self.primary.Text = STAGES[self.combo] or "UNSTOPPABLE!"
    self.shadow.Text = self.primary.Text
    self.primary.TextColor3 = (count &gt;= 5 and YELLOW)
        or (count &gt;= 3 and Color3.fromRGB(255, 177, 113))
        or WHITE
    self.subtitle.Text = string.format("%d KILL STREAK", count)
    self.victim.Text = "ELIMINATED  " .. tostring(victim.name)
    self.group.Visible = true
    for _, obj in ipairs(self.sparks) do obj.Visible = count &gt;= 2 end
    self:ApplyOpacity(0)
end

function KillFeedback:ApplyOpacity(fade)
    self.primary.TextTransparency = fade
    self.primary.TextStrokeTransparency = 0.08 + fade * 0.92
    self.shadow.TextTransparency = 0.82 + 0.18 * fade
    self.subtitle.TextTransparency = fade
    self.subtitle.TextStrokeTransparency = 0.35 + fade * 0.65
    self.victim.TextTransparency = fade
    self.victim.TextStrokeTransparency = 0.5 + fade * 0.5
    for _, obj in ipairs(self.sparks) do obj.TextTransparency = fade end
end

function KillFeedback:Update(dt)
    self.clock += math.max(0, dt)
    if not self.alive then return end
    dt = math.clamp(dt, 0, 0.05)
    self.age += dt
    local speed = self.cfg.KillPopupSpring or 17
    self.scaleValue, self.scaleVelocity = spring(self.scaleValue,
        self.scaleVelocity, 1, speed, dt)
    self.offset, self.offsetVelocity = spring(self.offset,
        self.offsetVelocity, 0, speed * 0.8, dt)
    self.scale.Scale = self.cfg.ReducedMotion and 1 or math.clamp(self.scaleValue, 0.35, 1.25)
    self.group.Position = UDim2.new(0.5, 0, 0.235, self.cfg.ReducedMotion and 0 or self.offset)

    local duration = self.cfg.KillPopupDuration or 1.65
    if self.age &gt; duration then
        local alpha = math.clamp((self.age - duration) / 0.35, 0, 1)
        self:ApplyOpacity(alpha)
        if alpha &gt;= 1 then
            self.alive = false
            self.group.Visible = false
        end
    end
    local size = self.layer.AbsoluteSize
    self.scale.Scale *= math.clamp(math.min(size.X / 420, size.Y / 460), 0.56, 1)
end

function KillFeedback:Destroy()
    if self.layer then self.layer:Destroy() end
end

return KillFeedback
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleLandMergeEffects"><Properties><string name="Name">LandMergeEffects</string><ProtectedString name="Source">-- V32: visible victim -&gt; pale flash -&gt; winner color sweep above absorbed land.
-- Never draws a second map in a SurfaceGui or StarterGui.
local ChunkGeometry = require(script.Parent.ChunkGeometry)

local LandMergeEffects = {}
LandMergeEffects.__index = LandMergeEffects

local function newOverlay(parent)
    local p = Instance.new("Part")
    p.Name = "MergeFade"
    p.Anchored = true
    p.CanCollide, p.CanTouch, p.CanQuery = false, false, false
    p.CastShadow = false
    p.Material = Enum.Material.Neon
    p.Transparency = 1
    p.Parent = parent
    return p
end

function LandMergeEffects.new(renderer, cfg)
    return setmetatable({renderer = renderer, cfg = cfg, time = 0,
        pool = {}, active = {}}, LandMergeEffects)
end

function LandMergeEffects:GetPart()
    return table.remove(self.pool) or newOverlay(self.renderer.arena.effectsFolder)
end

function LandMergeEffects:Emit(killer, victim, changedCells, hit)
    if self.cfg.TerritoryMergeEffectsEnabled == false then return end
    if not killer or not victim or not changedCells then return end
    local rects = ChunkGeometry.RectanglesFromSet(changedCells, self.cfg.Grid)
    local maxParts = math.min(self.cfg.WorkspaceMergePartLimit or 26,
        (self.cfg.TerritoryMergeOverlayLimit or 170) - #self.active)
    if maxParts &lt;= 0 then return end
    local cell = self.cfg.Cell
    local half = self.cfg.Grid * cell / 2
    local duration = self.cfg.TerritoryMergeDuration or 0.45
    local count = 0
    local origin=hit and hit.position or killer.pos
    -- Sample across the resulting rectangles instead of showing many heavy parts.
    local stride = math.max(1, math.ceil(#rects / maxParts))
    for i = 1, #rects, stride do
        if count &gt;= maxParts then break end
        local r = rects[i]
        local p = self:GetPart()
        p.Color = victim.color
        p.Size = Vector3.new((r.x2 - r.x1 + 1) * cell, 0.025,
            (r.y2 - r.y1 + 1) * cell)
        p.Position = Vector3.new(-half + (r.x1 + r.x2 - 1) * 0.5 * cell,
            0.435, -half + (r.y1 + r.y2 - 1) * 0.5 * cell)
        p.Transparency = 0.18
        local dx = p.Position.X - origin.X
        local dz = p.Position.Z - origin.Y
        local distance = math.sqrt(dx * dx + dz * dz)
        self.active[#self.active + 1] = {
            part = p, start = self.time + (self.cfg.ReducedMotion and 0 or math.min(self.cfg.TerritoryMergeWaveDelay or 0.25, distance / 500)),
            from=victim.color, to=killer.color,
            duration = duration,
        }
        count += 1
    end
end

function LandMergeEffects:Update(dt)
    self.time += math.min(dt, 0.1)
    for i = #self.active, 1, -1 do
        local item = self.active[i]
        local alpha = (self.time - item.start) / item.duration
        if alpha &gt;= 1 then
            item.part.Transparency = 1
            table.insert(self.pool, item.part)
            table.remove(self.active, i)
        elseif alpha &gt;= 0 then
            local t = math.clamp(alpha, 0, 1)
            local flash=math.clamp(t/0.18,0,1)
            if self.cfg.ReducedMotion then
                item.part.Color=item.from:Lerp(item.to,t)
            else
                item.part.Color=t&lt;0.18 and item.from:Lerp(Color3.new(1,1,1),flash)
                    or Color3.new(1,1,1):Lerp(item.to,math.clamp((t-.18)/.55,0,1))
            end
            item.part.Transparency = 0.12 + 0.88 * (t * t * (3 - 2 * t))
        end
    end
end

function LandMergeEffects:Clear()
    for _, item in ipairs(self.active) do
        item.part.Transparency = 1
        table.insert(self.pool, item.part)
    end
    table.clear(self.active)
end

function LandMergeEffects:Destroy()
    self:Clear()
    for _, part in ipairs(self.pool) do part:Destroy() end
    table.clear(self.pool)
end
return LandMergeEffects
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleLeaderboardController"><Properties><string name="Name">LeaderboardController</string><ProtectedString name="Source">-- Small, colorful arcade ranks with public Roblox avatar thumbnails.
-- Only four persistent UI rows; never recreate rows on score updates.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Avatars = require(script.Parent.AvatarThumbnails)
local Leaderboard = {}
Leaderboard.__index = Leaderboard

local WHITE=Color3.new(1,1,1)
local INK=Color3.fromRGB(25,46,123)
local ROW_COLORS={
    Color3.fromRGB(126,61,251),
    Color3.fromRGB(23,201,237),
    Color3.fromRGB(12,185,236),
    Color3.fromRGB(255,215,37),
}

local function gui(parent, class, name, props)
    local i=Instance.new(class)
    i.Name=name
    for k,v in pairs(props or {}) do i[k]=v end
    i.Parent=parent
    return i
end
local function circle(obj, px)
    return gui(obj,"UICorner","Round",{CornerRadius=UDim.new(0,px or 50)})
end
local function stroke(obj,color,width)
    return gui(obj,"UIStroke","Stroke",{Color=color,Thickness=width})
end
local function label(parent,name,value,size,depth)
    return gui(parent,"TextLabel",name,{
        BackgroundTransparency=1,Text=value,Font=Enum.Font.GothamBlack,
        TextSize=size,TextColor3=WHITE,TextStrokeColor3=INK,
        TextStrokeTransparency=1,ZIndex=depth or 37,
    })
end

function Leaderboard.new(parent,config)
    local self=setmetatable({},Leaderboard)
    self.cfg=config
    self.thumbnails=Avatars.new()
    self.compact=true
    self.panel=gui(parent,"Frame","ArcadeLeaderboard",{
        BackgroundColor3=Color3.fromRGB(19,30,48),BackgroundTransparency=.06,BorderSizePixel=0,
        AnchorPoint=Vector2.new(1,0),
        Position=UDim2.new(1,-9,0,78),
        Size=UDim2.fromOffset(155,178),ZIndex=32,
    })
    circle(self.panel,18)
    stroke(self.panel,Color3.fromRGB(67,91,117),1)
    local heading=label(self.panel,"Heading","TOP PAINTERS",10,36)
    heading.TextColor3=Color3.fromRGB(166,187,205)
    heading.Position=UDim2.fromOffset(12,8)
    heading.Size=UDim2.new(1,-24,0,20)
    heading.TextXAlignment=Enum.TextXAlignment.Left
    self.rows={}
    for n=1,math.min(4,config.LeaderboardRows or 4) do
        local row=gui(self.panel,"Frame","Rank"..n,{
            BackgroundTransparency=1,BorderSizePixel=0,
            Position=UDim2.fromOffset(0,(n-1)*43),
            Size=UDim2.new(1,0,0,40),ZIndex=33,
        })
        -- Colored strip starts behind the avatar and ends flush to screen edge.
        local bar=gui(row,"Frame","ColorStrip",{
            AnchorPoint=Vector2.new(1,0.5),
            Position=UDim2.new(1,0,0.5,0),
            Size=UDim2.new(1,-36,0,31),BorderSizePixel=0,
            BackgroundColor3=Color3.fromRGB(31,48,69),ZIndex=33,
        })
        circle(bar,10)
        local avatar=gui(row,"ImageLabel","Avatar",{
            Position=UDim2.fromOffset(3,1),Size=UDim2.fromOffset(38,38),
            BorderSizePixel=0, BackgroundColor3=Color3.fromRGB(242,246,255),
            Image="",ScaleType=Enum.ScaleType.Crop,ZIndex=36,
        })
        circle(avatar,19)
        stroke(avatar,INK,1.9)
        local fallback=label(avatar,"Fallback","●",21,37)
        fallback.Size=UDim2.fromScale(1,1)
        fallback.TextColor3=ROW_COLORS[n]
        fallback.TextStrokeTransparency=1
        local rank=gui(row,"TextLabel","RankBadge",{
            Size=UDim2.fromOffset(16,16), Position=UDim2.fromOffset(0,25),
            BackgroundColor3=WHITE, BorderSizePixel=0,Text=tostring(n),
            Font=Enum.Font.GothamBlack,TextColor3=INK,TextSize=10,ZIndex=40,
        })
        circle(rank,9)
        stroke(rank,INK,1)
        local percent=label(bar,"Percent","0.00%",15,38)
        percent.Size=UDim2.new(1,-14,1,0)
        percent.Position=UDim2.fromOffset(7,0)
        percent.TextXAlignment=Enum.TextXAlignment.Right
        local name=label(bar,"Username","",10,38)
        name.TextXAlignment=Enum.TextXAlignment.Left
        name.TextTruncate=Enum.TextTruncate.AtEnd
        name.TextStrokeTransparency=0.38
        name.Position=UDim2.fromOffset(10,0)
        name.Size=UDim2.new(1,-88,1,0)
        local crown=label(row,"Crown","👑",20,42)
        crown.Position=UDim2.fromOffset(11,-17)
        crown.Size=UDim2.fromOffset(28,22)
        crown.Visible=false
        self.rows[n]={row=row,bar=bar,avatar=avatar,fallback=fallback,rank=rank,
            percent=percent,name=name,crown=crown,userId=nil}
    end
    return self
end

function Leaderboard:Resize(viewport)
    local narrow=viewport.X&lt;900
    self.compact=narrow
    self.maxRows=viewport.Y&lt;500 and 2 or #self.rows
    local width=narrow and 160 or 220
    self.panel.Position=UDim2.new(1,-12,0,viewport.Y&lt;500 and 132 or (narrow and 168 or 56))
    self.panel.Size=UDim2.fromOffset(width,38+self.maxRows*40)
    for i,entry in ipairs(self.rows) do
        entry.row.Visible=i&lt;=self.maxRows
        entry.row.Position=UDim2.fromOffset(8,32+(i-1)*40)
        entry.row.Size=UDim2.new(1,-16,0,38)
        entry.bar.Size=UDim2.new(1,-28,0,32)
        entry.avatar.Size=UDim2.fromOffset(30,30)
        entry.avatar.Position=UDim2.fromOffset(1,4)
        entry.name.Visible=not narrow
        entry.name.Size=UDim2.new(1,-70,1,0)
        entry.percent.TextSize=narrow and 12 or 13
        entry.rank.Position=UDim2.fromOffset(0,24)
        entry.crown.Visible=false
    end
end

function Leaderboard:Update(ordered,leader,world)
    local total=world.grid.playableTotal
    for n,view in ipairs(self.rows) do
        local entity=ordered[n]
        view.row.Visible=entity~=nil and n&lt;=(self.maxRows or #self.rows)
        if entity then
            local count=world.grid.counts[entity.id] or 0
            view.percent.Text=string.format("%.2f%%",count/math.max(1,total)*100)
            view.name.Text=entity.name
            view.bar.BackgroundColor3=entity==leader and Color3.fromRGB(39,78,76) or Color3.fromRGB(31,48,69)
            view.rank.BackgroundColor3=entity==leader and Color3.fromRGB(82,230,186) or WHITE
            view.crown.Visible=false
            local id=entity.isHuman and Players.LocalPlayer.UserId or entity.robloxUserId
            if id~=view.userId then
                view.userId=id
                view.avatar.Image=""
                view.fallback.Visible=true
            end
            local url=self.thumbnails:Get(id)
            if url and view.avatar.Image~=url then
                view.avatar.Image=url
                view.fallback.Visible=false
            elseif not url then
                view.fallback.Text=string.sub(entity.name or "?",1,1):upper()
            end
        end
    end
end

function Leaderboard:Destroy()
    self.thumbnails:Destroy()
    self.panel:Destroy()
end

return Leaderboard
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleLeaderboardService"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source">local Leaderboard = {}

function Leaderboard.Get(world)
    local ranked = table.clone(world.entities)
    table.sort(ranked, function(a, b)
        local ac, bc = world.grid.counts[a.id] or 0, world.grid.counts[b.id] or 0
        if ac ~= bc then return ac &gt; bc end
        if a.kills ~= b.kills then return a.kills &gt; b.kills end
        return a.id &lt; b.id
    end)
    local first = ranked[1]
    local leader = first and first.alive and (world.grid.counts[first.id] or 0) &gt; 0 and first or nil
    return ranked, leader
end

return Leaderboard
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleMainMenu"><Properties><string name="Name">MainMenu</string><ProtectedString name="Source">-- V41: cream arcade panels, a slime mascot and native-size multiplayer controls.
local Fonts=require(script.Parent.Fonts)
local TweenService=game:GetService("TweenService")
local ButtonEffects=require(script.Parent.ButtonEffects)
local Menu={}
Menu.__index=Menu
local INK=Color3.fromRGB(35,32,65)
local WHITE=Color3.fromRGB(248,252,255)
local MUTED=Color3.fromRGB(80,76,103)
local MINT=Color3.fromRGB(149,244,76)
local NAMES={"MINT","CORAL","SKY","VIOLET","GOLD","PINK"}
local function make(parent,class,name,props)
    local o=Instance.new(class);o.Name=name
    for k,v in pairs(props) do o[k]=v end
    o.Parent=parent;return o
end
local function frame(parent,name,props)
    props.BorderSizePixel=0;props.Active=false;props.Selectable=false
    return make(parent,"Frame",name,props)
end
local function round(o,r)
    make(o,"UICorner","Corner",{CornerRadius=UDim.new(0,r)})
end
local function stroke(o,color,thickness,alpha)
    return make(o,"UIStroke","Outline",{Color=color,Thickness=thickness,Transparency=alpha or 0,
        ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
end
local function label(parent,name,value,size,color,z)
    return make(parent,"TextLabel",name,{Text=value,TextSize=size,TextColor3=color,
        FontFace=Fonts.Bold,BackgroundTransparency=1,BorderSizePixel=0,
        Active=false,Selectable=false,ZIndex=z or 45})
end
local function gradient(o,a,b,rotation)
    make(o,"UIGradient","ColorWash",{Color=ColorSequence.new(a,b),Rotation=rotation or 90})
end
function Menu.new(parent,cfg,onSkin,onPlay,onRooms)
    local self=setmetatable({cfg=cfg,visible=false,tweens={},accent={},motes={},skin=1},Menu)
    self.root=frame(parent,"MenuComposition",{AnchorPoint=Vector2.new(.5,.5),
        Position=UDim2.new(.5,0,.5,-12),Size=UDim2.fromOffset(900,420),BackgroundTransparency=1,ZIndex=41})
    self.hero=frame(self.root,"Brand",{BackgroundTransparency=1,ZIndex=42})
    self.badge=label(self.hero,"Eyebrow","THE ARENA IS YOUR CANVAS",10,WHITE)
    self.badge.TextStrokeColor3=INK;self.badge.TextStrokeTransparency=.15
    self.badge.Size=UDim2.new(1,0,0,22)
    self.titleShadow=label(self.hero,"LogoDepth","PAINTLAND",54,Color3.fromRGB(5,14,29),44)
    self.title=label(self.hero,"Logo","PAINTLAND",54,WHITE,45)
    for _,o in ipairs({self.titleShadow,self.title}) do
        o.FontFace=Fonts.Bold;o.Rotation=-4;o.TextScaled=true
        make(o,"UITextSizeConstraint","LogoSize",{MinTextSize=20,MaxTextSize=64})
    end
    gradient(self.title,Color3.fromRGB(255,251,208),Color3.fromRGB(255,209,93),90)
    self.title.TextStrokeColor3=INK;self.title.TextStrokeTransparency=0
    self.subtitle=label(self.hero,"Tagline","Small trail. Big takeover.",15,WHITE)
    self.subtitle.FontFace=Fonts.Regular
    self.subtitle.TextStrokeColor3=INK;self.subtitle.TextStrokeTransparency=.2
    self.subtitle.Size=UDim2.new(1,0,0,24)
    -- A tiny diorama: raised painted tiles, a square trail, and a block mascot.
    self.art=frame(self.hero,"TerritoryIllustration",{AnchorPoint=Vector2.new(.5,.5),
        Size=UDim2.fromOffset(304,158),BackgroundColor3=Color3.fromRGB(255,250,231),BackgroundTransparency=0,Rotation=-7,ZIndex=42})
    round(self.art,35);stroke(self.art,INK,3)
    self.artScale=make(self.art,"UIScale","FitIllustration",{Scale=1})
    for y=1,5 do for x=1,10 do
        local owned=(x&gt;=2 and x&lt;=5 and y&gt;=2 and y&lt;=4)
        local trail=(x&gt;=5 and x&lt;=9 and y==2) or (x==9 and y&gt;=2 and y&lt;=4)
        local color=(owned or trail) and cfg.Colors[1] or Color3.fromRGB(245,234,207)
        local shadow=frame(self.art,"TileDepth",{Position=UDim2.fromOffset((x-1)*30,(y-1)*28+10),
            Size=UDim2.fromOffset(26,26),BackgroundColor3=Color3.fromRGB(205,185,149),ZIndex=42})
        round(shadow,5)
        local tile=frame(self.art,"PaintTile",{Position=UDim2.fromOffset((x-1)*30,(y-1)*28+4),
            Size=UDim2.fromOffset(26,26),BackgroundColor3=color,BackgroundTransparency=owned and .05 or (trail and .12 or .3),ZIndex=43})
        round(tile,5)
        if owned or trail then table.insert(self.accent,tile) end
    end end
    self.mascot=frame(self.art,"PaintRunner",{AnchorPoint=Vector2.new(.5,.5),
        Position=UDim2.fromOffset(233,91),Size=UDim2.fromOffset(70,64),BackgroundColor3=cfg.Colors[1],ZIndex=46})
    round(self.mascot,32);stroke(self.mascot,INK,2)
    gradient(self.mascot,WHITE,Color3.fromRGB(157,179,192))
    table.insert(self.accent,self.mascot)
    for _,x in ipairs({23,48}) do
        local eye=frame(self.mascot,"Eye",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset(x,27),
            Size=UDim2.fromOffset(15,22),BackgroundColor3=WHITE,ZIndex=47})
        round(eye,10)
        local pupil=frame(eye,"Pupil",{Position=UDim2.fromOffset(6,6),Size=UDim2.fromOffset(7,12),BackgroundColor3=INK,ZIndex=48})
        round(pupil,5)
    end
    for i=1,5 do
        local p=frame(self.art,"FloatingPaint",{AnchorPoint=Vector2.new(.5,.5),
            Position=UDim2.fromOffset(20+i*49, i%2==0 and -8 or 152),Size=UDim2.fromOffset(i%2==0 and 8 or 6,8),
            Rotation=i*22,BackgroundColor3=cfg.Colors[i],BackgroundTransparency=.12,ZIndex=44})
        round(p,2);self.motes[i]={gui=p,position=p.Position}
    end
    self.panel=frame(self.root,"LaunchPanel",{BackgroundColor3=Color3.fromRGB(255,250,235),
        BackgroundTransparency=0,Size=UDim2.fromOffset(360,264),ZIndex=44})
    round(self.panel,24);stroke(self.panel,INK,3)
    gradient(self.panel,Color3.fromRGB(255,255,255),Color3.fromRGB(245,227,195))
    local edge=frame(self.panel,"TopAccent",{AnchorPoint=Vector2.new(.5,0),Position=UDim2.fromScale(.5,0),
        Size=UDim2.new(1,-48,0,3),BackgroundColor3=MINT,ZIndex=45})
    round(edge,2)
    self.skinTitle=label(self.panel,"ChooseColor","CHOOSE YOUR COLOR",11,MUTED)
    self.skinTitle.Position=UDim2.fromOffset(20,19);self.skinTitle.Size=UDim2.new(1,-115,0,22)
    self.skinTitle.TextXAlignment=Enum.TextXAlignment.Left
    self.colorName=label(self.panel,"SelectedColor",NAMES[1],10,INK)
    self.colorName.AnchorPoint=Vector2.new(1,0);self.colorName.Position=UDim2.new(1,-20,0,19)
    self.colorName.Size=UDim2.fromOffset(80,22);self.colorName.TextXAlignment=Enum.TextXAlignment.Right
    self.skins={}
    for i=1,6 do
        local b=make(self.panel,"TextButton","Color"..i,{Text=i==1 and "✓" or "",TextSize=23,
            FontFace=Fonts.Bold,TextColor3=INK,BorderSizePixel=0,AutoButtonColor=false,
            Active=true,Selectable=true,AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(44,44),
            BackgroundColor3=cfg.Colors[i],ZIndex=46})
        round(b,22);gradient(b,WHITE,Color3.fromRGB(190,202,225))
        local outline=stroke(b,i==1 and WHITE or cfg.Colors[i],i==1 and 3 or 1)
        self.skins[i]={button=b,stroke=outline}
        b.Activated:Connect(function() self:Select(i);onSkin(i) end)
    end
    self.play=make(self.panel,"TextButton","Play",{Text="PLAY NOW   →",TextSize=23,
        FontFace=Fonts.Bold,TextColor3=INK,BorderSizePixel=0,AutoButtonColor=false,
        Active=true,Selectable=true,AnchorPoint=Vector2.new(.5,.5),Size=UDim2.new(1,-32,0,64),
        BackgroundColor3=MINT,ZIndex=46})
    round(self.play,18);stroke(self.play,INK,3)
    gradient(self.play,WHITE,Color3.fromRGB(170,224,90))
    self.playBase=frame(self.panel,"PlayDepth",{AnchorPoint=Vector2.new(.5,.5),Size=UDim2.new(1,-32,0,64),
        BackgroundColor3=Color3.fromRGB(62,111,45),ZIndex=45})
    round(self.playBase,18)
    self.play.Activated:Connect(onPlay)
    self.help=label(self.panel,"HowToPlay","Close a loop. Claim the land.\nCut a trail. Take the lead.",12,MUTED)
    self.help.FontFace=Fonts.Regular;self.help.TextWrapped=true
    self.help.Position=UDim2.fromOffset(16,201);self.help.Size=UDim2.new(1,-32,0,42)
    self.roomButtons={}
    if onRooms and cfg.MultiplayerEnabled~=false then
        self.help.Visible=false
        for i,action in ipairs({"create","join"}) do
            local b=make(self.panel,"TextButton",action=="create" and "CreateRoom" or "JoinRoom",{
                AnchorPoint=Vector2.new(.5,.5),Size=UDim2.new(.5,-24,0,44),
                Position=UDim2.new(i==1 and .25 or .75,i==1 and 4 or -4,0,222),
                BackgroundColor3=i==1 and Color3.fromRGB(151,211,255) or Color3.fromRGB(202,176,255),
                Text=i==1 and "CREATE ROOM" or "JOIN ROOM",FontFace=Fonts.Bold,TextSize=11,
                TextColor3=INK,AutoButtonColor=false,BorderSizePixel=0,Active=true,Selectable=true,ZIndex=46})
            round(b,13);stroke(b,INK,2);ButtonEffects.Bind(b,cfg)
            b.Activated:Connect(function() if self.visible then onRooms(action) end end)
            table.insert(self.roomButtons,b)
        end
    end
    self.footer=label(self.root,"ModeLabel",cfg.MultiplayerEnabled~=false and "QUICK PLAY  /  PRIVATE ROOMS" or "SOLO ARENA  /  ENDLESS COLOR",9,WHITE)
    self.footer.TextStrokeColor3=INK;self.footer.TextStrokeTransparency=.1
    self.footer.FontFace=Fonts.Regular
    self.footer.AnchorPoint=Vector2.new(.5,0);self.footer.Size=UDim2.fromOffset(280,18)
    self:Resize(Vector2.new(1280,720))
    return self
end
function Menu:Select(index)
    self.skin=index
    for i,v in ipairs(self.skins) do
        v.button.Text=i==index and "✓" or ""
        v.stroke.Thickness=i==index and 3 or 1
        v.stroke.Color=i==index and WHITE or self.cfg.Colors[i]
    end
    for _,tile in ipairs(self.accent) do tile.BackgroundColor3=self.cfg.Colors[index] end
    self.colorName.Text=NAMES[index];self.colorName.TextColor3=self.cfg.Colors[index]
end
function Menu:StopMotion()
    for _,t in ipairs(self.tweens) do t:Cancel() end
    table.clear(self.tweens)
    for _,p in ipairs(self.motes) do p.gui.Position=p.position end
end
function Menu:StartMotion()
    if self.cfg.ReducedMotion then return end
    for i,p in ipairs(self.motes) do
        local t=TweenService:Create(p.gui,TweenInfo.new(1.6+i*.13,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true),
            {Position=UDim2.new(p.position.X.Scale,p.position.X.Offset,p.position.Y.Scale,p.position.Y.Offset-8)})
        table.insert(self.tweens,t);t:Play()
    end
end
function Menu:Show(visible)
    if self.visible==visible then return end
    self.visible=visible;self.root.Visible=visible
    self:StopMotion()
    -- Visibility on the actual button also resets the shared interaction state.
    self.play.Visible=visible
    for _,b in ipairs(self.roomButtons) do b.Visible=visible end
    for _,v in ipairs(self.skins) do v.button.Visible=visible end
    self.hero.Position=self.heroRest or self.hero.Position
    self.panel.Position=self.panelRest or self.panel.Position
    if visible then
        if not self.cfg.ReducedMotion then
            for _,item in ipairs({self.hero,self.panel}) do
                local goal=item.Position
                item.Position=UDim2.new(goal.X.Scale,goal.X.Offset,goal.Y.Scale,goal.Y.Offset+12)
                local t=TweenService:Create(item,TweenInfo.new(.32,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Position=goal})
                table.insert(self.tweens,t);t:Play()
            end
        end
        self:StartMotion()
    end
end
function Menu:Resize(size)
    if size.X&lt;1 or size.Y&lt;1 then return end
    if self.lastWidth==size.X and self.lastHeight==size.Y then return end
    self.lastWidth=size.X;self.lastHeight=size.Y
    self:StopMotion()
    local wide=size.X&gt;=568 and size.X/size.Y&gt;1.4
    local width=math.min(wide and 900 or 440,size.X-(wide and 40 or 24))
    local height=wide and math.min(420,size.Y-96) or math.min(560,size.Y-96)
    height=math.max(264,height)
    self.root.Size=UDim2.fromOffset(width,height)
    local panelWidth=wide and (size.X&lt;620 and 296 or (size.X&lt;900 and 320 or 360)) or width
    self.panel.Size=UDim2.fromOffset(panelWidth,264)
    local heroWidth=wide and width-panelWidth-24 or width
    local heroHeight=wide and height or height-280
    self.hero.Size=UDim2.fromOffset(heroWidth,heroHeight)
    self.hero.Position=UDim2.fromOffset(0,0)
    self.panel.Position=UDim2.fromOffset(wide and width-panelWidth or 0,wide and (height-264)/2 or height-264)
    self.heroRest=self.hero.Position;self.panelRest=self.panel.Position
    self.badge.Position=UDim2.fromOffset(0,wide and 10 or 0)
    local titleY=wide and 37 or 23
    self.title.Position=UDim2.fromOffset(0,titleY);self.title.Size=UDim2.new(1,0,0,66)
    self.titleShadow.Position=UDim2.fromOffset(0,titleY+5);self.titleShadow.Size=self.title.Size
    self.subtitle.Position=UDim2.fromOffset(0,titleY+70)
    local artTop=titleY+104
    local artHeight=math.max(36,heroHeight-artTop-8)
    self.artScale.Scale=math.min(1.15,(heroWidth-16)/304,artHeight/158)
    self.art.Position=UDim2.new(.5,0,0,artTop+artHeight*.5)
    -- Six 44px targets, distributed with equal spacing even at 320px portrait.
    local gap=(panelWidth-24-6*44)/5
    for i,v in ipairs(self.skins) do v.button.Position=UDim2.fromOffset(12+22+(i-1)*(44+gap),78) end
    self.play.Position=UDim2.new(.5,0,0,150)
    self.playBase.Position=UDim2.new(.5,0,0,156)
    self.footer.Position=UDim2.new(.5,0,1,9)
    self.footer.Visible=size.Y-height&gt;=158 or size.X&gt;=900
    if self.visible then self:StartMotion() end
end
function Menu:Destroy()
    self:StopMotion();self.root:Destroy()
end
return Menu
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleMatchmaking"><Properties><string name="Name">Matchmaking</string><ProtectedString name="Source">-- Server-only room registry. Quick Play groups players in this Roblox server;
-- directory entries let private codes route friends to the correct running server.
local MemoryStoreService=game:GetService("MemoryStoreService")
local RunService=game:GetService("RunService")
local Matchmaking={}
Matchmaking.__index=Matchmaking
local LETTERS="ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
function Matchmaking.new(cfg)
    return setmetatable({cfg=cfg,rooms={},byPlayer={},nextRoom=0,rng=Random.new(),
        directory=not RunService:IsStudio() and MemoryStoreService:GetHashMap("PaintlandPrivateRoomsV1") or nil,
        publicDirectory=not RunService:IsStudio() and MemoryStoreService:GetSortedMap("PaintlandPublicServersV1") or nil},Matchmaking)
end
function Matchmaking:Code()
    local code=""
    for _=1,7 do local n=self.rng:NextInteger(1,#LETTERS);code..=LETTERS:sub(n,n) end
    return code
end
function Matchmaking:Create(private,hostId)
    self.nextRoom+=1
    local room={id=tostring(self.nextRoom),private=private,hostId=hostId,players={},count=0,
        capacity=math.clamp(self.cfg.MultiplayerMaxPlayers or 8,2,16),state="lobby",created=os.clock()}
    if private then
        local allocated=false
        for _=1,8 do
            room.code=self:Code()
            if not self.rooms[room.code] then
                if self.directory then
                    local ok,value=pcall(function()
                        return self.directory:UpdateAsync(room.code,function(old)
                            if old then return old end
                            return {jobId=game.JobId,placeId=game.PlaceId,hostId=hostId}
                        end,120)
                    end)
                    if not ok then return nil,"Private room directory unavailable; try again." end
                    allocated=value and value.jobId==game.JobId and value.hostId==hostId
                else allocated=true end
                if allocated then break end
            end
        end
        if not allocated then return nil,"Could not allocate a room code; try again." end
    else room.code="PUBLIC-"..room.id end
    self.rooms[room.code]=room
    return room
end
function Matchmaking:Quick()
    for _,room in pairs(self.rooms) do
        if not room.private and room.count&lt;room.capacity and room.state~="completed" then return room end
    end
    return self:Create(false,0)
end
function Matchmaking:Find(code)
    if type(code)~="string" or #code&gt;16 then return nil,"Invalid room code." end
    code=code:upper():gsub("%s","")
    if not code:match("^[A-Z2-9]+$") or #code~=7 then return nil,"Enter a seven-character room code." end
    local room=self.rooms[code]
    if room then return room end
    if self.directory then
        local ok,destination=pcall(function() return self.directory:GetAsync(code) end)
        if not ok then return nil,"Room lookup unavailable; try again." end
        if destination and destination.jobId~=game.JobId then return nil,nil,destination,code end
    end
    return nil,"Room not found or expired."
end
function Matchmaking:Add(room,player)
    if self.byPlayer[player] or room.count&gt;=room.capacity or room.state=="completed" then return nil end
    local slot
    for i=1,room.capacity do if not room.players[i] then slot=i;break end end
    room.players[slot]=player;room.count+=1;self.byPlayer[player]={room=room,slot=slot}
    if room.hostId==0 then room.hostId=player.UserId end
    return slot
end
function Matchmaking:Remove(player)
    local membership=self.byPlayer[player];if not membership then return end
    local room=membership.room
    room.players[membership.slot]=nil;room.count-=1;self.byPlayer[player]=nil
    if room.hostId==player.UserId then
        room.hostId=0
        for _,other in pairs(room.players) do room.hostId=other.UserId;break end
    end
    if room.count==0 then
        self.rooms[room.code]=nil
        if room.private and self.directory then task.spawn(function() pcall(function() self.directory:RemoveAsync(room.code) end) end) end
    end
    return room,membership.slot
end
function Matchmaking:QuickDestination()
    if not self.publicDirectory then return nil end
    local ok,entries=pcall(function() return self.publicDirectory:GetRangeAsync(Enum.SortDirection.Descending,20) end)
    if not ok then return nil end
    for _,entry in ipairs(entries) do
        local value=entry.value
        if value and value.jobId~=game.JobId and value.free&gt;0 and value.placeId==game.PlaceId then return value end
    end
end
function Matchmaking:Refresh()
    if self.publicDirectory then
        local free,active=0,0
        for _,room in pairs(self.rooms) do
            if not room.private and room.state~="completed" then free+=room.capacity-room.count;active+=room.count end
        end
        if active&gt;0 and free&gt;0 then
            pcall(function() self.publicDirectory:SetAsync(game.JobId,{jobId=game.JobId,placeId=game.PlaceId,free=free},90,active) end)
        else pcall(function() self.publicDirectory:RemoveAsync(game.JobId) end) end
    end
    if not self.directory then return end
    for _,room in pairs(self.rooms) do
        if room.private and room.count&gt;0 then
            pcall(function() self.directory:SetAsync(room.code,{jobId=game.JobId,placeId=game.PlaceId,hostId=room.hostId},120) end)
        end
    end
end
return Matchmaking
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleMatchmakingUI"><Properties><string name="Name">MatchmakingUI</string><ProtectedString name="Source">-- Public queue and private room controls. All membership is decided by the server.
local Fonts=require(script.Parent.Fonts)
local ButtonEffects=require(script.Parent.ButtonEffects)
local Players=game:GetService("Players")
local UI={};UI.__index=UI
local INK=Color3.fromRGB(35,32,71)
local function make(parent,class,name,p)
    local o=Instance.new(class);o.Name=name;for k,v in pairs(p) do o[k]=v end;o.Parent=parent;return o
end
local function text(parent,name,value,size,y,height)
    return make(parent,"TextLabel",name,{Text=value,TextSize=size,FontFace=Fonts.Bold,TextColor3=INK,
        Position=UDim2.fromOffset(16,y),Size=UDim2.new(1,-32,0,height),BackgroundTransparency=1,
        TextWrapped=true,ZIndex=113})
end
local function rounded(o,r)
    make(o,"UICorner","Round",{CornerRadius=UDim.new(0,r)})
    make(o,"UIStroke","Outline",{Thickness=2,Color=INK,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
end
function UI.new(screen,cfg,onCommand)
    local self=setmetatable({cfg=cfg,onCommand=onCommand,room=nil},UI)
    self.root=make(screen,"Frame","Matchmaking",{Size=UDim2.fromScale(1,1),BackgroundColor3=INK,
        BackgroundTransparency=.22,BorderSizePixel=0,Active=true,Visible=false,ZIndex=110})
    self.panel=make(self.root,"Frame","RoomPanel",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),
        Size=UDim2.fromOffset(440,430),BackgroundColor3=Color3.fromRGB(255,248,225),BorderSizePixel=0,ZIndex=111})
    rounded(self.panel,22)
    self.title=text(self.panel,"Title","JOIN A ROOM",25,14,42)
    self.description=text(self.panel,"Description","Enter a friend's room code.",13,58,38)
    self.code=make(self.panel,"TextBox","RoomCode",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.new(.5,0,0,124),
        Size=UDim2.new(1,-32,0,48),Text="",PlaceholderText="ROOM CODE",ClearTextOnFocus=false,
        FontFace=Fonts.Bold,TextSize=23,TextColor3=INK,BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=113})
    rounded(self.code,10)
    self.roster=text(self.panel,"Roster","",14,154,98);self.roster.FontFace=Fonts.Regular
    self.status=text(self.panel,"Status","",12,256,34);self.status.FontFace=Fonts.Regular
    local function button(name,label,y,color,action)
        local b=make(self.panel,"TextButton",name,{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.new(.5,0,0,y),
            Size=UDim2.new(1,-32,0,48),Text=label,FontFace=Fonts.Bold,TextSize=18,TextColor3=INK,
            BackgroundColor3=color,BorderSizePixel=0,ZIndex=114,Active=true,AutoButtonColor=false})
        rounded(b,12);ButtonEffects.Bind(b,cfg,{play=name=="Primary"})
        b.Activated:Connect(function() if self.root.Visible and b.Active then action() end end)
        return b
    end
    self.primary=button("Primary","JOIN",324,Color3.fromRGB(154,242,107),function()
        if self.room then self.onCommand("start",{})
        else
            local code=self.code.Text:gsub("%s+",""):upper()
            if #code&lt;4 or #code&gt;12 or not code:match("^[A-Z0-9]+$") then self:SetStatus("Enter the room code shown by the host.");return end
            self:SetStatus("Joining room...");self.onCommand("join",{code=code})
        end
    end)
    self.back=button("Back","BACK",382,Color3.fromRGB(212,231,255),function()
        self.onCommand("leave",{});self:Hide()
    end)
    self.resize=self.root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        self:Resize(self.root.AbsoluteSize)
    end)
    self:Resize(screen.AbsoluteSize or Vector2.new(1280,720))
    return self
end
function UI:Show(room)
    self.room=room;self.root.Visible=true;self.status.Text=""
    self.code.Visible=room==nil
    self.title.Text=room and (room.private and "PRIVATE ROOM" or "QUICK PLAY") or "JOIN A ROOM"
    self.description.Text=room and (room.private and ("ROOM CODE: "..room.code) or "Finding players for your arena...") or "Enter a friend's room code."
    local names={}
    for _,p in ipairs(room and room.players or {}) do names[#names+1]=p.name..(p.userId==room.hostId and "  / HOST" or "") end
    self.roster.Text=room and string.format("%d / %d PLAYERS\n%s",#names,room.capacity,table.concat(names,"  ·  ")) or "Private rooms keep your match together."
    local host=room and room.hostId==Players.LocalPlayer.UserId
    self.primary.Visible=room==nil or room.private==true
    self.primary.Active=room==nil or host
    self.primary.Text=room==nil and "JOIN ROOM" or (host and "START MATCH" or "WAITING FOR HOST")
    self.back.Text=room and "LEAVE ROOM" or "BACK"
    if self.viewport then self:Resize(self.viewport) end
end
function UI:SetStatus(message) self.status.Text=tostring(message) end
function UI:Hide() self.root.Visible=false end
function UI:Resize(size)
    if not size or size.X&lt;1 or size.Y&lt;1 then return end
    self.viewport=size
    local width=math.min(440,size.X-24);local compact=size.Y&lt;470
    local height=compact and math.min(290,size.Y-24) or 418
    self.panel.Size=UDim2.fromOffset(width,height)
    self.title.Position=UDim2.fromOffset(16,compact and 4 or 14)
    self.description.Position=UDim2.fromOffset(16,compact and 42 or 58)
    self.code.Position=UDim2.new(.5,0,0,compact and 102 or 124)
    self.roster.Position=UDim2.fromOffset(16,compact and 82 or 154)
    self.roster.Size=UDim2.new(1,-32,0,compact and 50 or 98)
    -- Join form and lobby roster occupy the same row; only one is needed.
    self.roster.Visible=not compact or self.room~=nil
    self.status.Position=UDim2.fromOffset(16,compact and 134 or 256)
    self.primary.Position=UDim2.new(.5,0,0,height-84)
    self.back.Position=UDim2.new(.5,0,0,height-28)
end
function UI:Destroy() if self.resize then self.resize:Disconnect() end;self.root:Destroy() end
return UI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleMenuDemo"><Properties><string name="Name">MenuDemo</string><ProtectedString name="Source">-- A separate, silent bot-only match for the main menu. No player input, revive,
-- purchases, rewards or game UI callbacks are attached to this world.
local World=require(script.Parent.World)
local Demo={}
Demo.__index=Demo
function Demo.new(cfg,renderer,events)
    return setmetatable({cfg=cfg,renderer=renderer,events=events or {},active=false,
        rng=Random.new(),age=0,followAge=0,world=nil,target=nil,focus=Vector2.zero},Demo)
end
function Demo:ChooseTarget()
    local alive={}
    for _,e in ipairs(self.world.entities) do
        if e.alive then alive[#alive+1]=e end
    end
    self.target=#alive&gt;0 and alive[self.rng:NextInteger(1,#alive)] or nil
    self.followAge=0
end
function Demo:Start()
    if self.events.onReset then self.events.onReset() end
    self.active=true
    self.age,self.followAge=0,0
    local cfg=table.clone(self.cfg)
    self.world=World.new(cfg,function(index) self.renderer:MarkCell(index) end,{
        onSpawn=function(e) self.renderer:ResetEntityVisual(e.id) end,
        onCapture=function(e,count,cells)
            self.renderer:ClearTrail(e.id)
            if self.events.onCapture then self.events.onCapture(e,count,cells,self.world) end
        end,
        onMerge=function(killer,victim,cells,hit)
            if self.events.onMerge then self.events.onMerge(killer,victim,cells,hit,self.world) end
        end,
        onEliminate=function(victim,killer,cause,hit)
            self.renderer:RemoveEntityVisual(victim.id)
            if self.events.onEliminate then self.events.onEliminate(victim,killer,cause,hit) end
        end,
    })
    self.renderer:SetWorld(self.world)
    for id=1,(self.cfg.MenuDemoBots or 8) do
        local color=cfg.Colors[self.rng:NextInteger(1,#cfg.Colors)]
        local style=cfg.BotStyles[self.rng:NextInteger(1,#cfg.BotStyles)]
        local e=self.world:NewEntity(id,cfg.BotNames[((id-1)%#cfg.BotNames)+1],color,style)
        -- Entity 1 is normally the human; turn it into a bot BEFORE spawning.
        e.isHuman=false
        self.world:Spawn(e)
    end
    self:ChooseTarget()
    self.focus=self.target and self.target.pos or Vector2.zero
    return self.world
end
function Demo:Update(dt)
    if not self.active then return end
    self.age+=math.max(0,dt)
    self.followAge+=math.max(0,dt)
    if self.age&gt;=(self.cfg.MenuDemoRoundSeconds or 55) or self.world.completed then
        self:Start()
        return
    end
    local elapsed=math.clamp(dt,0,.08)
    local step=self.cfg.SimulationSubstep or 1/60
    local steps=math.min(self.cfg.MaxSubsteps or 4,math.max(1,math.ceil(elapsed/step)))
    for _=1,steps do
        self.world:Step(math.min(elapsed/steps,step),function() return nil end)
    end
    if not self.target or not self.target.alive or self.followAge&gt;=(self.cfg.MenuDemoFollowSeconds or 12) then
        self:ChooseTarget()
    end
    if self.target then self.focus=self.focus:Lerp(self.target.pos,1-math.exp(-3*elapsed)) end
end
function Demo:Stop()
    self.active=false
    self.world,self.target=nil,nil
end
return Demo
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleMinimapController"><Properties><string name="Name">MinimapController</string><ProtectedString name="Source">-- Entirely generated HUD minimap. Draws cached chunk rectangles only when ownership changes.
local ChunkGeometry = require(script.Parent.ChunkGeometry)
local UserInputService = game:GetService("UserInputService")

local Minimap = {}
Minimap.__index = Minimap

local function frame(parent, name, color, z)
    local f = Instance.new("Frame")
    f.Name = name
    f.BackgroundColor3 = color
    f.BorderSizePixel = 0
    f.ZIndex = z
    f.Parent = parent
    return f
end

local function text(parent, name, textValue, size)
    local t = Instance.new("TextLabel")
    t.Name = name
    t.BackgroundTransparency = 1
    t.Text = textValue
    t.TextColor3 = Color3.fromRGB(31, 51, 58)
    t.Font = Enum.Font.GothamBold
    t.TextSize = size
    t.ZIndex = 27
    t.Parent = parent
    return t
end

local function round(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
end

function Minimap.new(cfg, parent, renderer)
    local self = setmetatable({}, Minimap)
    self.cfg, self.renderer, self.world = cfg, renderer, nil
    self.chunksWide = math.ceil(cfg.Grid / cfg.Chunk)
    self.chunkPools, self.markers = {}, {}
    self.dirty, self.queue, self.head = {}, {}, 1
    self.elapsed = 0
    self.side = 136
    -- Clean flat minimap with an inset map surface, not a UI dashboard card.
    self.panel = frame(parent, "RuntimeMinimap", Color3.fromRGB(19,30,48),24)
    self.panel.AnchorPoint = Vector2.new(0,1)
    self.panel.Position = UDim2.new(0,13,1,-13)
    self.panel.ClipsDescendants = false
    round(self.panel, 18)
    local outline=Instance.new("UIStroke")
    outline.Color=Color3.fromRGB(67,91,117)
    outline.Thickness=1
    outline.Parent=self.panel

    self.header = text(self.panel, "Title", "", 10)
    self.header.Visible=false
    self.coverage = text(self.panel, "Coverage", "", 9)
    self.coverage.AnchorPoint = Vector2.new(0.5,1)
    self.coverage.Position = UDim2.new(0.5,0,1,-3)
    self.coverage.Size = UDim2.new(1,-10,0,15)
    self.coverage.TextColor3 = Color3.fromRGB(166,187,205)
    self.coverage.TextStrokeColor3=Color3.new(1,1,1)
    self.coverage.TextStrokeTransparency=1
    self.coverage.ZIndex=33

    self.map = frame(self.panel, "Map", Color3.fromRGB(233,249,242),25)
    self.map.Position = UDim2.fromOffset(4,4)
    self.map.ClipsDescendants = true
    round(self.map, 14)
    self.areas = frame(self.map, "Land", Color3.new(1, 1, 1), 25)
    self.areas.BackgroundTransparency = 1
    self.areas.Size = UDim2.fromScale(1, 1)
    self.dots = frame(self.map, "Players", Color3.new(1, 1, 1), 28)
    self.dots.BackgroundTransparency = 1
    self.dots.Size = UDim2.fromScale(1, 1)

    self.cameraBox = frame(self.map, "VisibleArea", Color3.new(1, 1, 1), 26)
    self.cameraBox.BackgroundTransparency = 1
    -- A tilted perspective camera cannot be represented by this axis-aligned box.
    self.cameraBox.Visible = false
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(30, 44, 54)
    stroke.Thickness = 1.4
    stroke.Transparency = 0.75
    stroke.Parent = self.cameraBox
    self:Resize(renderer.viewport.AbsoluteSize)
    return self
end

function Minimap:Resize(viewportSize)
    local small=UserInputService.TouchEnabled or viewportSize.X&lt;750
    self.side=small and (self.cfg.MinimapPhoneSize or 144) or (self.cfg.MinimapDesktopSize or 190)
    if viewportSize.Y&lt;500 then self.side=96 end
    local margin=small and 9 or 15
    self.panel.Position=UDim2.new(0,margin,1,-margin)
    self.panel.Size=UDim2.fromOffset(self.side+8,self.side+26)
    self.map.Size=UDim2.fromOffset(self.side,self.side)
    self.coverage.TextSize=small and 8 or 10
    for id=1,self.chunksWide*self.chunksWide do self:MarkChunk(id) end
end

function Minimap:MarkChunk(id)
    if self.dirty[id] then return end
    self.dirty[id] = true
    self.queue[#self.queue + 1] = id
end

function Minimap:MarkCell(index)
    local n = self.cfg.Grid
    local cx = math.floor(((index - 1) % n) / self.cfg.Chunk)
    local cy = math.floor(math.floor((index - 1) / n) / self.cfg.Chunk)
    self:MarkChunk(cy * self.chunksWide + cx + 1)
end

function Minimap:SetWorld(world)
    self.world = world
    self.areas:ClearAllChildren()
    self.dots:ClearAllChildren()
    self.chunkPools, self.markers = {}, {}
    self.dirty, self.queue, self.head = {}, {}, 1
    for id = 1, self.chunksWide^2 do self:MarkChunk(id) end
    for _, e in ipairs(world.entities) do
        self:EnsureMarker(e)
    end
end

function Minimap:EnsureMarker(e)
    if self.markers[e.id] then return self.markers[e.id] end
    local m = frame(self.dots, "Player" .. e.id, e.color, 29)
    m.AnchorPoint = Vector2.new(0.5, 0.5)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = m
    if e.isHuman then
        local outline = Instance.new("UIStroke")
        outline.Color = Color3.new(1, 1, 1)
        outline.Thickness = 2
        outline.Parent = m
    end
    self.markers[e.id] = m
    return m
end

function Minimap:RebuildChunk(chunkId)
    if not self.world then return end
    local rectangles = ChunkGeometry.Rectangles(self.world.grid, self.cfg, chunkId, self.chunksWide)
    local pool = self.chunkPools[chunkId]
    if not pool then
        pool = {}
        self.chunkPools[chunkId] = pool
    end
    local s = self.side / self.cfg.Grid
    for index, rect in ipairs(rectangles) do
        local item = pool[index]
        if not item then
            item = frame(self.areas, "C" .. chunkId .. "_" .. index, Color3.new(1, 1, 1), 25)
            pool[index] = item
        end
        local e = self.world.entities[rect.owner]
        item.BackgroundColor3 = e and e.color or self.cfg.Colors[1]
        -- Shared integer boundaries avoid fractional seams and overlapping colors.
        local left = math.floor((rect.x1 - 1) * s + 0.5)
        local top = math.floor((rect.y1 - 1) * s + 0.5)
        local right = math.floor(rect.x2 * s + 0.5)
        local bottom = math.floor(rect.y2 * s + 0.5)
        item.Position = UDim2.fromOffset(left, top)
        item.Size = UDim2.fromOffset(right - left, bottom - top)
        item.Visible = right &gt; left and bottom &gt; top
    end
    for i = #rectangles + 1, #pool do pool[i].Visible = false end
end

function Minimap:MapPosition(pos)
    local half = self.cfg.Grid * self.cfg.Cell * 0.5
    local full = half * 2
    return Vector2.new((pos.X + half) / full * self.side,
        (pos.Y + half) / full * self.side)
end

function Minimap:UpdateMarkers(cameraPosition)
    if not self.world then return end
    for _, e in ipairs(self.world.entities) do
        local marker = self:EnsureMarker(e)
        marker.Visible = e.alive
        if e.alive then
            local p = self:MapPosition(e.pos)
            marker.Position = UDim2.fromOffset(p.X, p.Y)
            local diameter = e.isHuman and (self.side &lt; 150 and 7 or 9) or (self.side &lt; 150 and 4 or 5)
            marker.Size = UDim2.fromOffset(diameter, diameter)
            marker.BackgroundColor3 = e.color
        end
    end
    local viewportSize = self.renderer.viewport.AbsoluteSize
    local worldWidth = viewportSize.X / self.renderer.pixelScale
    local worldHeight = viewportSize.Y / self.renderer.pixelScale
    local worldSize = self.cfg.Grid * self.cfg.Cell
    local w, h = math.min(self.side, worldWidth / worldSize * self.side),
        math.min(self.side, worldHeight / worldSize * self.side)
    local center = self:MapPosition(cameraPosition)
    self.cameraBox.Size = UDim2.fromOffset(w, h)
    self.cameraBox.Position = UDim2.fromOffset(
        math.clamp(center.X - w / 2, 0, self.side - w),
        math.clamp(center.Y - h / 2, 0, self.side - h))
end

function Minimap:UpdateStats(world)
    local total = world.grid.playableTotal
    local percent = total &gt; 0 and (world.grid.counts[1] or 0) / total * 100 or 0
    self.coverage.Text = string.format("%.1f%% YOUR LAND", percent)
end

function Minimap:Render(dt, cameraPosition)
    if not self.world then return end
    local built = 0
    while built &lt; 8 and self.head &lt;= #self.queue do
        local id = self.queue[self.head]
        self.queue[self.head] = false
        self.head += 1
        self.dirty[id] = nil
        self:RebuildChunk(id)
        built += 1
    end
    if self.head &gt; #self.queue then
        self.queue = {}
        self.head = 1
    end
    self.elapsed += dt
    if self.elapsed &gt; (self.cfg.MinimapUpdateRate or 0.12) then
        self.elapsed = 0
        self:UpdateMarkers(cameraPosition)
    end
end

function Minimap:Destroy()
    self.panel:Destroy()
end

return Minimap
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleMotionEffects"><Properties><string name="Name">MotionEffects</string><ProtectedString name="Source">-- Lightweight local-player motion feedback: breathing halo + tiny dust specks.
-- No parts, no physics, no TweenService or per-frame instance creation.
local MotionEffects = {}
MotionEffects.__index = MotionEffects

local function rounded(gui)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = gui
end

local function frame(parent, name, z)
    local obj = Instance.new("Frame")
    obj.Name = name
    obj.BackgroundTransparency = 1
    obj.BorderSizePixel = 0
    obj.AnchorPoint = Vector2.new(0.5, 0.5)
    obj.ZIndex = z
    obj.Parent = parent
    return obj
end

function MotionEffects.new(renderer, cfg)
    local layer = frame(renderer.screen, "MotionEffectsLayer", 7)
    layer.AnchorPoint = Vector2.zero
    layer.Size = UDim2.fromScale(1, 1)
    layer.Active = false
    layer.ClipsDescendants = true
    local halo = frame(layer, "PlayerHalo", 7)
    rounded(halo)
    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Thickness = 1.8
    stroke.Transparency = 0.7
    stroke.Parent = halo
    local dust = {}
    for i = 1, (cfg.MotionDustPool or 14) do
        local dot = frame(layer, "Drift" .. i, 7)
        rounded(dot)
        dot.Visible = false
        dust[i] = {gui = dot, age = 999, lifetime = 1}
    end
    return setmetatable({
        renderer = renderer, cfg = cfg,
        layer = layer, halo = halo, stroke = stroke, dust = dust,
        nextDust = 1, accumulated = 0, time = 0, rng = Random.new(),
    }, MotionEffects)
end

function MotionEffects:Clear()
    self.halo.Visible = false
    self.accumulated = 0
    for _, p in ipairs(self.dust) do
        p.age = 999
        p.gui.Visible = false
    end
end

function MotionEffects:Update(dt, entity, camera, enabled)
    dt = math.clamp(dt or 0, 0, 0.07)
    self.time += dt
    local cfg = self.cfg
    if cfg.MotionEffectsEnabled == false or cfg.ReducedMotion or not enabled or not entity or not entity.alive then
        self:Clear()
        return
    end
    local viewport = self.renderer.viewport.AbsoluteSize
    local scale = self.renderer.pixelScale
    local screenPos = self.renderer:GetPlayerScreenPosition(entity.pos, 0.5)
    local haloSize = (7.2 * scale) + 13 + math.sin(self.time * 4.5) * 2
    self.halo.Position = UDim2.fromOffset(screenPos.X, screenPos.Y)
    self.halo.Size = UDim2.fromOffset(haloSize, haloSize)
    self.halo.Visible = true
    self.stroke.Color = entity.color:Lerp(Color3.new(1, 1, 1), 0.35)
    self.stroke.Transparency = entity.drawing and 0.44 or 0.76

    if entity.drawing then
        self.accumulated += dt
        local interval = cfg.MotionDustInterval or 0.095
        if self.accumulated &gt; interval then
            self.accumulated %= interval
            local p = self.dust[self.nextDust]
            self.nextDust = self.nextDust % #self.dust + 1
            p.age = 0
            p.lifetime = self.rng:NextNumber(0.27, 0.52)
            local behind = Vector2.new(math.cos(entity.heading), math.sin(entity.heading))
            p.pos = entity.pos - behind * self.rng:NextNumber(4, 7)
            p.wind = Vector2.new(-behind.Y, behind.X) * self.rng:NextNumber(-16, 16)
            p.size = self.rng:NextNumber(2.5, 4.2)
            p.gui.BackgroundColor3 = entity.color:Lerp(Color3.new(1,1,1), 0.4)
            p.gui.Visible = true
        end
    else
        self.accumulated = 0
    end

    for _, p in ipairs(self.dust) do
        if p.age &lt; p.lifetime then
            p.age += dt
            if p.age &gt;= p.lifetime then
                p.gui.Visible = false
            else
                local t = p.age / p.lifetime
                local loc = self.renderer:GetPlayerScreenPosition(p.pos, 0.5)
                    + p.wind * p.age + Vector2.new(0, -17) * p.age
                local size = p.size * (1 - t * 0.6)
                p.gui.Position = UDim2.fromOffset(loc.X, loc.Y)
                p.gui.Size = UDim2.fromOffset(size, size)
                p.gui.BackgroundTransparency = math.clamp(0.25 + t * 0.75, 0, 1)
            end
        end
    end
end

function MotionEffects:Destroy()
    self.layer:Destroy()
end

return MotionEffects
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleMovement"><Properties><string name="Name">Movement</string><ProtectedString name="Source">-- V23: physics and grid agree on the same circular edge.
-- The old radius ended ~3 studs INSIDE the last valid grid cells.
local Movement = {}

function Movement.Step(entity, dt, cfg, half)
    local diff = math.atan2(
        math.sin(entity.targetHeading - entity.heading),
        math.cos(entity.targetHeading - entity.heading)
    )
    entity.heading += math.clamp(diff, -cfg.TurnRate * dt, cfg.TurnRate * dt)

    local velocity = Vector2.new(math.cos(entity.heading), math.sin(entity.heading))
    local speed = entity.isHuman and cfg.PlayerSpeed or cfg.BotSpeed
    local boosted = math.min(dt,math.max(0,entity.dashRemaining or 0))
    entity.dashRemaining=math.max(0,(entity.dashRemaining or 0)-dt)
    local distance=speed*(dt+boosted*(math.clamp(entity.dashMultiplier or 1,1,3)-1))
    local candidate = entity.pos + velocity * distance

    local physicalRadius = cfg.ArenaRadius or (half - cfg.Cell * 2)
    local maskRadius = physicalRadius - (cfg.ArenaBoundaryMargin or cfg.Cell * 0.85)
    -- Player center may reach every valid rim cell, but stays safely on the disk.
    local edge = math.min(physicalRadius - cfg.Cell * 0.5,
        maskRadius + cfg.Cell * 0.35)

    if candidate.Magnitude &lt;= edge then
        entity.pos = candidate
        return
    end

    -- Smoothly slide ALONG the circle instead of bouncing back before reaching
    -- the actual ownership rim. Don't overwrite the user's target heading.
    local normal = candidate.Unit
    local tangential = velocity - normal * velocity:Dot(normal)
    if tangential.Magnitude &lt; 0.1 then
        local sign = entity.edgeDirection or 1
        tangential = Vector2.new(-normal.Y, normal.X) * sign
    else
        entity.edgeDirection = (tangential:Dot(Vector2.new(-normal.Y, normal.X)) &gt;= 0) and 1 or -1
        tangential = tangential.Unit
    end
    local redirected = (tangential - normal * 0.08).Unit
    entity.heading = math.atan2(redirected.Y, redirected.X)
    entity.pos = normal * edge
end

return Movement
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleMultiplayerClient"><Properties><string name="Name">MultiplayerClient</string><ProtectedString name="Source">-- Server-owned territory with cosmetic client prediction and buffered remote motion.
-- No client collision, capture, kill or revive decision is sent to the server.
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Protocol=require(script.Parent.NetworkProtocol)
local Grid=require(script.Parent.Grid)
local Movement=require(script.Parent.Movement)
local Client={}
Client.__index=Client
local function angle(a,b,t) return a+math.atan2(math.sin(b-a),math.cos(b-a))*t end
local function color(rgb)
    if typeof(rgb)=="Color3" then return rgb end
    return Color3.new(rgb[1] or 1,rgb[2] or 1,rgb[3] or 1)
end
local function clock() return workspace:GetServerTimeNow() end
function Client.new(cfg,callbacks)
    local self=setmetatable({cfg=cfg,callbacks=callbacks or {},sequence=0,lastSnapshot=-1,
        inputTimer=0,samples={},connections={},ready=false,connecting=false,destroyed=false,
        correction=Vector2.zero,pendingVictory=nil},Client)
    self:Connect()
    return self
end
function Client:Emit(name,...)
    local callback=self.callbacks[name]
    if callback then callback(...) end
end
function Client:Connect()
    if self.ready or self.connecting or self.destroyed then return end
    self.connecting=true
    task.spawn(function()
        local folder=ReplicatedStorage:WaitForChild(Protocol.RemoteFolder,10)
        if self.destroyed then return end
        self.connecting=false
        if not folder then
            self:Emit("onError","Multiplayer server missing. Install PaintlandServer in ServerScriptService.")
            return
        end
        local command=folder:WaitForChild(Protocol.CommandRemote,5)
        local input=folder:WaitForChild(Protocol.InputRemote,5)
        local state=folder:WaitForChild(Protocol.StateRemote,5)
        local ability=folder:WaitForChild(Protocol.AbilityRemote,5)
        if self.destroyed then return end
        if not command or not input or not state or not ability then self:Emit("onError","Server network is incomplete. Try again.");return end
        self.commandRemote=command;self.inputRemote=input;self.abilityRemote=ability;self.ready=true
        self.connections[#self.connections+1]=state.OnClientEvent:Connect(function(message)
            if not self.destroyed then self:Receive(message) end
        end)
        if self.pendingCommand then
            local message=self.pendingCommand;self.pendingCommand=nil;command:FireServer(message)
        else command:FireServer({action="sync"}) end
    end)
end
function Client:Command(action,fields)
    if self.destroyed then return end
    if action=="leave" then self.accepting=false
    elseif action=="quick" or action=="create" or action=="join" or action=="replay" then self.accepting=true end
    local message=table.clone(fields or {});message.action=action
    if self.ready then self.commandRemote:FireServer(message)
    else self.pendingCommand=message;self:Connect() end
end
function Client:MapId(id)
    if id==self.playerEntityId then return 1 end
    if id==1 then return self.playerEntityId end
    return id
end
function Client:UseAbility(id)
    if self.ready and self.accepting~=false and self.world and self.world.roomState=="running"
        and self.world.entities[1] and self.world.entities[1].alive then
        self.abilityRemote:FireServer({id=id})
    end
end
function Client:SnapshotStats(snapshot)
    local result=table.clone(snapshot)
    result.color=color(snapshot.color or {1,1,1})
    return result
end
function Client:Receive(message)
    if type(message)~="table" then return end
    local kind=message.kind
    if kind=="wallet" then self:Emit("onWallet",message);return end
    if self.accepting==false and kind~="left" and kind~="error" then return end
    if kind=="snapshot" then self:ApplySnapshot(message)
    elseif kind=="abilityState" then self:Emit("onAbilityState",message)
    elseif kind=="ability" then
        local id=self:MapId(message.actorId)
        if id==1 and message.id=="Dash" and self.predicted then
            self.predicted.dashRemaining=message.duration;self.predicted.dashMultiplier=message.multiplier
        end
        self:Emit("onAbility",message.id,id,message)
    elseif kind=="lobby" then
        self.lobby=message;self.room=message.code
        if self.world then self.world.roomState=message.state end
        self:Emit("onLobby",message)
    elseif kind=="death" then
        if self.world and self.world.entities[1] then self.world.entities[1].alive=false end
        self.predicted=nil;self.correction=Vector2.zero
        self:Emit("onDeath",self:SnapshotStats(message.snapshot),
            math.max(0,message.deadline and message.deadline-clock() or message.remaining or 4),message.revivesLeft or 0)
    elseif kind=="result" then
        self:Emit("onResult",self:SnapshotStats(message.snapshot))
    elseif kind=="revived" then
        self:Emit("onRevived",message)
    elseif kind=="capture" then
        self:Emit("onCapture",self:MapId(message.actorId),message.count,message.playableTotal)
    elseif kind=="elimination" then
        self:Emit("onElimination",self:MapId(message.victimId),message.killerId and self:MapId(message.killerId),message.cause)
    elseif kind=="victory" then
        -- Wait for the completed ownership snapshot before showing final stats.
        self.pendingVictory=message.winnerId
    elseif kind=="left" then
        self.world=nil;self.room=nil;self.lobby=nil;self.predicted=nil;self.samples={};self.lastSnapshot=-1
        self:Emit("onLeft")
    elseif kind=="joining" then self:Emit("onJoining",message.message)
    elseif kind=="error" then self:Emit("onError",message.message or "Matchmaking failed.") end
end
function Client:ApplySnapshot(packet)
    if packet.version~=Protocol.Version or packet.size~=self.cfg.Grid then
        self:Emit("onError","Client and server versions differ. Rejoin after updating the place.");return
    end
    local fresh=not self.world or self.room~=packet.roomId or self.roundId~=packet.roundId or self.playerEntityId~=packet.playerEntityId
    if not fresh and not packet.full and packet.sequence&lt;=self.lastSnapshot then return end
    if fresh and not packet.full then self:Command("sync");return end
    self.playerEntityId=packet.playerEntityId;self.room=packet.roomId;self.roundId=packet.roundId
    self.lastSnapshot=packet.sequence;self.lastReceive=clock();self.lastServerTime=packet.time
    self.ack=packet.ack or 0
    if fresh then
        local grid=Grid.new(self.cfg,function(index) self:Emit("onChanged",index) end)
        self.world={cfg=self.cfg,grid=grid,entities={},time=packet.simulationTime or 0,completed=false,network=true}
        self.samples={};self.predicted=nil;self.correction=Vector2.zero;self.victoryShown=false
    end
    local world=self.world;local grid=world.grid
    if packet.full then
        grid.mask=table.clone(packet.mask);grid.playableTotal=packet.playableTotal
        for i=1,grid.total do grid.owners[i]=self:MapId(packet.owners[i]) end
        if not fresh then for i=1,grid.total do self:Emit("onChanged",i) end end
    else
        for _,entry in ipairs(packet.deltas or {}) do
            local index,owner=entry[1],self:MapId(entry[2])
            if grid.owners[index]~=owner then grid.owners[index]=owner;self:Emit("onChanged",index) end
        end
    end
    grid.counts={}
    for id,count in pairs(packet.counts) do grid.counts[self:MapId(id)]=count end
    world.time=packet.simulationTime or world.time;world.roomState=packet.state
    world.winnerId=packet.winnerId and self:MapId(packet.winnerId)
    world.roundComplete=packet.state=="completed"
    world.completed=world.roundComplete and world.winnerId==1
    for _,wire in ipairs(packet.entities) do
        local id=self:MapId(wire.id)
        local e=world.entities[id]
        local respawn=not e or e.userId~=wire.userId or e.spawnRevision~=wire.spawnRevision or (not e.alive and wire.alive)
        if not e then
            e={id=id,pos=Vector2.new(wire.x,wire.y),home=Vector2.new(wire.x,wire.y),nodes={},trailCells={},trailSet={}}
            world.entities[id]=e
        end
        e.userId=wire.userId;e.name=wire.name;e.connected=wire.connected;e.isHuman=wire.isHuman==true
        e.color=color(wire.color);e.darkColor=Color3.new(e.color.R*.79,e.color.G*.79,e.color.B*.79)
        e.alive=wire.alive;e.kills=wire.kills or 0;e.killStreak=wire.killStreak or 0;e.bestKillStreak=wire.bestKillStreak or 0
        e.drawing=wire.drawing;e.visualVersion=wire.visualVersion;e.trailGeneration=wire.trailGeneration;e.spawnRevision=wire.spawnRevision
        e.targetHeading=wire.targetHeading;e.heading=e.heading or wire.heading
        e.dashRemaining=wire.dashRemaining or 0;e.dashMultiplier=wire.dashMultiplier or 1
        if wire.nodes then
            e.nodes={};for i,p in ipairs(wire.nodes) do e.nodes[i]=Vector2.new(p[1],p[2]) end
        end
        if wire.trailCells then e.trailCells=table.clone(wire.trailCells) end
        local point=Vector2.new(wire.x,wire.y)
        if id==1 then
            local predicted={pos=point,heading=wire.heading,targetHeading=self.desiredHeading or wire.targetHeading,
                isHuman=true,edgeDirection=e.edgeDirection,dashRemaining=e.dashRemaining,dashMultiplier=e.dashMultiplier}
            if wire.alive and packet.state=="running" then
                -- Re-project the authoritative head only through the measured packet age.
                local horizon=math.clamp(clock()-packet.time,0,.2)
                while horizon&gt;0 do local dt=math.min(horizon,1/60);Movement.Step(predicted,dt,self.cfg,grid.half);horizon-=dt end
            end
            if respawn or fresh then
                self.correction=Vector2.zero;e.pos=predicted.pos;e.heading=wire.heading
                self:Emit("onRespawn",e)
            else self.correction=e.pos-predicted.pos end
            self.predicted=predicted
        else
            local list=self.samples[id] or {};self.samples[id]=list
            if respawn then table.clear(list);e.pos=point;e.heading=wire.heading end
            list[#list+1]={time=packet.time,pos=point,heading=wire.heading}
            while #list&gt;5 do table.remove(list,1) end
        end
        if not wire.alive then e.pos=point end
    end
    if fresh then self:Emit("onWorld",world) end
    self:Emit("onSnapshot",world,packet)
    self:Emit("onAbilityState",{cooldowns=packet.cooldowns or {}})
    if world.roundComplete and not self.victoryShown then
        self.victoryShown=true;self.pendingVictory=nil
        self:Emit("onVictory",world.winnerId,world)
    end
end
function Client:Update(dt,getHeading)
    local world=self.world
    if not world or self.destroyed then return end
    dt=math.clamp(dt,0,.1)
    local localEntity=world.entities[1]
    local running=world.roomState=="running" and localEntity and localEntity.alive
    if running and self.predicted then
        local heading=getHeading and getHeading(localEntity)
        if Protocol.IsFinite(heading) then self.desiredHeading=heading end
        self.predicted.targetHeading=self.desiredHeading or self.predicted.targetHeading
        self.inputTimer+=dt
        if self.inputTimer&gt;=.05 and self.ready then
            self.inputTimer=0;self.sequence+=1
            self.inputRemote:FireServer({seq=self.sequence,heading=self.predicted.targetHeading})
        end
        -- A stalled network freezes presentation after a short grace period.
        -- It never continues predicting captures or moving across an old arena.
        if clock()-(self.lastReceive or 0)&lt;.6 then
            local left=dt
            while left&gt;0 do local step=math.min(left,1/60);Movement.Step(self.predicted,step,self.cfg,world.grid.half);left-=step end
        end
        self.correction*=math.exp(-14*dt)
        localEntity.pos=self.predicted.pos+self.correction
        localEntity.heading=angle(localEntity.heading,self.predicted.heading,1-math.exp(-20*dt))
    end
    local renderTime=clock()-(self.cfg.MultiplayerInterpolationDelay or .12)
    for id,list in pairs(self.samples) do
        local e=world.entities[id]
        if e and e.alive and #list&gt;0 then
            local a,b=list[1],list[#list]
            for i=2,#list do if list[i].time&gt;=renderTime then a=list[i-1];b=list[i];break end end
            local span=b.time-a.time
            local t=span&gt;0 and math.clamp((renderTime-a.time)/span,0,1) or 1
            local point=a.pos:Lerp(b.pos,t)
            if renderTime&gt;b.time and span&gt;0 and world.roomState=="running" then
                point=b.pos+(b.pos-a.pos)*(math.min(renderTime-b.time,.1)/span)
            end
            e.pos=point;e.heading=angle(a.heading,b.heading,t)
        end
    end
end
function Client:GetWorld() return self.world end
function Client:Destroy()
    if self.destroyed then return end
    self.destroyed=true
    for _,connection in ipairs(self.connections) do connection:Disconnect() end
    table.clear(self.connections);self.world=nil
end
return Client
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleMultiplayerServer"><Properties><string name="Name">MultiplayerServer</string><ProtectedString name="Source">-- Start once from ServerScriptService. Clients send only heading + lobby intent.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local TeleportService=game:GetService("TeleportService")
local Protocol=require(script.Parent.NetworkProtocol)
local Matchmaking=require(script.Parent.Matchmaking)
local MultiplayerWorld=require(script.Parent.MultiplayerWorld)
local CurrencyService=require(script.Parent.CurrencyService)
local AbilityService=require(script.Parent.AbilityService)
local Server={}
local started=false
function Server.Start(cfg)
    if started then return nil end
    started=true
    local folder=Instance.new("Folder");folder.Name=Protocol.RemoteFolder;folder.Parent=ReplicatedStorage
    local command=Instance.new("RemoteEvent");command.Name=Protocol.CommandRemote;command.Parent=folder
    local input=Instance.new("RemoteEvent");input.Name=Protocol.InputRemote;input.Parent=folder
    local abilityRemote=Instance.new("RemoteEvent");abilityRemote.Name=Protocol.AbilityRemote;abilityRemote.Parent=folder
    local state=Instance.new("RemoteEvent");state.Name=Protocol.StateRemote;state.Parent=folder
    local registry=Matchmaking.new(cfg)
    local clients={};local connections={};local alive=true
    local function now() return workspace:GetServerTimeNow() end
    local function send(player,message)
        if player.Parent==Players then state:FireClient(player,message) end
    end
    local currency=CurrencyService.new(cfg,send)
    registry.currency=currency
    local abilities=AbilityService.new(cfg)
    local function broadcast(room,message)
        for _,player in pairs(room.players) do send(player,message) end
    end
    local function errorTo(player,message) send(player,{kind="error",message=message}) end
    local function lobby(room)
        local players={}
        for slot,player in pairs(room.players) do players[#players+1]={id=slot,userId=player.UserId,name=player.DisplayName} end
        table.sort(players,function(a,b) return a.id&lt;b.id end)
        broadcast(room,{kind="lobby",code=room.code,private=room.private,hostId=room.hostId,
            capacity=room.capacity,players=players,state=room.state})
    end
    local function deathSnapshot(world,e)
        local cells={};local grid=world.grid
        for i=1,grid.total do cells[i]=grid.owners[i]==e.id end
        return {count=grid.counts[e.id] or 0,percent=(grid.counts[e.id] or 0)/math.max(1,grid.playableTotal)*100,
            kills=e.kills,color={e.color.R,e.color.G,e.color.B},size=grid.size,cells=cells,mask=table.clone(grid.mask)}
    end
    local function initialize(room)
        room.dirty={};room.sequence=(room.sequence or 0)+1;room.roundId=(room.roundId or 0)+1
        room.pending={};room.credits={};room.accumulator=0;room.snapshotTimer=0;room.sentTrails={}
        local world
        world=MultiplayerWorld.new(cfg,function(index) room.dirty[index]=true end,{
            onCapture=function(actor,count)
                local owner=room.players[actor.id]
                if owner then currency:Capture(owner,count,world.grid.playableTotal) end
                broadcast(room,{kind="capture",actorId=actor.id,count=count,playableTotal=world.grid.playableTotal})
            end,
            onAbsorb=function(actor,count)
                broadcast(room,{kind="capture",actorId=actor.id,count=count,playableTotal=world.grid.playableTotal})
            end,
            onEliminate=function(victim,killer,cause)
                if killer and killer~=victim and killer.alive and room.players[killer.id] then
                    currency:Kill(room.players[killer.id])
                end
                local player=room.players[victim.id]
                if player then
                    local snapshot=deathSnapshot(world,victim)
                    local window=(room.credits[victim.id] or 0)&gt;0 and (cfg.ReviveWindowSeconds or 4) or 0
                    room.pending[victim.id]={deadline=now()+window,snapshot=snapshot}
                    send(player,{kind="death",remaining=window,
                        deadline=room.pending[victim.id].deadline,revivesLeft=room.credits[victim.id] or 0,
                        killerName=killer and killer.name or nil,cause=cause,snapshot=snapshot})
                end
                broadcast(room,{kind="elimination",victimId=victim.id,killerId=killer and killer.id or nil,cause=cause})
            end,
            onVictory=function(winner)
                room.state="completed";room.pending={}
                broadcast(room,{kind="victory",winnerId=winner.id})
            end,
        },room.capacity)
        room.world=world
    end
    local function snapshot(room,player,full,deltas)
        local membership=registry.byPlayer[player];if not membership then return end
        local entities={}
        local sent=room.sentTrails[player] or {};room.sentTrails[player]=sent
        for i,e in ipairs(room.world.entities) do
            local version=tostring(e.userId)..":"..e.spawnRevision..":"..e.trailGeneration..":"..e.visualVersion..":"..#e.trailCells
            entities[i]=Protocol.Entity(e,full or sent[i]~=version)
            sent[i]=version
        end
        local grid=room.world.grid
        send(player,{kind="snapshot",version=Protocol.Version,roomId=room.code,roundId=room.roundId,sequence=room.sequence,
            time=now(),simulationTime=room.world.time,playerEntityId=membership.slot,
            ack=clients[player] and clients[player].sequence or 0,full=full==true,
            owners=full and table.clone(grid.owners) or nil,mask=full and table.clone(grid.mask) or nil,
            size=grid.size,counts=table.clone(grid.counts),playableTotal=grid.playableTotal,
            entities=entities,deltas=deltas or {},state=room.state,winnerId=room.world.winnerId,
            cooldowns=abilities:State(room.world,room.world.entities[membership.slot])})
    end
    local function finish(room,slot)
        local pending=room.pending[slot];if not pending then return end
        room.pending[slot]=nil;room.world:ReleaseTerritory(slot)
        local player=room.players[slot]
        if player then send(player,{kind="result",snapshot=pending.snapshot}) end
    end
    local function remove(player,notify)
        local membership=registry.byPlayer[player]
        if membership then
            local room=membership.room
            room.world:RemovePlayer(membership.slot);room.pending[membership.slot]=nil;room.credits[membership.slot]=nil
            room.sentTrails[player]=nil
            registry:Remove(player)
            if room.count&gt;0 then lobby(room) end
        end
        if notify then send(player,{kind="left"}) end
    end
    local function join(player,room,skin)
        local existing=registry.byPlayer[player]
        if existing and existing.room==room then snapshot(room,player,true);lobby(room);return end
        if not room.world then initialize(room) end
        local oldMembership=registry.byPlayer[player]
        if oldMembership and oldMembership.room==room then snapshot(room,player,true);lobby(room);return end
        if room.count&gt;=room.capacity or room.state=="completed" then errorTo(player,"That room is full or finished.");return end
        remove(player,false)
        local slot=registry:Add(room,player)
        if not slot then errorTo(player,"Could not join room.");return end
        if not room.world:AddPlayer(slot,player.UserId,player.DisplayName,skin) then
            registry:Remove(player);errorTo(player,"No safe spawn in this arena; try another room.");return
        end
        room.credits[slot]=math.max(0,math.floor(cfg.MultiplayerFreeRevivesPerRun or 1))
        clients[player].heading=nil;clients[player].lastInput=0
        if not room.private and room.count&gt;=math.max(2,cfg.MultiplayerMinPlayers or 2) then room.state="running" end
        room.sequence+=1;snapshot(room,player,true);lobby(room)
        task.spawn(function() registry:Refresh() end)
    end
    local function teleport(player,destination,code,skin)
        if RunService:IsStudio() then errorTo(player,"Cross-server joins require a published experience.");return end
        if destination.placeId~=game.PlaceId or type(destination.jobId)~="string" then errorTo(player,"Room destination expired.");return end
        if not currency:Flush(player) then errorTo(player,"Saving your wallet; please try joining again shortly.");return end
        local options=Instance.new("TeleportOptions");options.ServerInstanceId=destination.jobId
        options:SetTeleportData({paintlandRoom=code,paintlandQuick=code==nil,paintlandSkin=skin})
        send(player,{kind="joining",message="Joining arena..."})
        local ok=pcall(function() TeleportService:TeleportAsync(game.PlaceId,{player},options) end)
        if not ok then errorTo(player,"Could not reach that server. Try again.") end
    end
    local function process(player,message)
        if type(message)~="table" or type(message.action)~="string" then return end
        local client=clients[player];if not client then return end
        if message.action=="leave" and client.busy then client.cancelRequested=true;return end
        if not Protocol.Allow(client.commands,os.clock(),2,5) or client.busy then return end
        client.busy=true
        local ok,err=pcall(function()
            local action=message.action
            local membership=registry.byPlayer[player]
            local skin=Protocol.IsFinite(message.skin) and math.clamp(math.floor(message.skin),1,#cfg.Colors) or client.skin or 1
            currency:Publish(player)
            if action=="sync" then
                if membership then snapshot(membership.room,player,true) end
            elseif action=="quick" then
                local existing
                for _,candidate in pairs(registry.rooms) do
                    if not candidate.private and candidate.count&lt;candidate.capacity and candidate.state~="completed" then existing=candidate;break end
                end
                if existing then join(player,existing,skin)
                else
                    local destination=registry:QuickDestination()
                    if destination then teleport(player,destination,nil,skin)
                    else local room,why=registry:Quick();if room then join(player,room,skin) else errorTo(player,why) end end
                end
            elseif action=="create" then
                local room,why=registry:Create(true,player.UserId)
                if room then join(player,room,skin) else errorTo(player,why) end
            elseif action=="join" then
                local room,why,destination,code=registry:Find(message.code)
                if room then join(player,room,skin)
                elseif destination then teleport(player,destination,code,skin)
                else errorTo(player,why) end
            elseif action=="leave" then remove(player,true)
            elseif membership then
                local room,slot=membership.room,membership.slot
                if action=="start" then
                    if room.hostId~=player.UserId or room.state~="lobby" then return end
                    if room.count&lt;2 then errorTo(player,"At least two players are needed to start.");return end
                    room.state="running";lobby(room)
                elseif action=="revive" then
                    local pending=room.pending[slot]
                    if not pending or now()&gt;=pending.deadline or (room.credits[slot] or 0)&lt;1 then
                        errorTo(player,"No revive remaining.");return
                    end
                    if room.world:RevivePlayer(slot) then
                        room.credits[slot]-=1;room.pending[slot]=nil
                        send(player,{kind="revived",revivesLeft=room.credits[slot]})
                        room.sequence+=1;snapshot(room,player,true)
                    else errorTo(player,"No safe revive position.") end
                elseif action=="decline" then finish(room,slot)
                elseif action=="replay" then
                    if room.pending[slot] then finish(room,slot) end
                    if room.private then
                        if room.state=="completed" and room.hostId==player.UserId then
                            initialize(room);room.state="lobby"
                            for id,p in pairs(room.players) do
                                if not room.world:AddPlayer(id,p.UserId,p.DisplayName,clients[p].skin or 1) then
                                    errorTo(p,"No safe spawn in this round. Leave and try another arena.")
                                end
                                clients[p].heading=nil;clients[p].lastInput=0
                                room.credits[id]=math.max(0,math.floor(cfg.MultiplayerFreeRevivesPerRun or 1))
                                snapshot(room,p,true)
                            end
                            lobby(room)
                        else errorTo(player,"The host can start a new private round after this round finishes.") end
                    else
                        remove(player,false)
                        local nextRoom,why=registry:Quick()
                        if nextRoom then join(player,nextRoom,skin) else errorTo(player,why) end
                    end
                end
            end
            client.skin=skin
        end)
        client.busy=false
        if client.cancelRequested then client.cancelRequested=false;remove(player,true) end
        if not ok then warn("[Paintland Multiplayer] Command failed: "..tostring(err));errorTo(player,"The action could not be completed. Try again.") end
    end
    connections[#connections+1]=command.OnServerEvent:Connect(process)
    connections[#connections+1]=input.OnServerEvent:Connect(function(player,message)
        local client=clients[player];local membership=registry.byPlayer[player]
        if not client or not membership or membership.room.state~="running" then return end
        if not Protocol.Allow(client.inputs,os.clock(),35,8) then return end
        local seq,heading=Protocol.Input(message,client.sequence)
        if seq then client.sequence=seq;client.heading=heading;client.lastInput=now() end
    end)
    connections[#connections+1]=abilityRemote.OnServerEvent:Connect(function(player,message)
        local client=clients[player];local membership=registry.byPlayer[player]
        if not client or not membership or type(message)~="table" or type(message.id)~="string" then return end
        if not Protocol.Allow(client.abilities,os.clock(),2,4) then return end
        local room=membership.room;local actor=room.world.entities[membership.slot]
        local accepted,result=abilities:Use(room.world,actor,message.id,room.state=="running")
        send(player,{kind="abilityState",id=message.id,accepted=accepted,reason=not accepted and result or nil,
            cooldowns=abilities:State(room.world,actor)})
        if accepted then
            broadcast(room,{kind="ability",actorId=actor.id,id=message.id,x=actor.pos.X,y=actor.pos.Y,
                duration=result.duration,multiplier=result.multiplier,radius=result.radius})
        end
    end)
    local function added(player)
        if clients[player] then return end
        clients[player]={sequence=0,inputs={},commands={},abilities={},skin=1}
        currency:Add(player)
        task.defer(function()
            if player.Parent~=Players then return end
            local ok,joinData=pcall(function() return player:GetJoinData() end)
            local data=ok and joinData.TeleportData
            if type(data)=="table" then
                if type(data.paintlandRoom)=="string" then process(player,{action="join",code=data.paintlandRoom,skin=data.paintlandSkin})
                elseif data.paintlandQuick==true then process(player,{action="quick",skin=data.paintlandSkin}) end
            end
        end)
    end
    connections[#connections+1]=Players.PlayerAdded:Connect(added)
    connections[#connections+1]=Players.PlayerRemoving:Connect(function(player) remove(player,false);clients[player]=nil;currency:Remove(player) end)
    for _,player in ipairs(Players:GetPlayers()) do added(player) end
    connections[#connections+1]=TeleportService.TeleportInitFailed:Connect(function(player)
        if clients[player] then errorTo(player,"Joining the server failed. Please try again.") end
    end)
    local refresh=0
    connections[#connections+1]=RunService.Heartbeat:Connect(function(dt)
        if not alive then return end
        currency:Update(dt)
        refresh+=dt
        if refresh&gt;=35 then refresh=0;task.spawn(function() registry:Refresh() end) end
        for _,room in pairs(registry.rooms) do
            local world=room.world
            if world then
                if room.state=="running" then
                    room.accumulator=math.min(room.accumulator+dt,.25)
                    local steps=0
                    while room.accumulator&gt;=1/60 and steps&lt;12 do
                        room.accumulator-=1/60;steps+=1
                        world:Step(1/60,function(e)
                            local player=room.players[e.id];local client=player and clients[player]
                            if client and now()-(client.lastInput or 0)&lt;1 then return client.heading end
                            return nil
                        end)
                    end
                end
                for slot,pending in pairs(room.pending) do
                    if now()&gt;=pending.deadline then finish(room,slot) end
                end
                room.snapshotTimer+=dt
                if room.snapshotTimer&gt;=1/(cfg.MultiplayerSnapshotRate or 10) then
                    room.snapshotTimer=0;room.sequence+=1
                    local deltas={}
                    for index in pairs(room.dirty) do deltas[#deltas+1]={index,world.grid.owners[index]} end
                    table.clear(room.dirty)
                    for _,player in pairs(room.players) do snapshot(room,player,false,deltas) end
                end
            end
        end
    end)
    game:BindToClose(function() currency:Shutdown() end)
    function registry:Destroy()
        alive=false
        currency:Shutdown()
        for _,connection in ipairs(connections) do connection:Disconnect() end
        for player in pairs(clients) do remove(player,false) end
        folder:Destroy();started=false
    end
    return registry
end
return Server
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleMultiplayerWorld"><Properties><string name="Name">MultiplayerWorld</string><ProtectedString name="Source">-- Server adapter: the original capture, collision and movement modules remain authoritative.
local World=require(script.Parent.World)
local SpawnService=require(script.Parent.SpawnService)
local TrailMerge=require(script.Parent.TrailMerge)
local MultiplayerWorld={}
MultiplayerWorld.__index=function(_,key) return MultiplayerWorld[key] or World[key] end
function MultiplayerWorld.new(cfg,changed,events,capacity)
    local self=setmetatable(World.new(cfg,changed,events),MultiplayerWorld)
    self.defeats={}
    for id=1,capacity do
        local e=self:NewEntity(id,"",cfg.Colors[(id-1)%#cfg.Colors+1],"Human")
        e.isHuman=true;e.connected=false;e.respawnAt=math.huge
    end
    return self
end
function MultiplayerWorld:AddPlayer(id,userId,name,colorIndex)
    local e=self.entities[id]
    if not e or e.connected then return false end
    self.defeats[id]=nil
    e.userId=userId;e.name=name;e.color=self.cfg.Colors[colorIndex] or self.cfg.Colors[(id-1)%#self.cfg.Colors+1]
    e.darkColor=Color3.new(e.color.R*.79,e.color.G*.79,e.color.B*.79)
    e.connected=true;e.isHuman=true;e.kills=0;e.killStreak=0;e.bestKillStreak=0
    e.abilityReadyAt={};e.dashRemaining=0;e.dashMultiplier=1
    if not self:Spawn(e) then e.connected=false;e.respawnAt=math.huge;return false end
    return true
end
function MultiplayerWorld:RemovePlayer(id)
    local e=self.entities[id];if not e then return end
    self.defeats[id]=nil
    e.alive=false;e.connected=false;e.respawnAt=math.huge
    e.dashRemaining=0
    self.trails:Clear(e);self.grid:TransferAll(id,0)
end
-- Preserve the contact route before the core clears the victim trail. Land stays
-- reserved during the revive window; only an exhausted/declined life transfers it.
function MultiplayerWorld:Eliminate(victim,killer,cause,claimContext,hit)
    if self.completed or not victim or not victim.alive then return end
    local record={}
    if killer and killer~=victim and killer.alive and killer.connected then
        record.killerId=killer.id;record.killerUserId=killer.userId;record.killerSpawnRevision=killer.spawnRevision
        if cause=="trail" then record.route=TrailMerge.Route(self.grid,killer,victim,hit) end
    end
    self.defeats[victim.id]=record
    return World.Eliminate(self,victim,killer,cause,claimContext,hit)
end
function MultiplayerWorld:CheckVictory()
    if self.completed then return true end
    local total=self.grid.playableTotal
    for _,e in ipairs(self.entities) do
        if e.connected and e.alive and total&gt;0 and (self.grid.counts[e.id] or 0)&gt;=total then
            self.grid:Recount()
            if (self.grid.counts[e.id] or 0)&gt;=total then
                self.completed=true;self.winnerId=e.id
                for _,actor in ipairs(self.entities) do self.trails:Clear(actor) end
                if self.events.onVictory then self.events.onVictory(e,self) end
                return true
            end
        end
    end
    return false
end
-- Normal revival returns to surviving territory. Never overwrite another player
-- when no safe spawn exists; report failure while retaining the server credit.
function MultiplayerWorld:RevivePlayer(id)
    if self.completed then return false end
    local e=self.entities[id]
    if not e or not e.connected or e.alive then return false end
    local point=self.grid:FindNearestOwned(id,e.pos)
    if not point then point=SpawnService.Choose(self,e) end
    if not point then return false end
    self.defeats[id]=nil
    self.trails:Clear(e)
    e.pos=point;e.home=point;e.alive=true;e.respawnAt=math.huge;e.spawnRevision+=1
    e.dashRemaining=0
    if self.grid:GetOwnerAt(point)~=id then self.grid:SpawnLand(id,point) end
    e.heading=self.rng:NextNumber(-math.pi,math.pi);e.targetHeading=e.heading
    if self.events.onSpawn then self.events.onSpawn(e) end
    return true
end
function MultiplayerWorld:ReleaseTerritory(id)
    local e=self.entities[id]
    if not e or e.alive then return end
    local record=self.defeats[id];self.defeats[id]=nil
    local killer=record and record.killerId and self.entities[record.killerId]
    if killer and killer.connected and killer.alive and killer.userId==record.killerUserId
        and killer.spawnRevision==record.killerSpawnRevision and not self.completed then
        local cells,count,_,affected=self.grid:AbsorbDefeatedLand(id,killer.id,record.route)
        -- Never erase a newer, still-exposed trail after the four-second choice.
        if killer.drawing then
            local consumed=true
            for _,index in ipairs(killer.trailCells) do if self.grid.owners[index]~=killer.id then consumed=false;break end end
            if consumed then self.trails:Clear(killer) end
        end
        self:ResolveClaims(killer,cells,affected)
        if count&gt;0 and self.events.onAbsorb then self.events.onAbsorb(killer,count,cells) end
        self:CheckVictory()
    else self.grid:TransferAll(id,0) end
end
return MultiplayerWorld
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleNameService"><Properties><string name="Name">NameService</string><ProtectedString name="Source">-- Resolves real, public Roblox display names for local AI opponents.
-- No off-platform HTTP APIs or server script are required.
-- Lookup is asynchronous, so a slow Roblox response never freezes the game.
local UserService = game:GetService("UserService")
local Players = game:GetService("Players")

local NameService = {}
NameService.__index = NameService

function NameService.new(cfg)
    return setmetatable({
        cfg = cfg,
        rng = Random.new(),
        verified = {},
        knownIds = {},
        loading = false,
        finished = false,
        currentWorld = nil,
    }, NameService)
end

local function cleanName(info)
    if type(info) ~= "table" then return nil end
    if type(info.Id) ~= "number" or type(info.Username) ~= "string" then return nil end
    local displayName = info.DisplayName
    if type(displayName) ~= "string" or displayName == "" then
        displayName = info.Username
    end
    if displayName == "" or info.Username == "" then return nil end
    return {
        id = info.Id,
        username = info.Username,
        displayName = displayName,
    }
end

function NameService:Apply(world)
    if self.currentWorld ~= world then return end

    -- Don't change an already-selected identity each time another lookup finishes.
    local candidates = table.clone(self.verified)
    for i = #candidates, 2, -1 do
        local j = self.rng:NextInteger(1, i)
        candidates[i], candidates[j] = candidates[j], candidates[i]
    end

    local usedNames, usedIds = {}, {}
    local human = world.entities[1]
    if human then usedNames[string.lower(human.name)] = true end
    if Players.LocalPlayer then usedNames[string.lower(Players.LocalPlayer.Name)] = true end

    for _, e in ipairs(world.entities) do
        if not e.isHuman and e.robloxUserId then
            usedIds[e.robloxUserId] = true
            usedNames[string.lower(e.name)] = true
        end
    end

    for _, entity in ipairs(world.entities) do
        if not entity.isHuman and not entity.robloxUserId then
            local selected
            for _, candidate in ipairs(candidates) do
                if not usedIds[candidate.id] then
                    local display = candidate.displayName
                    if usedNames[string.lower(display)] then
                        display = candidate.username
                    end
                    if not usedNames[string.lower(display)] then
                        selected = candidate
                        entity.name = display
                        break
                    end
                end
            end
            if selected then
                entity.robloxUserId = selected.id
                entity.robloxUsername = selected.username
                usedIds[selected.id] = true
                usedNames[string.lower(entity.name)] = true
            end
        end
    end
end

function NameService:Assign(world)
    self.currentWorld = world
    self:Apply(world)
    if self.loading or self.finished then return end
    self.loading = true

    task.spawn(function()
        local needed = self.cfg.BotCount
        local attempts = self.cfg.NameLookupAttempts or 3
        local batchSize = self.cfg.NameLookupBatchSize or 44
        local minId = self.cfg.RandomUserIdMin or 10000000
        local maxId = self.cfg.RandomUserIdMax or 2000000000
        local myId = Players.LocalPlayer and Players.LocalPlayer.UserId or 0

        for attempt = 1, attempts do
            if #self.verified &gt;= needed * 2 then break end

            local ids = {}
            for _ = 1, batchSize do
                local id = self.rng:NextInteger(minId, maxId)
                if id ~= myId and not self.knownIds[id] then
                    self.knownIds[id] = true
                    ids[#ids + 1] = id
                end
            end

            if #ids &gt; 0 then
                local ok, results = pcall(function()
                    return UserService:GetUserInfosByUserIdsAsync(ids)
                end)
                if ok and type(results) == "table" then
                    for _, info in ipairs(results) do
                        local account = cleanName(info)
                        if account and account.id ~= myId then
                            self.verified[#self.verified + 1] = account
                        end
                    end
                    -- Refresh the current world's names, including live HUD labels.
                    if self.currentWorld then self:Apply(self.currentWorld) end
                else
                    warn("[Paintland] Roblox username lookup failed; using offline names", results)
                end
            end
            if attempt &lt; attempts then task.wait(1.5) end
        end

        self.loading = false
        self.finished = true
        if self.currentWorld then self:Apply(self.currentWorld) end
    end)
end

return NameService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleNetworkProtocol"><Properties><string name="Name">NetworkProtocol</string><ProtectedString name="Source">-- Shared wire format; server validates intent, never client positions or ownership.
local Protocol={Version=2,RemoteFolder="PaintlandNetwork",CommandRemote="Command",StateRemote="State",InputRemote="Input",AbilityRemote="Ability"}
function Protocol.IsFinite(value)
    return type(value)=="number" and value==value and value&gt;-math.huge and value&lt;math.huge
end
function Protocol.Input(message,lastSequence)
    if type(message)~="table" or not Protocol.IsFinite(message.seq) or message.seq%1~=0
        or message.seq&lt;1 or message.seq&gt;2147483647 or message.seq&lt;=(lastSequence or 0)
        or not Protocol.IsFinite(message.heading) then return nil end
    return message.seq,math.atan2(math.sin(message.heading),math.cos(message.heading))
end
function Protocol.Allow(bucket,now,rate,capacity)
    bucket.tokens=math.min(capacity,(bucket.tokens or capacity)+math.max(0,now-(bucket.time or now))*rate)
    bucket.time=now
    if bucket.tokens&lt;1 then return false end
    bucket.tokens-=1;return true
end
function Protocol.Entity(e,includeTrail)
    local nodes={}
    if includeTrail~=false then for i,p in ipairs(e.nodes) do nodes[i]={p.X,p.Y} end end
    return {id=e.id,userId=e.userId or 0,name=e.name,color={e.color.R,e.color.G,e.color.B},
        connected=e.connected==true,isHuman=e.isHuman,alive=e.alive,x=e.pos.X,y=e.pos.Y,
        heading=e.heading,targetHeading=e.targetHeading,kills=e.kills,killStreak=e.killStreak,
        dashRemaining=e.dashRemaining or 0,dashMultiplier=e.dashMultiplier or 1,
        bestKillStreak=e.bestKillStreak,drawing=e.drawing,visualVersion=e.visualVersion,
        trailGeneration=e.trailGeneration,spawnRevision=e.spawnRevision,nodes=includeTrail~=false and nodes or nil,
        trailCells=includeTrail~=false and table.clone(e.trailCells) or nil}
end
return Protocol
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleRegressionTests"><Properties><string name="Name">RegressionTests</string><ProtectedString name="Source">-- Deterministic regression tests, also executed by the headless Luau harness.
-- They exercise the actual World / Grid / TerritorySystem implementations.
local Grid = require(script.Parent.Grid)
local World = require(script.Parent.World)
local Test = {}

local function captureCases(cfg)
    local small = table.clone(cfg)
    small.Grid, small.Cell, small.ArenaRadius = 12, 1, 100
    small.ArenaBoundaryMargin = 0
    small.BoundaryAssistDepthCells = 0
    local function grid() return Grid.new(small) end
    local function paint(g, x1, y1, x2, y2, owner)
        for y = y1, y2 do for x = x1, x2 do g:Set(g:Index(x,y), owner) end end
    end
    local function ring(g, owner)
        paint(g,2,2,11,2,owner); paint(g,2,11,11,11,owner)
        paint(g,2,3,2,10,owner); paint(g,11,3,11,10,owner)
    end
    -- 64 enclosed cells are larger than the 44-cell exterior.
    local g = grid()
    ring(g,1)
    g:Capture(1,{})
    assert(g.owners[g:Index(6,6)] == 1, "Large enclosed region was left uncaptured")
    assert(g.owners[g:Index(1,1)] == 0, "Exterior was incorrectly claimed")
    assert(g.counts[1] == 100, "Incorrect enclosed area count")
    -- A single remaining interior component must finish the board.
    g = grid()
    for i=1,g.total do g:Set(i,1) end
    paint(g,5,5,7,7,2)
    local _,changed,affected = g:Capture(1,{})
    assert(g.counts[1] == g.playableTotal and g.counts[2] == 0,
        "Final enclosed opponent blocked 100%")
    assert(changed[g:Index(6,6)] and affected[2], "Capture metadata missing")
    -- A divider touching both walls keeps the larger exterior.
    g = grid()
    paint(g,4,1,4,12,1)
    g:Capture(1,{})
    assert(g.owners[g:Index(2,6)] == 1 and g.owners[g:Index(8,6)] == 0,
        "Wall-to-wall capture chose the wrong side")
    -- Direct inheritance must neither draw a corridor nor steal third-party land.
    g = grid()
    g:Set(g:Index(2,6),1); g:Set(g:Index(10,6),2)
    paint(g,6,1,6,12,3)
    local cells,count = g:AbsorbDefeatedLand(2,1)
    assert(count == 1 and cells[g:Index(10,6)], "Defeated land failed to transfer")
    assert(g.owners[g:Index(5,6)] == 0 and g.counts[3] == 12,
        "Inheritance manufactured a corridor or stole rival land")
    -- Absorbing A can cover B's head; both must be eliminated in one capture.
    local w = World.new(small,nil,{onMerge=function() error("intentional VFX failure") end})
    local a=w:NewEntity(1,"Tester",cfg.Colors[1],"Human")
    local b=w:NewEntity(2,"Bot A",cfg.Colors[2],"Farmer")
    local c=w:NewEntity(3,"Bot B",cfg.Colors[3],"Farmer")
    for _,e in ipairs(w.entities) do e.alive=true end
    a.pos=w.grid:Center(2,2); b.pos=w.grid:Center(6,6); c.pos=w.grid:Center(1,1)
    ring(w.grid,1)
    w.grid:Set(w.grid:Index(6,6),2)
    w.grid:Set(w.grid:Index(1,1),2)
    w.grid:Set(w.grid:Index(12,12),3)
    w:Capture(a)
    assert(not b.alive and not c.alive and a.kills == 2,
        "Capture did not resolve all heads covered by inheritance")
    assert(w.grid.owners[w.grid:Index(12,12)] == 1,
        "Chain elimination failed to transfer all victim territory")
    print("[Paintland V27 TEST PASS] 5 capture/inheritance regression scenarios")
end

function Test.Run(cfg)
    captureCases(cfg)
    local world = World.new(cfg, nil, {
        onVictory = function(_, w)
            w._testVictoryCalls = (w._testVictoryCalls or 0) + 1
        end,
    })
    local grid = world.grid
    local actor = world:NewEntity(1, "Tester", cfg.Colors[1], "Human")
    actor.alive = true
    actor.pos = Vector2.zero
    actor.heading = 0
    actor.trailCells = {}
    actor.trailSet = {}
    local original = {}
    local target = math.floor(grid.playableTotal * 0.74)
    for i = 1, grid.total do
        if grid.mask[i] and #original &lt; target then
            grid:Set(i, 1)
            original[#original + 1] = i
        end
    end
    -- Previously, pruning by head near a smaller detached component erased
    -- the majority of captured land. This test forbids THAT regression.
    actor.pos = Vector2.new(grid.maskRadius * 0.85, 0)
    local x, y = grid:Coords(actor.pos)
    for dy = -1, 1 do
        local idx = grid:Index(x, y + dy)
        if idx and grid.owners[idx] ~= 1 then
            actor.trailCells[#actor.trailCells + 1] = idx
        end
    end
    if #actor.trailCells == 0 then
        local i = grid:At(actor.pos)
        if i then actor.trailCells[1] = i end
    end
    local oldCount = grid.counts[1] or 0
    -- Use WORLD's genuine capture path, which previously called destructive
    -- pruning in TerritorySystem and World:Eliminate.
    world:Capture(actor)
    assert((grid.counts[1] or 0) &gt;= oldCount,
        "Capture deleted previously owned land")
    for _, idx in ipairs(original) do
        assert(grid.owners[idx] == 1, "Capture erased an old owned cell")
    end

    for i = 1, grid.total do
        if grid.mask[i] then grid:Set(i, 1) end
    end
    local won = world:CheckVictory()
    assert(won and world.completed, "100% did not lock Victory")
    assert(world._testVictoryCalls == 1, "Victory callback not fired exactly once")
    world:Step(1/30, function() return nil end)
    assert(world._testVictoryCalls == 1, "Victory re-triggered on a later step")
    assert((grid.counts[1] or 0) == grid.playableTotal,
        "Victory-owned cells disappeared after stepping")
    print(string.format("[Paintland V26 TEST PASS] Capture preserved %d cells; Victory locked at %d/%d",
        #original, grid.counts[1], grid.playableTotal))
end

return Test
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleRenderer"><Properties><string name="Name">Renderer</string><ProtectedString name="Source">-- V20: single authoritative VISUAL representation in Workspace.
-- 3D actors, 3D land, 3D trails. PlayerGui is HUD/effects only.
local TrailRenderer = require(script.Parent.TrailRenderer)
local ChunkGeometry = require(script.Parent.ChunkGeometry)
local WorkspaceArena = require(script.Parent.WorkspaceArena)
local CharacterVisuals = require(script.Parent.CharacterVisuals)

local Renderer = {}
Renderer.__index = Renderer

local function effectViewport(parent)
    local frame = Instance.new("Frame")
    frame.Name = "ScreenEffectsOnly"
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.Size = UDim2.fromScale(1, 1)
    frame.ClipsDescendants = true
    frame.Active = false
    frame.Parent = parent
    return frame
end

local function createLandPart(parent)
    local tile = Instance.new("Part")
    tile.Name = "PaintTop"
    tile.Anchored = true
    tile.CanCollide, tile.CanTouch, tile.CanQuery = false, false, false
    tile.CastShadow = false
    tile.Material = Enum.Material.SmoothPlastic
    tile.Parent = parent
    return tile
end

function Renderer.new(cfg, playerGui)
    local self = setmetatable({}, Renderer)
    self.cfg = cfg
    local oldScreen = playerGui:FindFirstChild("PaintlandGame")
    if oldScreen then oldScreen:Destroy() end
    -- Remove previous world-space GUI surfaces left by V17/V18/V19.
    for _, name in ipairs({"PaintlandFloorSurfaceV18", "PaintlandFloorSurfaceV17", "PaintlandFloorSurface"}) do
        local old = playerGui:FindFirstChild(name)
        if old then old:Destroy() end
    end

    local screen = Instance.new("ScreenGui")
    screen.Name = "PaintlandGame"
    screen.ResetOnSpawn = false
    screen.IgnoreGuiInset = true
    screen.DisplayOrder = 30
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.Parent = playerGui
    self.screen = screen
    self.viewport = effectViewport(screen)
    self.arena = WorkspaceArena.new(self.viewport, cfg)
    self.characters = CharacterVisuals.new(self.arena.actorsFolder, cfg)
    self.actorObjects = self.characters.objects
    self.trailRenderer = TrailRenderer.new(self.arena.trailFolder, cfg)
    self.half = cfg.Grid * cfg.Cell / 2
    self.pixelScale = 1
    self.chunksWide = math.ceil(cfg.Grid / cfg.Chunk)
    self.chunkObjects = {}
    self.dirtySet, self.dirtyQueue, self.dirtyHead = {}, {}, 1
    self.world = nil
    self.leaderId = nil
    self.contourCanvas = nil  -- deprecated: never create a second territory image
    self.resizeConnection = self.viewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        self:Resize()
    end)
    self:Resize()
    return self
end

function Renderer:SetWorld(world)
    self.world = world
    self.arena.landFolder:ClearAllChildren()
    self.chunkObjects = {}
    self.dirtySet, self.dirtyQueue, self.dirtyHead = {}, {}, 1
    self.characters:Clear()
    self.trailRenderer:Reset()
    self.trailRenderer.grid = world and world.grid or nil
    self.leaderId = nil
    for id = 1, self.chunksWide * self.chunksWide do
        self:MarkChunk(id)
    end
end

function Renderer:MarkChunk(id)
    if self.dirtySet[id] then return end
    self.dirtySet[id] = true
    self.dirtyQueue[#self.dirtyQueue + 1] = id
end

function Renderer:MarkCell(index)
    local n = self.cfg.Grid
    local x = math.floor(((index - 1) % n) / self.cfg.Chunk)
    local y = math.floor(math.floor((index - 1) / n) / self.cfg.Chunk)
    self:MarkChunk(y * self.chunksWide + x + 1)
end

function Renderer:Resize()
    local view = self.viewport.AbsoluteSize
    if view.Y &gt; 1 then
        local touch=game:GetService("UserInputService").TouchEnabled
        local visible=(touch or view.X&lt;650) and (self.cfg.MobileWorldViewHeight or 124)
            or (self.cfg.WorldViewHeightStuds or 112)
        self.pixelScale = view.Y / visible
    end
end

function Renderer:GetPlayerScreenPosition(pos, height)
    local camera = workspace.CurrentCamera
    if camera then
        local projected = camera:WorldToViewportPoint(Vector3.new(
            pos.X, height or self.cfg.CharacterHeight or 3.7, pos.Y))
        return Vector2.new(projected.X, projected.Y)
    end
    return self.viewport.AbsoluteSize * 0.5
end

function Renderer:RebuildChunk(id)
    if not self.world then return end
    local rectangles = ChunkGeometry.Rectangles(self.world.grid, self.cfg, id, self.chunksWide)
    local pool = self.chunkObjects[id]
    if not pool then pool={}; self.chunkObjects[id]=pool end
    local cell=self.cfg.Cell
    for i,rect in ipairs(rectangles) do
        local record=pool[i]
        if not record then
            local base=createLandPart(self.arena.landFolder)
            base.Name="ColorSkirt"
            local top=createLandPart(self.arena.landFolder)
            record={base=base,top=top}
            pool[i]=record
        end
        local owner=self.world.entities[rect.owner]
        local color=owner and owner.color or self.cfg.Colors[1]
        local width=(rect.x2-rect.x1+1)*cell
        local depth=(rect.y2-rect.y1+1)*cell
        local x=-self.half+(rect.x1+rect.x2-1)*.5*cell
        local z=-self.half+(rect.y1+rect.y2-1)*.5*cell
        record.base.Size=Vector3.new(width+.06,.15,depth+.06)
        record.base.Position=Vector3.new(x,.18,z)
        record.base.Color=color:Lerp(Color3.fromRGB(45,50,79),.23)
        record.base.Transparency=0
        record.top.Size=Vector3.new(width+.035,.13,depth+.035)
        record.top.Position=Vector3.new(x,.275,z)
        record.top.Color=color
        record.top.Transparency=0
    end
    for i=#rectangles+1,#pool do
        pool[i].base.Transparency=1
        pool[i].top.Transparency=1
    end
end

function Renderer:RenderChunks()
    local budget = self.cfg.MaxChunksPerFrame or 4
    local built = 0
    while built &lt; budget and self.dirtyHead &lt;= #self.dirtyQueue do
        local id = self.dirtyQueue[self.dirtyHead]
        self.dirtyHead += 1
        self.dirtySet[id] = nil
        if id then
            self:RebuildChunk(id)
            built += 1
        end
    end
    if self.dirtyHead &gt; #self.dirtyQueue then
        self.dirtyQueue, self.dirtyHead = {}, 1
    end
end

function Renderer:SetLeader(id) self.leaderId = id end
function Renderer:ClearTrail(id) self.trailRenderer:Clear(id) end
function Renderer:RemoveEntityVisual(id)
    self.characters:Remove(id)
    self.trailRenderer:Clear(id)
end
function Renderer:ResetEntityVisual(id) self:RemoveEntityVisual(id) end
function Renderer:SetCosmetics(id, cosmetics) self.characters:SetCosmetics(id, cosmetics) end

function Renderer:RenderActor(entity)
    if not entity.alive then
        self:RemoveEntityVisual(entity.id)
        return
    end
    self.characters:Update(entity, self.leaderId == entity.id)
    self.trailRenderer:Render(entity)
end

function Renderer:Render(_, _)
    if not self.world then return end
    -- Terrain first for initial startup; entities remain independent of chunks.
    self:RenderChunks()
    for _, entity in ipairs(self.world.entities) do
        local ok, err = pcall(function() self:RenderActor(entity) end)
        if not ok then
            warn("[Paintland V20] Workspace actor/trail render failure for ID "
                .. tostring(entity.id) .. ": " .. tostring(err))
        end
    end
end

function Renderer:Destroy()
    if self.resizeConnection then self.resizeConnection:Disconnect() end
    self.characters:Destroy()
    self.trailRenderer:Reset()
    if self.arena then self.arena:Destroy() end
    if self.screen then self.screen:Destroy() end
end
return Renderer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleResultsScreen"><Properties><string name="Name">ResultsScreen</string><ProtectedString name="Source">-- End-of-run territory replay. The snapshot is copied before any later match changes.
local Fonts=require(script.Parent.Fonts)
local ButtonEffects=require(script.Parent.ButtonEffects)
local Results={}
Results.__index=Results
local WHITE=Color3.fromRGB(250,253,255)
local INK=Color3.fromRGB(26,38,114)
local CYAN=Color3.fromRGB(0,224,217)
local function make(parent,class,name,props)
    local o=Instance.new(class);o.Name=name
    for k,v in pairs(props) do o[k]=v end
    o.Parent=parent;return o
end
local function frame(parent,name,props)
    props.BorderSizePixel=0;props.Active=false;props.Selectable=false
    return make(parent,"Frame",name,props)
end
local function round(o,r) make(o,"UICorner","Round",{CornerRadius=UDim.new(0,r)}) end
local function outline(o,width,color)
    make(o,"UIStroke","Outline",{Thickness=width,Color=color or INK,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
end
local function text(parent,name,value,size)
    return make(parent,"TextLabel",name,{Text=value,FontFace=Fonts.Bold,TextSize=size,
        TextColor3=WHITE,TextStrokeColor3=INK,TextStrokeTransparency=0,BackgroundTransparency=1,
        BorderSizePixel=0,Active=false,Selectable=false,ZIndex=104})
end
local function button(parent,name,value,color)
    local b=make(parent,"TextButton",name,{Text=value,FontFace=Fonts.Bold,TextSize=21,TextColor3=WHITE,
        TextStrokeColor3=INK,TextStrokeTransparency=0,BackgroundColor3=color,BorderSizePixel=0,
        Active=false,Selectable=true,AutoButtonColor=false,AnchorPoint=Vector2.new(.5,.5),ZIndex=105})
    round(b,18);outline(b,2.5)
    make(b,"UIGradient","Shading",{Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(179,232,149)),Rotation=90})
    return b
end
-- Merge identical horizontal runs vertically. Exact cells; no downsampling.
local function rectangles(size,predicate)
    local finished,open={},{}
    for y=1,size do
        local nextOpen={};local x=1
        while x&lt;=size do
            if predicate((y-1)*size+x) then
                local first=x
                repeat x+=1 until x&gt;size or not predicate((y-1)*size+x)
                local key=tostring(first)..":"..tostring(x)
                local r=open[key]
                if r then r.h+=1;open[key]=nil
                else r={x=first-1,y=y-1,w=x-first,h=1} end
                nextOpen[key]=r
            else x+=1 end
        end
        for _,r in pairs(open) do finished[#finished+1]=r end
        open=nextOpen
    end
    for _,r in pairs(open) do finished[#finished+1]=r end
    return finished
end
function Results.new(screen,cfg,callbacks)
    local self=setmetatable({cfg=cfg,callbacks=callbacks,active=false,elapsed=0,progress=0,ready=false,
        targetPercent=0,ownedCount=0,columns={},snapshot=nil},Results)
    self.root=frame(screen,"TerritoryResults",{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(1,1,1),
        Visible=false,ZIndex=100})
    self.root.Active=true
    make(self.root,"UIGradient","Ocean",{Color=ColorSequence.new(Color3.fromRGB(9,87,225),Color3.fromRGB(0,191,227)),Rotation=90})
    self.content=frame(self.root,"Content",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),
        BackgroundTransparency=1,ZIndex=101})
    self.title=text(self.content,"Title","Look at your mark!",31)
    self.caption=text(self.content,"Caption","YOUR TERRITORY",12)
    self.caption.FontFace=Fonts.Regular;self.caption.TextStrokeTransparency=.6
    self.track=frame(self.content,"CoverageTrack",{BackgroundColor3=Color3.fromRGB(32,35,174),ZIndex=102,ClipsDescendants=true})
    round(self.track,14);outline(self.track,2)
    self.fill=frame(self.track,"CapturedFill",{Size=UDim2.fromScale(0,1),BackgroundColor3=CYAN,ZIndex=103})
    round(self.fill,12)
    self.percentLabel=text(self.track,"Percent","0.0%",22)
    self.percentLabel.Position=UDim2.fromOffset(12,0);self.percentLabel.Size=UDim2.new(1,-24,1,0)
    self.percentLabel.TextXAlignment=Enum.TextXAlignment.Left
    self.stage=frame(self.content,"MapStage",{BackgroundColor3=Color3.fromRGB(0,155,207),BackgroundTransparency=.2,ZIndex=102})
    round(self.stage,28);outline(self.stage,1,Color3.fromRGB(104,239,248))
    self.map=frame(self.stage,"ArenaMap",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),
        BackgroundTransparency=1,ZIndex=103})
    self.neutral=frame(self.map,"PlayableShape",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=103})
    self.reveal=frame(self.map,"CaptureReveal",{Size=UDim2.fromScale(0,1),BackgroundTransparency=1,ClipsDescendants=true,ZIndex=104})
    self.paint=frame(self.reveal,"CapturedShape",{BackgroundTransparency=1,ZIndex=104})
    self.details=text(self.content,"Details","",14)
    self.details.FontFace=Fonts.Regular;self.details.TextStrokeTransparency=.5;self.details.TextWrapped=true
    self.status=text(self.content,"Status","Counting your color…",12)
    self.status.FontFace=Fonts.Regular;self.status.TextStrokeTransparency=.6
    self.play=button(self.content,"PlayAgain","PLAY AGAIN",Color3.fromRGB(151,244,59))
    self.menuButton=button(self.content,"MainMenu","MAIN MENU",Color3.fromRGB(48,140,234))
    self:Resize(Vector2.new(1280,720))
    ButtonEffects.Bind(self.play,cfg,{play=true});ButtonEffects.Bind(self.menuButton,cfg)
    local function choose(callback)
        if not self.active or not self.ready then return end
        self.ready=false;self.play.Active=false;self.menuButton.Active=false
        if callback then callback() end
    end
    self.play.Activated:Connect(function() choose(callbacks.onPlay) end)
    self.menuButton.Activated:Connect(function() choose(callbacks.onMainMenu) end)
    return self
end
function Results:Resize(viewport)
    if viewport.X&lt;1 or viewport.Y&lt;1 then return end
    local width=math.min(900,viewport.X-24)
    local height=math.min(690,viewport.Y-24)
    local wide=viewport.X&gt;=568 and viewport.X/viewport.Y&gt;1.4
    self.content.Size=UDim2.fromOffset(width,height)
    if wide then
        local left=math.min(math.floor(width*.48),height-12)
        self.stage.Position=UDim2.fromOffset(0,(height-left)/2);self.stage.Size=UDim2.fromOffset(left,left)
        local x=left+22;local w=width-x
        self.title.Position=UDim2.fromOffset(x,12);self.title.Size=UDim2.fromOffset(w,48)
        self.title.TextSize=viewport.X&lt;720 and 22 or 31
        self.caption.Position=UDim2.fromOffset(x,64);self.caption.Size=UDim2.fromOffset(w,20)
        self.track.Position=UDim2.fromOffset(x,90);self.track.Size=UDim2.fromOffset(w,38)
        self.details.Position=UDim2.fromOffset(x,137);self.details.Size=UDim2.fromOffset(w,34)
        self.status.Position=UDim2.fromOffset(x,173);self.status.Size=UDim2.fromOffset(w,18)
        self.play.Position=UDim2.fromOffset(x+w/2,math.min(height-76,222))
        self.menuButton.Position=UDim2.fromOffset(x+w/2,math.min(height-24,278))
        ButtonEffects.SetSize(self.play,UDim2.fromOffset(w,46));ButtonEffects.SetSize(self.menuButton,UDim2.fromOffset(w,44))
    else
        self.title.Position=UDim2.fromOffset(0,0);self.title.Size=UDim2.fromOffset(width,48)
        self.title.TextSize=width&lt;340 and 26 or 31
        self.caption.Position=UDim2.fromOffset(0,51);self.caption.Size=UDim2.fromOffset(width,20)
        self.track.Position=UDim2.fromOffset(8,80);self.track.Size=UDim2.fromOffset(width-16,38)
        local mapSize=math.min(width-12,height-298)
        self.stage.Position=UDim2.fromOffset((width-mapSize)/2,133);self.stage.Size=UDim2.fromOffset(mapSize,mapSize)
        self.details.Position=UDim2.fromOffset(0,142+mapSize);self.details.Size=UDim2.fromOffset(width,28)
        self.status.Position=UDim2.fromOffset(0,172+mapSize);self.status.Size=UDim2.fromOffset(width,20)
        self.play.Position=UDim2.fromOffset(width/2,height-82);self.menuButton.Position=UDim2.fromOffset(width/2,height-26)
        ButtonEffects.SetSize(self.play,UDim2.fromOffset(width-16,52));ButtonEffects.SetSize(self.menuButton,UDim2.fromOffset(width-16,44))
    end
    self.mapPixels=math.max(1,self.stage.Size.X.Offset-28)
    self.map.Size=UDim2.fromOffset(self.mapPixels,self.mapPixels)
    -- Fixed inner dimensions prevent the artwork stretching with the reveal window.
    self.paint.Size=UDim2.fromOffset(self.mapPixels,self.mapPixels)
    self:PaintProgress(self.progress)
end
function Results:PaintProgress(progress)
    self.progress=math.clamp(progress,0,1)
    self.percentLabel.Text=string.format("%.1f%%",self.targetPercent*self.progress)
    self.fill.Size=UDim2.fromScale(self.targetPercent/100*self.progress,1)
    local edge=0
    local target=self.ownedCount*self.progress
    if self.progress&gt;=1 then edge=1
    elseif target&gt;0 then
        local before=0
        for x,n in ipairs(self.columns) do
            if n&gt;0 and before+n&gt;=target then edge=((x-1)+(target-before)/n)/#self.columns;break end
            before+=n
        end
    end
    self.reveal.Size=UDim2.fromScale(edge,1)
end
function Results:Show(snapshot)
    self:Hide()
    local size=math.max(1,math.floor(snapshot.size or self.cfg.Grid or 112))
    local mask,cells={},{}
    for i=1,size*size do
        mask[i]=snapshot.mask and snapshot.mask[i]==true or false
        cells[i]=mask[i] and snapshot.cells and snapshot.cells[i]==true or false
    end
    self.snapshot={size=size,mask=mask,cells=cells,count=snapshot.count or 0,kills=snapshot.kills or 0,
        percent=math.clamp(snapshot.percent or 0,0,100),color=snapshot.color or CYAN}
    self.targetPercent=self.snapshot.percent;self.ownedCount=0;self.columns=table.create(size,0)
    for i,owned in ipairs(cells) do if owned then
        self.ownedCount+=1;local x=(i-1)%size+1;self.columns[x]+=1
    end end
    self.neutral:ClearAllChildren();self.paint:ClearAllChildren()
    for _,set in ipairs({{parent=self.neutral,predicate=function(i) return mask[i] end,color=WHITE},
        {parent=self.paint,predicate=function(i) return cells[i] end,color=self.snapshot.color}}) do
        for _,r in ipairs(rectangles(size,set.predicate)) do
            frame(set.parent,"MapRun",{Position=UDim2.fromScale(r.x/size,r.y/size),Size=UDim2.fromScale(r.w/size,r.h/size),
                BackgroundColor3=set.color,ZIndex=104})
        end
    end
    self.fill.BackgroundColor3=self.snapshot.color
    self.details.Text=string.format("%d tiles  ·  %d eliminations",self.snapshot.count,self.snapshot.kills)
    self.status.Text="Counting your color…"
    self.elapsed=0;self.ready=false;self.active=true;self.root.Visible=true
    self.play.Active=false;self.menuButton.Active=false
    self:PaintProgress(0)
    self:Update(0)
end
function Results:Update(dt)
    if not self.active or self.ready then return end
    self.elapsed+=math.max(0,dt)
    local duration=math.max(.1,self.cfg.ResultsRevealSeconds or 2)
    local t=self.cfg.ReducedMotion and 1 or math.min(1,self.elapsed/duration)
    self:PaintProgress(1-(1-t)^3)
    if t&gt;=1 then
        self.ready=true;self.play.Active=true;self.menuButton.Active=true
        self.status.Text="Every little loop counts."
    end
end
function Results:Hide()
    self.active=false;self.ready=false;self.root.Visible=false
    self.play.Active=false;self.menuButton.Active=false
end
function Results:Destroy()
    self:Hide();self.root:Destroy()
end
return Results
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleReviveController"><Properties><string name="Name">ReviveController</string><ProtectedString name="Source">-- V41: blue arcade revive overlay, fixed draining heart and responsive actions.
-- No purchases or persistent reads/writes are triggered in Roblox Studio.
local Fonts=require(script.Parent.Fonts)
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local AdService = game:GetService("AdService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ButtonEffects = require(script.Parent.ButtonEffects)
local ReviveHeart = require(script.Parent.ReviveHeart)
local Revive = {}
Revive.__index = Revive
local STUDIO = RunService:IsStudio()

local function make(parent, className, name, properties)
    local item = Instance.new(className)
    item.Name = name
    for key, value in pairs(properties) do item[key] = value end
    item.Parent = parent
    return item
end

local function round(parent, size)
    make(parent, "UICorner", "Corner", {CornerRadius = UDim.new(0, size)})
end

local function label(parent, name, text, y, height, fontSize, textColor)
    return make(parent, "TextLabel", name, {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -28, 0, height),
        Position = UDim2.fromOffset(14, y),
        Text = text, TextSize = fontSize,
        TextColor3 = textColor, FontFace = Fonts.Bold,
        TextWrapped = true, ZIndex = 102,
    })
end

local function button(parent, name, text, y, color)
    local item = make(parent, "TextButton", name, {
        Size = UDim2.new(1, -36, 0, 44),
        Position = UDim2.fromOffset(18, y),
        Text = text, TextSize = 15, FontFace = Fonts.Bold,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextStrokeColor3=Color3.fromRGB(20,35,119),TextStrokeTransparency=0,
        AnchorPoint=Vector2.new(.5,.5),
        BackgroundColor3 = color, BackgroundTransparency = 0,
        BorderSizePixel = 0, ZIndex = 103, AutoButtonColor = true,
    })
    round(item, 14)
    make(item,"UIStroke","ButtonOutline",{Color=Color3.fromRGB(20,35,119),Thickness=2,ApplyStrokeMode=Enum.ApplyStrokeMode.Border})
    return item
end

function Revive.new(screen, cfg, callbacks)
    local self = setmetatable({}, Revive)
    self.cfg, self.callbacks = cfg, callbacks
    self.active, self.state, self.action = false, "closed", nil
    self.serverMode=false;self.destroyed=false
    self.remaining = cfg.ReviveWindowSeconds
    self.adsUsed, self.credits = 0, 0
    self.available, self.checkingAd = false, false
    self.purchasedProductId = 0
    self.runSerial, self.requestSerial, self.waitTime = 0, 0, 0
    self.isStudio = STUDIO
    self.network = nil

    local root=make(screen,"Frame","ReviveOverlay",{Size=UDim2.fromScale(1,1),
        BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=.04,BorderSizePixel=0,
        Active=true,Visible=false,ZIndex=100})
    self.root=root
    make(root,"UIGradient","BlueAtmosphere",{Rotation=65,Color=ColorSequence.new(
        Color3.fromRGB(8,82,227),Color3.fromRGB(0,201,232))})
    local card=make(root,"Frame","ReviveContent",{AnchorPoint=Vector2.new(.5,.5),
        Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(760,500),
        BackgroundTransparency=1,BorderSizePixel=0,ZIndex=101})
    self.card=card
    self.hero=make(card,"Frame","HeartHero",{BackgroundTransparency=1,BorderSizePixel=0,ZIndex=102})
    self.actions=make(card,"Frame","ReviveActions",{BackgroundTransparency=1,BorderSizePixel=0,ZIndex=102})
    self.heading=label(self.hero,"Heading","Game over!",0,58,39,Color3.new(1,1,1))
    self.heading.TextStrokeColor3=Color3.fromRGB(20,35,119);self.heading.TextStrokeTransparency=0
    self.heading.TextScaled=true
    make(self.heading,"UITextSizeConstraint","TitleLimit",{MinTextSize=22,MaxTextSize=48})
    self.description=label(self.hero,"Description","Your color deserves another chance.",58,32,13,Color3.new(1,1,1))
    self.description.FontFace=Fonts.Regular
    self.heart=ReviveHeart.new(self.hero,cfg,callbacks.isMuted)
    self.countdown=self.heart.countdown
    self.adButton=button(self.actions,"WatchAd","REVIVE",0,Color3.fromRGB(128,244,44))
    self.buyButton=button(self.actions,"BuyRevive","REVIVE WITH ROBUX",0,Color3.fromRGB(38,168,250))
    self.creditButton=button(self.actions,"CreditRevive","USE REVIVE CREDIT",0,Color3.fromRGB(115,88,238))
    self.studioButton=button(self.actions,"StudioTestRevive","TEST REVIVE",0,Color3.fromRGB(255,188,57))
    self.studioButton.Visible=STUDIO
    self.endButton=button(self.actions,"EndRun","No, thanks",0,Color3.fromRGB(31,101,219))
    self.endButton.BackgroundTransparency=1
    self.endButton.Activated:Connect(function() self:EndRun() end)
    self.status=label(self.actions,"Status","",0,40,11,Color3.fromRGB(222,250,255))
    self.status.FontFace=Fonts.Regular
    self.resize=root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        self:Resize(root.AbsoluteSize)
    end)
    self.adButton.Activated:Connect(function() self:RequestAd() end)
    self.buyButton.Activated:Connect(function() self:RequestPurchase() end)
    self.creditButton.Activated:Connect(function() self:UseCredit() end)
    self.studioButton.Activated:Connect(function()
        if STUDIO and self.active and self.state == "countdown" then
            self:CompleteRevive()
        end
    end)

    self.purchaseConnection = MarketplaceService.PromptProductPurchaseFinished:Connect(
        function(userId, productId, purchased)
            if userId ~= Players.LocalPlayer.UserId or productId ~= self.purchasedProductId then return end
            if not self.active or self.action ~= "purchase" then return end
            if purchased then
                self.state = "waiting"
                self.waitTime = 0
                self.status.Text = "Verifying Roblox receipt..."
            else
                self:RestoreCountdown("Purchase cancelled")
            end
        end
    )

    for _,b in ipairs({self.adButton,self.buyButton,self.creditButton,self.studioButton,self.endButton}) do
        ButtonEffects.Bind(b,cfg)
    end
    self:RefreshButtons()
    self:Resize(root.AbsoluteSize or Vector2.new(1280,720))
    task.defer(function() if root.Parent then self:Resize(root.AbsoluteSize) end end)
    -- Do not block game startup waiting for the server Script to initialize.
    task.spawn(function()
        local folder = ReplicatedStorage:WaitForChild("PaintlandRevive", 12)
        if not folder or not root.Parent then
            self.networkResolved=true
            return
        end
        self.network = folder
        self.updated = folder:WaitForChild("Updated", 10)
        self.beginRun = folder:WaitForChild("BeginRun", 10)
        self.consume = folder:WaitForChild("ConsumeCredit", 10)
        self.requestAd = folder:WaitForChild("RequestAd", 10)
        if self.destroyed or not root.Parent then return end
        self.purchasedProductId = tonumber(folder:GetAttribute("ProductId")) or 0
        if self.updated then
            self.updateConnection = self.updated.OnClientEvent:Connect(function(message)
                self:OnServerMessage(message)
            end)
        end
        -- Synchronize again if the match started before the remote appeared.
        self:SyncRun(self.runSerial)
        self:RefreshButtons()
    end)
    return self
end

-- Only the hero changes size; action hit targets remain at least 44 pixels.
function Revive:Resize(viewport)
    if not viewport or viewport.X&lt;1 or viewport.Y&lt;1 then return end
    local wide=viewport.X&gt;=560 and viewport.X/viewport.Y&gt;1.35
    local width=math.min(wide and 840 or 420,viewport.X-24)
    local height=math.min(wide and 470 or 600,viewport.Y-32)
    self.card.Size=UDim2.fromOffset(width,height)
    local count=self.serverMode and 2 or (STUDIO and 5 or 4)
    local actionHeight=count*48+40
    local actionWidth=wide and math.min(360,width*.53) or width
    local heroWidth=wide and width-actionWidth-20 or width
    local heroHeight=wide and height or height-actionHeight-10
    self.hero.Size=UDim2.fromOffset(heroWidth,heroHeight)
    self.hero.Position=UDim2.fromOffset(0,0)
    self.actions.Size=UDim2.fromOffset(actionWidth,actionHeight)
    self.actions.Position=UDim2.fromOffset(wide and width-actionWidth or 0,wide and (height-actionHeight)/2 or height-actionHeight)
    self.heading.Position=UDim2.fromOffset(0,0);self.heading.Size=UDim2.new(1,0,0,50)
    self.description.Position=UDim2.fromOffset(0,50);self.description.Size=UDim2.new(1,0,0,32)
    self.description.Visible=heroHeight&gt;=220
    local top=self.description.Visible and 86 or 55
    local heartSize=math.max(80,math.min(240,heroWidth-36,heroHeight-top-8))
    self.heart.root.Size=UDim2.fromOffset(heartSize,heartSize)
    self.heart.root.Position=UDim2.new(.5,0,0,top+(heroHeight-top)/2)
    local buttons={self.adButton}
    if not self.serverMode then
        table.insert(buttons,self.buyButton);table.insert(buttons,self.creditButton)
        if STUDIO then table.insert(buttons,self.studioButton) end
    end
    table.insert(buttons,self.endButton)
    for i,b in ipairs(buttons) do
        b.Position=UDim2.new(.5,0,0,(i-1)*48+22)
        ButtonEffects.SetSize(b,UDim2.new(1,-12,0,44))
    end
    self.status.Position=UDim2.fromOffset(6,count*48);self.status.Size=UDim2.new(1,-12,0,40)
end

function Revive:RefreshButtons()
    if self.serverMode then
        local ready=self.active and self.state=="countdown" and self.remaining&gt;0
        self.adButton.Visible=true;self.buyButton.Visible=false
        self.creditButton.Visible=false;self.studioButton.Visible=false
        self.adButton.Active=ready and (self.revivesLeft or 0)&gt;0
        self.adButton.AutoButtonColor=false
        self.adButton.BackgroundTransparency=self.adButton.Active and 0 or .48
        self.adButton.Text=self.adButton.Active and "REVIVE" or ((self.revivesLeft or 0)&gt;0 and "REVIVING…" or "NO REVIVES LEFT")
        self.endButton.Active=ready;self.endButton.AutoButtonColor=false
        self.endButton.BackgroundTransparency=1;self.endButton.TextTransparency=ready and 0 or .48
        return
    end
    -- Never hide the actual options. Explain why unavailable instead.
    self.adButton.Visible = true
    self.buyButton.Visible = true
    self.creditButton.Visible = true
    self.studioButton.Visible = STUDIO

    local waiting = self.state ~= "countdown"
    self.endButton.Active=self.active and not waiting
    self.endButton.AutoButtonColor=false
    self.endButton.BackgroundTransparency=1
    self.endButton.TextTransparency=self.endButton.Active and 0 or .48
    local adReady = not STUDIO and self.available and self.requestAd ~= nil
        and self.purchasedProductId &gt; 0
        and self.adsUsed &lt; self.cfg.ReviveMaxAdsPerRun
    local buyReady = not STUDIO and self.purchasedProductId &gt; 0
    local creditReady = self.consume ~= nil and self.credits &gt; 0 and not STUDIO

    if STUDIO then
        self.adButton.Text = "AD REVIVE UNAVAILABLE"
        self.buyButton.Text = "ROBUX REVIVE UNAVAILABLE"
    elseif self.purchasedProductId &lt;= 0 then
        self.adButton.Text = "AD REVIVE UNAVAILABLE"
        self.buyButton.Text = "ROBUX REVIVE UNAVAILABLE"
    elseif self.adsUsed &gt;= self.cfg.ReviveMaxAdsPerRun then
        self.adButton.Text = "AD REVIVES USED"
    elseif self.checkingAd then
        self.adButton.Text = "CHECKING AD AVAILABILITY..."
    elseif self.available then
        self.adButton.Text = string.format("WATCH AD (%d LEFT)",
            self.cfg.ReviveMaxAdsPerRun - self.adsUsed)
    else
        self.adButton.Text = "AD NOT AVAILABLE"
    end
    if not STUDIO and buyReady then self.buyButton.Text = "REVIVE WITH ROBUX" end
    self.creditButton.Text = string.format("USE REVIVE CREDIT (%d)", self.credits)

    self.adButton.Active = self.active and not waiting and adReady
    self.buyButton.Active = self.active and not waiting and buyReady
    self.creditButton.Active = self.active and not waiting and creditReady
    self.adButton.AutoButtonColor = false
    self.buyButton.AutoButtonColor = false
    self.creditButton.AutoButtonColor = false
    self.adButton.BackgroundTransparency = self.adButton.Active and 0 or 0.48
    self.buyButton.BackgroundTransparency = self.buyButton.Active and 0 or 0.48
    self.creditButton.BackgroundTransparency = self.creditButton.Active and 0 or 0.48
    self.studioButton.Active = self.active and self.state == "countdown"
end

function Revive:SyncRun(serial)
    if not self.beginRun or serial ~= self.runSerial then return end
    self.networkResolved=false -- credit availability is unknown until the server replies
    task.spawn(function()
        local ok, result = pcall(function() return self.beginRun:InvokeServer() end)
        if not self.destroyed and ok and type(result) == "table" and serial == self.runSerial then
            self.networkResolved=true
            self.adsUsed = tonumber(result.adsUsed) or 0
            self.credits = tonumber(result.credits) or 0
            self.purchasedProductId = tonumber(result.productId) or self.purchasedProductId
            self:RefreshButtons()
        end
    end)
end

function Revive:NewRun()
    self.runSerial += 1
    self.requestSerial += 1
    self.active = false
    self.serverMode=false;self.serverRevive=nil;self.serverDecline=nil
    self.root.Visible = false
    if self.heart then self.heart:Stop() end
    self.state = "closed"
    self.action = nil
    self.adsUsed = 0
    self.available, self.checkingAd = false, false
    self:SyncRun(self.runSerial)
    self:RefreshButtons()
end

-- Hide revive prompts without granting credits or resetting the run.
function Revive:Close()
    self.active = false
    self.serverMode=false;self.serverRevive=nil;self.serverDecline=nil
    self.state = "closed"
    self.action = nil
    self.requestSerial += 1
    self.root.Visible = false
    if self.heart then self.heart:Stop() end
end

function Revive:Open()
    if self.destroyed then return end
    self.serverMode=false;self.serverRevive=nil;self.serverDecline=nil
    self.active = true
    self.state = "countdown"
    self.remaining = self.cfg.ReviveWindowSeconds or 4
    self.action, self.waitTime = nil, 0
    self.root.Visible = true
    if self.heart then self.heart:Reset(self.remaining);self.heart:Update(0,self.remaining,self.remaining,false) end
    self.status.Text = STUDIO and "Studio test: no player data loads or saves" or
        "Choose an option before the timer ends"
    self.available = false
    self.checkingAd = not STUDIO and self.purchasedProductId &gt; 0
        and self.adsUsed &lt; self.cfg.ReviveMaxAdsPerRun
    self.requestSerial += 1
    local serial = self.requestSerial
    self:RefreshButtons()
    self:Resize(self.root.AbsoluteSize)

    if not self.checkingAd then return end
    task.spawn(function()
        local ok, result = pcall(function()
            return AdService:GetAdAvailabilityNowAsync(Enum.AdFormat.RewardedVideo)
        end)
        if not self.active or serial ~= self.requestSerial then return end
        self.checkingAd = false
        self.available = ok and type(result) == "table"
            and result.AdAvailabilityResult == Enum.AdAvailabilityResult.IsAvailable
        self:RefreshButtons()
    end)
end

-- Multiplayer results and revives are authoritative server messages. The local
-- heart is a presentation timer; requests never grant a revive on this client.
function Revive:OpenServer(remaining,revivesLeft,onRevive,onDecline)
    if self.destroyed then return end
    self:Close()
    self.serverMode=true;self.active=true;self.root.Visible=true
    self.remaining=math.max(0,tonumber(remaining) or 4)
    self.serverTotal=math.max(self.cfg.ReviveWindowSeconds or 4,self.remaining,.001)
    self.revivesLeft=math.max(0,math.floor(tonumber(revivesLeft) or 0))
    self.serverRevive=onRevive;self.serverDecline=onDecline
    self.state=self.remaining&gt;0 and "countdown" or "waiting"
    self.action=nil;self.waitTime=0
    self.status.Text=self.revivesLeft&gt;0 and "Keep your land. Get back in the arena." or "Your run is complete."
    self.heart:Reset(self.serverTotal)
    self.heart:Update(0,self.remaining,self.serverTotal,self.state~="countdown")
    self:RefreshButtons();self:Resize(self.root.AbsoluteSize)
end
function Revive:RequestServerRevive()
    if not self.serverMode or not self.active or self.state~="countdown"
        or self.remaining&lt;=0 or (self.revivesLeft or 0)&lt;=0 then return end
    local callback=self.serverRevive
    self.state="waiting";self.action="serverRevive";self.waitTime=0
    self.status.Text="Returning to the arena…"
    if self.heart then self.heart:Update(0,self.remaining,self.serverTotal,true) end
    self:RefreshButtons()
    if callback then callback() end
end
function Revive:ServerRejected(message)
    if not self.serverMode or not self.active then return end
    -- A rejected revive does not invent additional countdown time. Request the
    -- final result when the original local deadline has already passed.
    self.state="countdown";self.action=nil;self.status.Text=message or "Revive unavailable"
    self:RefreshButtons()
    if self.remaining&lt;=0 then self:EndRun() end
end

function Revive:RestoreCountdown(message)
    if not self.active then return end
    self.state = "countdown"
    self.action = nil
    self.status.Text = message or "Choose a revive option"
    self:RefreshButtons()
end

function Revive:RequestAd()
    if self.serverMode then self:RequestServerRevive();return end
    if not self.adButton.Active then return end
    self.state, self.action, self.waitTime = "waiting", "ad", 0
    if self.heart then self.heart:Update(0,self.remaining,self.cfg.ReviveWindowSeconds,true) end
    self.status.Text = "Opening rewarded video..."
    self:RefreshButtons()
    self.requestAd:FireServer()
end

function Revive:RequestPurchase()
    if self.serverMode then return end
    if not self.buyButton.Active then return end
    self.state, self.action, self.waitTime = "waiting", "purchase", 0
    if self.heart then self.heart:Update(0,self.remaining,self.cfg.ReviveWindowSeconds,true) end
    self.status.Text = "Opening purchase prompt..."
    self:RefreshButtons()
    local ok = pcall(function()
        MarketplaceService:PromptProductPurchase(Players.LocalPlayer, self.purchasedProductId)
    end)
    if not ok then self:RestoreCountdown("Robux prompt failed to open") end
end

function Revive:CompleteRevive()
    if not self.active or self.serverMode then return end
    self.active, self.state, self.action = false, "closed", nil
    self.requestSerial += 1
    self.root.Visible = false
    if self.heart then self.heart:Stop() end
    self.callbacks.onRevive()
end

function Revive:UseCredit()
    if self.serverMode then return end
    if not self.creditButton.Active then return end
    self.state, self.action, self.waitTime = "consuming", "credit", 0
    if self.heart then self.heart:Update(0,self.remaining,self.cfg.ReviveWindowSeconds,true) end
    self.status.Text = "Confirming credit..."
    self:RefreshButtons()
    local serial=self.requestSerial
    task.spawn(function()
        local ok, result = pcall(function() return self.consume:InvokeServer() end)
        if self.destroyed or not self.active or self.serverMode or serial~=self.requestSerial or self.action~="credit" then return end
        if ok and type(result) == "table" and result.success then
            self.credits = result.credits or 0
            self:CompleteRevive()
        else
            self:RestoreCountdown("Revive credit couldn't be confirmed")
        end
    end)
end

function Revive:OnServerMessage(message)
    if self.destroyed or self.serverMode or type(message) ~= "table" then return end
    if message.credits ~= nil then self.credits = message.credits end
    if message.adsUsed ~= nil then self.adsUsed = message.adsUsed end
    if message.kind == "Credit" and self.active then
        if self.action == "ad" or self.action == "purchase" then
            self.state = "countdown"
            self.action = nil
            self:RefreshButtons()
            self:UseCredit()
            return
        end
    elseif message.kind == "AdResult" and self.active and self.action == "ad" then
        if not message.completed then
            self.available = false
            self:RestoreCountdown("Ad unavailable or not completed")
        else
            self.status.Text = "Ad completed; waiting for receipt..."
        end
    end
    self:RefreshButtons()
end

function Revive:HasReviveOption()
    if self.serverMode then return (self.revivesLeft or 0)&gt;0 end
    return STUDIO or self.checkingAd or self.adButton.Active
        or self.buyButton.Active or self.creditButton.Active
end

-- Do not abandon a pending purchase/ad/credit confirmation through this button.
function Revive:EndRun()
    if not self.active or self.state~="countdown" then return end
    if self.serverMode then
        local callback=self.serverDecline
        self.state="waiting";self.action="serverDecline";self.waitTime=0
        self.status.Text="Loading your results…"
        if self.heart then self.heart:Update(0,self.remaining,self.serverTotal,true) end
        self:RefreshButtons()
        if callback then callback() end
        return
    end
    self:Close()
    self.callbacks.onTimeout()
end

function Revive:Update(dt)
    if not self.active then return end
    dt=math.max(0,dt)
    if self.serverMode then
        if self.state=="countdown" then
            self.remaining=math.max(0,self.remaining-dt)
            if self.heart then self.heart:Update(dt,self.remaining,self.serverTotal,false) end
            if self.remaining&lt;=0 then self:EndRun() end
        else
            -- Keep the deadline moving even though the visual is paused awaiting
            -- acknowledgement. A failed request cannot extend the revive window.
            self.remaining=math.max(0,self.remaining-dt);self.waitTime+=dt
            if self.heart then self.heart:Update(dt,self.heart.remaining,self.serverTotal,true) end
            if self.waitTime&gt;8 then self.status.Text="Waiting for the server…" end
        end
        return
    end
    if self.state == "countdown" then
        -- Only skip the prompt once capability discovery has actually finished.
        if self.networkResolved and not self:HasReviveOption() then
            self:EndRun()
            return
        end
        self.remaining = math.max(0, self.remaining - dt)
        self.countdown.Text = tostring(math.ceil(self.remaining))
        if self.heart then self.heart:Update(dt,self.remaining,self.cfg.ReviveWindowSeconds,false) end
        if self.remaining &lt;= 0 then
            self:EndRun()
        end
    elseif self.state == "waiting" or self.state == "consuming" then
        self.countdown.Text = "···"
        if self.heart then self.heart:Update(dt,self.remaining,self.cfg.ReviveWindowSeconds,true) end
        self.waitTime += dt
        if self.waitTime &gt; self.cfg.ReviveTransactionTimeout then
            self:RestoreCountdown("Verification timed out. Late credits remain saved.")
        end
    end
end

function Revive:Destroy()
    if self.destroyed then return end
    self.destroyed=true;self:Close()
    if self.resize then self.resize:Disconnect() end
    if self.updateConnection then self.updateConnection:Disconnect() end
    if self.purchaseConnection then self.purchaseConnection:Disconnect() end
    if self.heart then self.heart:Destroy() end
    self.root:Destroy()
end

return Revive
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleReviveHeart"><Properties><string name="Name">ReviveHeart</string><ProtectedString name="Source">-- Fixed heart silhouette with a draining fill. Only the separate contour pulses.
local Fonts=require(script.Parent.Fonts)
local Heart={}
Heart.__index=Heart
local ROWS=72
local function make(parent,class,name,props)
    local o=Instance.new(class);o.Name=name
    for k,v in pairs(props) do o[k]=v end
    o.Parent=parent;return o
end
local function frame(parent,name,props)
    props.BorderSizePixel=0;props.Active=false;props.Selectable=false
    return make(parent,"Frame",name,props)
end
local function silhouette()
    local polygon={}
    for i=0,240 do
        local t=i/240*math.pi*2
        local x=16*math.sin(t)^3
        local y=13*math.cos(t)-5*math.cos(2*t)-2*math.cos(3*t)-math.cos(4*t)
        polygon[#polygon+1]={x=(x+16)/32,y=(12-y)/29}
    end
    local rows={}
    for row=1,ROWS do
        local scan=(row-.5)/ROWS
        local crossings={}
        for i=1,#polygon-1 do
            local a,b=polygon[i],polygon[i+1]
            if (a.y&lt;=scan and b.y&gt;scan) or (b.y&lt;=scan and a.y&gt;scan) then
                crossings[#crossings+1]=a.x+(b.x-a.x)*(scan-a.y)/(b.y-a.y)
            end
        end
        table.sort(crossings)
        -- Top scanlines cross two lobes. Keep the central notch empty rather
        -- than bridging the minimum/maximum intersections into a flat top.
        for i=1,#crossings-1,2 do
            local low,high=crossings[i],crossings[i+1]
            if high&gt;low then rows[#rows+1]={y=(row-1)/ROWS,x=low,w=high-low,h=1/ROWS+.001} end
        end
    end
    return rows
end
local SHAPE=silhouette()
local function draw(parent,color,outline)
    local parts={}
    for _,r in ipairs(SHAPE) do
        if outline then
            for _,x in ipairs({r.x,r.x+r.w-.012}) do
                parts[#parts+1]=frame(parent,"PulseEdge",{Position=UDim2.fromScale(x,r.y),Size=UDim2.fromScale(.012,r.h),
                    BackgroundColor3=color,ZIndex=104})
            end
        else
            parts[#parts+1]=frame(parent,"HeartRow",{Position=UDim2.fromScale(r.x,r.y),Size=UDim2.fromScale(r.w,r.h),
                BackgroundColor3=color,ZIndex=105})
        end
    end
    return parts
end
function Heart.new(parent,cfg,isMuted)
    local self=setmetatable({cfg=cfg,isMuted=isMuted,remaining=4,total=4,lastSecond=nil,pulseAge=1,beepCount=0},Heart)
    self.root=frame(parent,"Heart",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),
        Size=UDim2.fromOffset(210,200),BackgroundTransparency=1,ZIndex=104})
    self.pulse=frame(self.root,"PulseOutline",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),
        Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=104})
    self.pulseParts=draw(self.pulse,Color3.fromRGB(166,247,255),true)
    self.body=frame(self.root,"FixedHeart",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=105})
    draw(self.body,Color3.fromRGB(20,35,119),false)
    local inside=frame(self.body,"Inside",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),
        Size=UDim2.fromScale(.94,.94),BackgroundTransparency=1,ZIndex=106})
    draw(inside,Color3.fromRGB(17,91,153),false)
    self.fill=frame(inside,"Liquid",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=107})
    self.fillParts=draw(self.fill,Color3.fromRGB(255,62,89),false)
    local shine=frame(self.body,"Highlight",{Position=UDim2.fromScale(.14,.12),Size=UDim2.fromScale(.12,.1),
        BackgroundColor3=Color3.fromRGB(195,247,255),BackgroundTransparency=.55,ZIndex=108})
    make(shine,"UICorner","Round",{CornerRadius=UDim.new(1,0)})
    self.countdown=make(self.body,"TextLabel","Seconds",{BackgroundTransparency=1,Size=UDim2.fromScale(1,.65),
        Position=UDim2.fromScale(0,.21),Text="4",FontFace=Fonts.Bold,TextColor3=Color3.new(1,1,1),TextScaled=true,
        TextStrokeColor3=Color3.fromRGB(20,35,119),TextStrokeTransparency=0,Active=false,Selectable=false,ZIndex=109})
    make(self.countdown,"UITextSizeConstraint","TextSize",{MinTextSize=18,MaxTextSize=88})
    local id=cfg.ReviveCountdownSoundId
    if id==nil then id="rbxasset://sounds/electronicpingshort.wav" end
    id=tostring(id);if id:match("^%d+$") then id="rbxassetid://"..id end
    self.sound=make(self.root,"Sound","ReviveCountdownBeep",{SoundId=id,Volume=math.clamp(cfg.ReviveCountdownVolume or .35,0,1),Looped=false})
    self:Reset(4)
    return self
end
function Heart:Tick(second)
    if second&lt;=0 then return end
    self.pulseAge=0
    if self.cfg.SoundEnabled==false or (self.isMuted and self.isMuted()) or self.sound.SoundId=="" then return end
    self.sound:Stop();self.sound.TimePosition=0;self.sound:Play();self.beepCount+=1
end
function Heart:Paint(remaining,total)
    local fraction=math.clamp(remaining/math.max(.001,total),0,1)
    local waterline=1-fraction
    for i,r in ipairs(SHAPE) do
        local y=math.max(r.y,waterline)
        local height=fraction&gt;0 and math.max(0,math.min(1,r.y+r.h)-y) or 0
        local part=self.fillParts[i]
        part.Visible=height&gt;0
        part.Position=UDim2.fromScale(r.x,y);part.Size=UDim2.fromScale(r.w,height)
    end
    self.fraction=fraction
end
function Heart:Reset(total)
    self.total=math.max(.001,total or 4);self.remaining=self.total
    self.lastSecond=nil;self.pulseAge=1
    self.countdown.Text=tostring(math.ceil(self.total));self:Paint(self.total,self.total)
    self:Stop()
end
function Heart:Update(dt,remaining,total,waiting)
    self.remaining=math.max(0,remaining);self.total=math.max(.001,total or self.total)
    self:Paint(self.remaining,self.total)
    local second=math.ceil(self.remaining)
    if waiting then
        self.countdown.Text="…";self.sound:Stop()
    else
        self.countdown.Text=tostring(second)
        if second~=self.lastSecond then
            self.lastSecond=second;self:Tick(second)
        end
    end
    self.pulseAge=math.min(1,self.pulseAge+math.max(0,dt)/.7)
    local age=self.pulseAge
    local visible=not self.cfg.ReducedMotion and not waiting and age&lt;1
    self.pulse.Visible=visible
    if visible then
        self.pulse.Size=UDim2.fromScale(1+age*.24,1+age*.24)
        for _,part in ipairs(self.pulseParts) do part.BackgroundTransparency=.2+age*.8 end
    end
end
function Heart:Stop()
    self.sound:Stop();self.pulse.Visible=false
end
function Heart:Destroy()
    self:Stop();self.root:Destroy()
end
return Heart
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleSlimeVisuals"><Properties><string name="Name">SlimeVisuals</string><ProtectedString name="Source">-- Cosmetic elastic response inspired by the supplied slime demo's velocity drag
-- and SmartBone inertia. No forces, bones or collider state enter game simulation.
local Slime={}
local function spring(value,velocity,target,dt,frequency,damping)
    local acceleration=(target-value)*frequency*frequency-2*damping*frequency*velocity
    velocity+=acceleration*dt
    return value+velocity*dt,velocity
end
function Slime.new(position,heading)
    return {position=position,heading=heading or 0,stretch=0,stretchVelocity=0,
        lean=0,leanVelocity=0,turn=0,turnVelocity=0,phase=0}
end
function Slime.Step(state,position,heading,dt,reduced)
    dt=math.max(0,dt or 0)
    local distance=(position-state.position).Magnitude
    local rotation=math.atan2(math.sin(heading-state.heading),math.cos(heading-state.heading))
    -- Respawns, large corrections and suspended frames should not create elastic explosions.
    if dt&gt;.25 or distance&gt;14 or reduced then
        state.stretch=0;state.stretchVelocity=0;state.lean=0;state.leanVelocity=0
        state.turn=0;state.turnVelocity=0
        state.position=position;state.heading=heading
        return {x=1,y=1,z=1,lean=0,turn=0,bob=0,phase=state.phase}
    end
    local speed=dt&gt;0.0001 and math.min(30,distance/dt) or 0
    local travel=math.clamp(speed/18,0,1)
    local stretchTarget=travel*.12
    local turnTarget=math.clamp(rotation/math.max(dt,.01),-5,5)*.045
    local remaining=math.min(dt,.1)
    while remaining&gt;0 do
        local step=math.min(remaining,1/120);remaining-=step
        state.stretch,state.stretchVelocity=spring(state.stretch,state.stretchVelocity,stretchTarget,step,14,.58)
        state.lean,state.leanVelocity=spring(state.lean,state.leanVelocity,travel*.085,step,11,.65)
        state.turn,state.turnVelocity=spring(state.turn,state.turnVelocity,turnTarget,step,13,.55)
    end
    state.phase+=dt*(3+travel*5)
    state.position=position;state.heading=heading
    local breathe=math.sin(state.phase)*.018
    local y=math.clamp(1-state.stretch+breathe,.78,1.13)
    -- Approximately conserve volume as the slime spreads against the ground.
    local spread=1/math.sqrt(y)
    return {x=spread,z=spread*(1+state.stretch*.32),y=y,
        lean=math.clamp(state.lean,-.12,.12),turn=math.clamp(state.turn,-.25,.25),
        bob=math.sin(state.phase*2)*travel*.045,phase=state.phase}
end
return Slime
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleSpawnService"><Properties><string name="Name">SpawnService</string><ProtectedString name="Source">-- Find truly empty spawn footprints. NEVER fall back to a random occupied cell.
-- Bots wait until an entire fresh territory fits without overwriting other owners.
local SpawnService = {}

local function isAvailable(world, point, ignoreEntity)
    local grid = world.grid
    local cfg = world.cfg
    local x, y = grid:Coords(point)
    local radius = cfg.SpawnRadiusCells + (cfg.SpawnPaddingCells or 2)
    if x - radius &lt; 1 or y - radius &lt; 1
        or x + radius &gt; grid.size or y + radius &gt; grid.size then
        return false
    end

    -- Leave a clear buffer around the starting territory, not just an empty center.
    for dy = -radius, radius do
        for dx = -radius, radius do
            if dx * dx + dy * dy &lt;= radius * radius then
                local index = grid:Index(x + dx, y + dy)
                if not index or grid.owners[index] ~= 0 then return false end
                -- An active trail is unsafe even when underlying land is unclaimed.
                if world.trails.buckets[index] then return false end
            end
        end
    end

    local separation = math.max((cfg.SpawnRadiusCells + 3) * cfg.Cell,
        cfg.SpawnMinEntityDistance or 36)
    local distanceSquared = separation * separation
    for _, other in ipairs(world.entities) do
        if other ~= ignoreEntity and other.alive then
            local v = other.pos - point
            if v:Dot(v) &lt; distanceSquared then return false end
        end
    end
    return true
end

function SpawnService.Choose(world, entity)
    local grid, rng = world.grid, world.rng
    local radius = world.cfg.SpawnRadiusCells + (world.cfg.SpawnPaddingCells or 2)
    local minCell, maxCell = radius + 1, grid.size - radius
    if minCell &gt; maxCell then return nil end
    local occupied = 0
    for _, count in pairs(grid.counts) do
        occupied += count
    end
    if grid.playableTotal - occupied &lt; math.pi * world.cfg.SpawnRadiusCells^2 then
        return nil
    end

    for _ = 1, 128 do
        local x = rng:NextInteger(minCell, maxCell)
        local y = rng:NextInteger(minCell, maxCell)
        local candidate = grid:Center(x, y)
        if isAvailable(world, candidate, entity) then return candidate end
    end

    -- Scan the entire arena if random sampling misses a rare empty pocket.
    -- A checkerboard phase offset avoids checking identical centers every retry.
    local stride = 2
    local phaseX, phaseY = rng:NextInteger(0, 1), rng:NextInteger(0, 1)
    for y = minCell + phaseY, maxCell, stride do
        for x = minCell + phaseX, maxCell, stride do
            local candidate = grid:Center(x, y)
            if isAvailable(world, candidate, entity) then return candidate end
        end
    end
    return nil
end

-- Revives already paid for must not silently fail when the arena is fully owned.
-- If the player has no surviving land and the arena has no free pocket, make an
-- explicit NEW protected starting island far away from active opponents.
-- This emergency rule is for HUMAN revive only; bots are never force-spawned.
function SpawnService.ChooseEmergencyRevive(world, entity)
    local grid = world.grid
    local radius = world.cfg.SpawnRadiusCells + 2
    local best, bestDistance = nil, -1
    for y = radius + 1, grid.size - radius, 4 do
        for x = radius + 1, grid.size - radius, 4 do
            local point = grid:Center(x, y)
            local closest = math.huge
            for _, other in ipairs(world.entities) do
                if other ~= entity and other.alive then
                    local d = (other.pos - point).Magnitude
                    if d &lt; closest then closest = d end
                end
            end
            if point.Magnitude &lt;= grid.maskRadius - radius * grid.cell and closest &gt; bestDistance then
                best, bestDistance = point, closest
            end
        end
    end
    return best
end

return SpawnService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleSplash"><Properties><string name="Name">Splash</string><ProtectedString name="Source">-- One ability definition. Only AbilityService calls Activate on the authority.
local Splash={Id="Splash",Name="SPLASH",Key="Q",Gamepad="ButtonX",Color=Color3.fromRGB(78,214,245)}
function Splash.Cooldown(cfg) return math.clamp(cfg.SplashCooldownSeconds or 18,1,300) end
function Splash.Activate(world,actor,cfg)
    local grid=world.grid
    -- No free return from an exposed trail: the loop remains the core mechanic.
    if actor.drawing or grid:GetOwnerAt(actor.pos)~=actor.id then return false,"Splash needs your own land" end
    local radius=math.clamp(cfg.SplashRadiusCells or 6,1,12)*grid.cell
    local x,y=grid:Coords(actor.pos)
    local cells,affected={},{}
    local reach=math.ceil(radius/grid.cell)
    local count=0
    for dy=-reach,reach do for dx=-reach,reach do
        local index=grid:Index(x+dx,y+dy)
        if index then
            local delta=grid:Center(x+dx,y+dy)-actor.pos
            if delta:Dot(delta)&lt;=radius*radius and grid.owners[index]~=actor.id then
                local owner=grid.owners[index]
                if owner&gt;0 then affected[owner]=true end
                grid:Set(index,actor.id);cells[index]=true;count+=1
            end
        end
    end end
    if count==0 then return false,"No new land in Splash range" end
    world:ResolveClaims(actor,cells,affected)
    actor.home=actor.pos
    world:CheckVictory()
    -- Actual gained tiles use the same server reward hook as a closed loop.
    if world.events.onCapture then world.events.onCapture(actor,count,cells) end
    return true,{radius=radius}
end
return Splash
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleTerritorySystem"><Properties><string name="Name">TerritorySystem</string><ProtectedString name="Source">local TerritorySystem = {}

-- Captures first overwrite land inside the closed loop. This may split an
-- enemy's territory. Keep the largest remaining connected landmass;
-- the disconnected fragments are returned to neutral ground.
function TerritorySystem.Capture(world, actor)
    if not actor.alive then return end

    local grid = world.grid
    local before = grid.counts[actor.id] or 0
    -- Capture invariant: closing your own trail may add land, never delete
    -- territory you already owned. Record ownership BEFORE other callbacks.
    local previouslyOwned = {}
    for index = 1, grid.total do
        if grid.owners[index] == actor.id then
            previouslyOwned[#previouslyOwned + 1] = index
        end
    end
    local _, claimedCells, affectedOwners = grid:Capture(actor.id, actor.trailCells)
    world.trails:Clear(actor)

    -- Trail joins and closed loops follow the same covered-head/split-land rules.
    world:ResolveClaims(actor, claimedCells, affectedOwners)

    -- IMPORTANT: Never prune the CAPTURER's own territory here.
    -- In V23-V25 RemoveDetachedLand(actor.id, actor.pos) could select the tiny
    -- section near the head and delete a 70%+ original connected landmass.
    -- Only LOSING owners are eligible for the split-territory rule above.

    -- Defensive invariant: if any future capture callback takes an old cell
    -- from this capturer during their own completed loop, restore it now.
    local restored = 0
    for _, index in ipairs(previouslyOwned) do
        if grid.owners[index] ~= actor.id then
            grid:Set(index, actor.id)
            claimedCells[index] = true
            restored += 1
        end
    end
    if restored &gt; 0 then
        warn(string.format(
            "[Paintland V26] Restored %d original cells: capture must never delete its owner's old land",
            restored
        ))
    end
    assert((grid.counts[actor.id] or 0) &gt;= before,
        "[Paintland V26] Capture ownership unexpectedly decreased")

    -- Cosmetic particles may only originate from land still owned by actor.
    -- The UI uses actual net gain, not cells that were immediately pruned.
    for index in pairs(claimedCells) do
        if grid.owners[index] ~= actor.id then
            claimedCells[index] = nil
        end
    end
    local netGain = math.max(0, (grid.counts[actor.id] or 0) - before)

    actor.home = actor.pos
    if not actor.isHuman and not world.completed then world.ai:Plan(actor, world) end

    -- State transition FIRST. Particle/render/UI errors may never prevent victory.
    if actor.isHuman then world:CheckVictory() end

    -- Optional presentation. Keep simulation/win consistent if visual code fails.
    if world.events.onCapture then
        local ok, err = xpcall(function()
            world.events.onCapture(actor, netGain, claimedCells)
        end, debug.traceback)
        if not ok then warn("[Paintland V25] Capture VFX error: " .. tostring(err)) end
    end
end

return TerritorySystem
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleTerritoryVFX"><Properties><string name="Name">TerritoryVFX</string><ProtectedString name="Source">-- V22: world-space capture effects; no numerical capture reward in the HUD.
-- A single BillboardGui above captured land, plus a bounded white-&gt;owner-color
-- sweep across coalesced regions. This module never edits real ownership.
local TweenService = game:GetService("TweenService")
local Geometry = require(script.Parent.ChunkGeometry)

local TerritoryVFX = {}
TerritoryVFX.__index = TerritoryVFX

local function make(parent, kind, name)
    local inst = Instance.new(kind)
    inst.Name = name
    inst.Parent = parent
    return inst
end

local function centerOfRect(rect, grid)
    return Vector2.new(
        -grid.half + (rect.x1 + rect.x2 - 1) * 0.5 * grid.cell,
        -grid.half + (rect.y1 + rect.y2 - 1) * 0.5 * grid.cell
    )
end

function TerritoryVFX.new(renderer, cfg)
    return setmetatable({
        renderer = renderer, cfg = cfg, generation = 0,
        active = {}, activeCount = 0,
    }, TerritoryVFX)
end

function TerritoryVFX:Clear()
    self.generation += 1
    for obj in pairs(self.active) do
        if obj.Parent then obj:Destroy() end
    end
    table.clear(self.active)
    self.activeCount = 0
end

function TerritoryVFX:_register(object)
    self.active[object] = true
    self.activeCount += 1
end

function TerritoryVFX:_finish(object)
    if not self.active[object] then return end
    self.active[object] = nil
    self.activeCount = math.max(0, self.activeCount - 1)
    object:Destroy()
end

function TerritoryVFX:_showBillboard(position, percent, ownerColor)
    local folder = self.renderer.arena.effectsFolder
    if not folder or not folder.Parent then return end
    local anchor = make(folder, "Part", "LandGainPopupAnchor")
    anchor.Size = Vector3.new(0.2, 0.2, 0.2)
    anchor.Position = Vector3.new(position.X, 2.5, position.Y)
    anchor.Anchored = true
    anchor.CanCollide = false
    anchor.CanTouch = false
    anchor.CanQuery = false
    anchor.Transparency = 1
    self:_register(anchor)

    local gui = make(anchor, "BillboardGui", "LandGainBillboard")
    gui.Adornee = anchor
    gui.AlwaysOnTop = true
    gui.LightInfluence = 0
    gui.MaxDistance = 320
    gui.Size = UDim2.fromOffset(230, 63)

    local label = make(gui, "TextLabel", "AreaGain")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBlack
    label.TextSize = 25
    label.Text = string.format("+%.2f%%", percent)
    label.TextColor3 = ownerColor:Lerp(Color3.new(1, 1, 1), 0.25)
    label.TextStrokeColor3 = Color3.fromRGB(27, 35, 69)
    label.TextStrokeTransparency = 0.1
    local scale = make(gui, "UIScale", "PopupScale")
    scale.Scale = 0.56

    local duration = self.cfg.CaptureWorldPopupDuration or 0.8
    TweenService:Create(anchor, TweenInfo.new(duration, Enum.EasingStyle.Quint,
        Enum.EasingDirection.Out), {Position = anchor.Position + Vector3.new(0, 3, 0)}):Play()
    TweenService:Create(scale, TweenInfo.new(0.24, Enum.EasingStyle.Back,
        Enum.EasingDirection.Out), {Scale = 1}):Play()
    task.delay(duration * 0.6, function()
        if not self.active[anchor] then return end
        TweenService:Create(label, TweenInfo.new(duration * 0.38,
            Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
    end)
    task.delay(duration + 0.05, function() self:_finish(anchor) end)
end

function TerritoryVFX:_showFlash(rect, ownerColor, grid, delaySeconds, version)
    task.delay(delaySeconds, function()
        if self.generation ~= version then return end
        local parent = self.renderer.arena.effectsFolder
        if not parent or not parent.Parent then return end
        if self.activeCount &gt;= (self.cfg.CaptureFlashMaxActive or 72) then return end
        local center = centerOfRect(rect, grid)
        local tile = make(parent, "Part", "TerritoryWhiteSweep")
        tile.Anchored = true
        tile.CanCollide = false
        tile.CanTouch = false
        tile.CanQuery = false
        tile.CastShadow = false
        tile.Material = Enum.Material.SmoothPlastic
        tile.Color = Color3.fromRGB(255, 250, 239)
        tile.Transparency = 0.03
        tile.Size = Vector3.new((rect.x2-rect.x1+1)*grid.cell + 0.06,
            0.045, (rect.y2-rect.y1+1)*grid.cell + 0.06)
        tile.Position = Vector3.new(center.X, 0.385, center.Y)
        self:_register(tile)
        -- Color follows the claimed owner, then gently fades to the actual land.
        TweenService:Create(tile, TweenInfo.new(self.cfg.CaptureFlashDuration or 0.34,
            Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Color = ownerColor, Transparency = 1,
                Position = tile.Position - Vector3.new(0, 0.045, 0)}):Play()
        task.delay((self.cfg.CaptureFlashDuration or 0.34) + 0.05,
            function() self:_finish(tile) end)
    end)
end

function TerritoryVFX:Play(entity, gainedCells, changedCells, grid)
    if not entity or gainedCells &lt;= 0 or not grid or not changedCells then return end
    -- Only owners of the final land are visualized. Never create stale flash
    -- segments for tiles that were stolen again in the same simulation step.
    local valid = {}
    local sx, sy, num = 0, 0, 0
    for index in pairs(changedCells) do
        if grid.owners[index] == entity.id then
            valid[index] = true
            local x = (index - 1) % grid.size + 1
            local y = math.floor((index - 1) / grid.size) + 1
            local c = grid:Center(x, y)
            sx += c.X
            sy += c.Y
            num += 1
        end
    end
    if num &lt;= 0 then return end
    local regions = Geometry.RectanglesFromSet(valid, grid.size)
    if #regions == 0 then return end
    -- Spread flashes away from the point of loop closure, giving a land-growth sweep.
    table.sort(regions, function(a,b)
        return (centerOfRect(a, grid) - entity.pos).Magnitude
            &lt; (centerOfRect(b, grid) - entity.pos).Magnitude
    end)
    local max = self.cfg.CaptureFlashMaxRegions or 24
    local version = self.generation
    for index = 1, (self.cfg.ReducedMotion and 0 or math.min(#regions, max)) do
        self:_showFlash(regions[index], entity.color, grid,
            (index - 1) * 0.014, version)
    end
    if entity.isHuman or self.cfg.ShowBotLandBillboards then
        if gainedCells &gt;= (self.cfg.CaptureWorldPopupMinCells or 3) then
            -- Choose a REAL owned cell closest to the center of the new area;
            -- the mathematical centroid of a crescent can be outside the land.
            local centroid = Vector2.new(sx/num, sy/num)
            local best, bestDist
            for index in pairs(valid) do
                local x = (index - 1) % grid.size + 1
                local y = math.floor((index - 1) / grid.size) + 1
                local center = grid:Center(x, y)
                local distance = (center - centroid).Magnitude
                if not bestDist or distance &lt; bestDist then
                    best, bestDist = center, distance
                end
            end
            self:_showBillboard(best, gainedCells / grid.playableTotal * 100, entity.color)
        end
    end
end

return TerritoryVFX
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleToyWorldFX"><Properties><string name="Name">ToyWorldFX</string><ProtectedString name="Source">-- V21: small physical impact motes above the board. Pooled and bounded for phones.
local FX={}
FX.__index=FX
local function bead(folder)
    local p=Instance.new("Part")
    p.Name="CaptureConfetti"
    p.Shape=Enum.PartType.Ball
    p.Size=Vector3.new(.35,.35,.35)
    p.Anchored=true
    p.Material=Enum.Material.Neon
    p.CanCollide=false
    p.CanTouch=false
    p.CanQuery=false
    p.CastShadow=false
    p.Transparency=1
    p.Parent=folder
    return p
end
function FX.new(renderer,cfg)
    return setmetatable({folder=renderer.arena.effectsFolder,cfg=cfg,
        pool={},active={},created=0,max=cfg.ToyFXMaxObjects or 50,
        rng=Random.new()},FX)
end
function FX:_emit(pos,color,count,size)
    if self.cfg.ReducedMotion then return end
    local mobile=game:GetService("UserInputService").TouchEnabled
    count=math.min(mobile and math.ceil(count*.55) or count,
        self.max-#self.active)
    for i=1,count do
        local p=table.remove(self.pool)
        if not p then
            if self.created&gt;=self.max then break end
            p=bead(self.folder)
            self.created+=1
        end
        local a=self.rng:NextNumber(0,math.pi*2)
        local speed=self.rng:NextNumber(7,18)*(size or 1)
        local origin=Vector3.new(pos.X,1.1,pos.Y)
        p.Position=origin
        p.Color=color:Lerp(Color3.new(1,1,1),self.rng:NextNumber(.15,.55))
        local radius=self.rng:NextNumber(.25,.7)
        p.Size=Vector3.new(radius,radius,radius)
        p.Transparency=0
        self.active[#self.active+1]={part=p,life=.58,age=0,at=origin,
            velocity=Vector3.new(math.cos(a)*speed,self.rng:NextNumber(4,11),math.sin(a)*speed)}
    end
end
function FX:Capture(entity,count)
    if entity and count&gt;0 then self:_emit(entity.pos,entity.color,math.min(12,3+math.floor(math.sqrt(count))),1) end
end
function FX:Elimination(victim,killer,hit)
    if victim then self:_emit(hit and hit.position or victim.pos,killer and killer.color or victim.color,12,1.1) end
end
function FX:Spawn(entity)
    if entity then self:_emit(entity.pos,entity.color,7,.65) end
end
function FX:Update(dt)
    dt=math.clamp(dt or 0,0,.05)
    for i=#self.active,1,-1 do
        local o=self.active[i]
        o.age+=dt
        local t=o.age/o.life
        if t&gt;=1 then
            o.part.Transparency=1
            self.pool[#self.pool+1]=o.part
            table.remove(self.active,i)
        else
            local v=o.velocity
            o.part.Position=o.at+v*o.age+Vector3.new(0,-20*o.age*o.age,0)
            o.part.Transparency=t*t
            local scale=math.max(.1,1-t)
            o.part.Size=Vector3.new(.5,.5,.5)*scale
        end
    end
end
function FX:Clear()
    for _,o in ipairs(self.active) do o.part.Transparency=1;self.pool[#self.pool+1]=o.part end
    table.clear(self.active)
end
return FX
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleTrailMerge"><Properties><string name="Name">TrailMerge</string><ProtectedString name="Source">-- Preserve the route from the cut back to each player's land before clearing
-- either trail. Only the defeated trail BEFORE the hit belongs to this bridge.
local Merge = {}
function Merge.Route(grid, killer, victim, hit)
    if not hit or not hit.index then return nil end
    local cut
    for n,index in ipairs(victim.trailCells) do
        if index==hit.index then cut=n;break end
    end
    if not cut then return nil end
    local route={}
    for n=1,cut do route[victim.trailCells[n]]=true end
    for _,index in ipairs(killer.trailCells) do route[index]=true end
    -- Bridge only the sub-cell collision tolerance, never arbitrary map space.
    local contact=grid:At(hit.position)
    if not contact then return nil end
    local function bridge(a,b)
        if not a or not b then return false end
        local ax,ay=(a-1)%grid.size+1,math.floor((a-1)/grid.size)+1
        local bx,by=(b-1)%grid.size+1,math.floor((b-1)/grid.size)+1
        if math.abs(ax-bx)&gt;2 or math.abs(ay-by)&gt;2 then return false end
        route[a]=true
        while ax~=bx or ay~=by do
            if ax~=bx then ax+=ax&lt;bx and 1 or -1 else ay+=ay&lt;by and 1 or -1 end
            local index=grid:Index(ax,ay)
            if not index then return false end
            route[index]=true
        end
        return true
    end
    if not bridge(contact,hit.index) then return nil end
    local last=killer.trailCells[#killer.trailCells]
    if last and not bridge(last,contact) then return nil end
    -- Trail entry can diagonally touch home. Preserve its actual departure cell
    -- so the four-connected ownership grid can follow the route to home.
    local victimHome=victim.nodes[1] and grid:At(victim.nodes[1])
    if victimHome and not bridge(victimHome,victim.trailCells[1]) then return nil end
    local killerHome=killer.nodes[1] and grid:At(killer.nodes[1])
    if last and killerHome and not bridge(killerHome,killer.trailCells[1]) then return nil end
    return {cells=route,cut=hit.index,contact=contact,required=killer.trailCells}
end
return Merge
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleTrailRenderer"><Properties><string name="Name">TrailRenderer</string><ProtectedString name="Source">-- V20: all exposed trails are anchored 3D Workspace parts, never GUI Frames.
-- Each life/trail gets its own generation; pooled segments cannot survive respawn.
local TrailRenderer = {}
TrailRenderer.__index = TrailRenderer

local TRAIL_Y = 0.51
local TRAIL_HEIGHT = 0.09

local function makeSegment(parent)
    local p = Instance.new("Part")
    p.Name = "TrailStrip"
    p.Anchored = true
    p.CanCollide, p.CanTouch, p.CanQuery = false, false, false
    p.CastShadow = false
    p.Material = Enum.Material.SmoothPlastic
    p.Size = Vector3.new(1, TRAIL_HEIGHT, 1)
    p.Transparency = 1
    p.Parent = parent
    return p
end

local function makeCap(parent)
    local p = makeSegment(parent)
    p.Name = "TrailRoundedJoint"
    p.Shape = Enum.PartType.Ball
    return p
end

function TrailRenderer.new(folder, config)
    return setmetatable({folder = folder, cfg = config,
        pools = {}, versions = {}, generations = {}, grid = nil}, TrailRenderer)
end

function TrailRenderer:Clear(id)
    local pool = self.pools[id]
    if pool then
        for _, p in ipairs(pool.segments) do p:Destroy() end
        for _, p in ipairs(pool.caps) do p:Destroy() end
    end
    self.pools[id] = nil
    self.versions[id] = nil
    self.generations[id] = nil
end

function TrailRenderer:Reset()
    for id in pairs(self.pools) do self:Clear(id) end
    self.folder:ClearAllChildren()
    self.pools, self.versions, self.generations = {}, {}, {}
end

local function placeStrip(p, a, b, color, thickness, maxSpan)
    local offset = b - a
    local length = offset.Magnitude
    if length &lt; 0.06 or length &gt; maxSpan then
        p.Transparency = 1
        return
    end
    local start3 = Vector3.new(a.X, TRAIL_Y, a.Y)
    local finish3 = Vector3.new(b.X, TRAIL_Y, b.Y)
    local direction = finish3 - start3
    p.Color = color
    p.Size = Vector3.new(thickness, TRAIL_HEIGHT, length + thickness * 0.12)
    p.CFrame = CFrame.lookAt((start3 + finish3) * 0.5, finish3)
    p.Transparency = 0
end

local function placeCap(p, a, color, thickness)
    p.Color = color
    p.Size = Vector3.new(thickness, TRAIL_HEIGHT + 0.01, thickness)
    p.Position = Vector3.new(a.X, TRAIL_Y, a.Y)
    p.Transparency = 0
end

local function ensure(pool, key, index, folder, factory)
    local part = pool[key][index]
    if not part then
        part = factory(folder)
        pool[key][index] = part
    end
    return part
end

function TrailRenderer:Render(entity)
    local id = entity.id
    if not entity.alive or not entity.drawing or #entity.nodes == 0 or
        (self.grid and self.grid:GetOwnerAt(entity.pos) == id) or
        (not entity.isHuman and self.cfg.ShowBotTrails == false) then
        if self.pools[id] then self:Clear(id) end
        return
    end

    local generation = tostring(entity.spawnRevision or 0) .. ":" .. tostring(entity.trailGeneration or 0)
    if self.generations[id] ~= generation then
        self:Clear(id)
        self.generations[id] = generation
    end
    local pool = self.pools[id]
    if not pool then
        pool = {segments = {}, caps = {}}
        self.pools[id] = pool
    end

    local nodes = entity.nodes
    local needed = #nodes -- static nodes plus the changing endpoint
    local maxSpan = math.max(15, (self.cfg.TrailSpacing or 3.5) * 5)
    local thick = self.cfg.TrailThickness or 3.3
    if self.versions[id] ~= entity.visualVersion then
        for i = 2, #nodes do
            placeStrip(ensure(pool, "segments", i - 1, self.folder, makeSegment),
                nodes[i - 1], nodes[i], entity.darkColor, thick, maxSpan)
            placeCap(ensure(pool, "caps", i - 1, self.folder, makeCap),
                nodes[i - 1], entity.darkColor, thick)
        end
        self.versions[id] = entity.visualVersion
    end
    placeStrip(ensure(pool, "segments", needed, self.folder, makeSegment),
        nodes[#nodes], entity.pos, entity.darkColor, thick, maxSpan)
    placeCap(ensure(pool, "caps", needed, self.folder, makeCap),
        nodes[#nodes], entity.darkColor, thick)

    -- Remove excess parts after a path shrinks or its generation is replaced.
    for i = #pool.segments, needed + 1, -1 do
        pool.segments[i]:Destroy(); pool.segments[i] = nil
    end
    for i = #pool.caps, needed + 1, -1 do
        pool.caps[i]:Destroy(); pool.caps[i] = nil
    end
end

return TrailRenderer
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleTrails"><Properties><string name="Name">Trails</string><ProtectedString name="Source">local Trails = {}
Trails.__index = Trails

function Trails.new(grid, cfg)
    return setmetatable({grid = grid, cfg = cfg, buckets = {}}, Trails)
end

function Trails:Clear(e)
    for _, index in ipairs(e.trailCells) do
        local bucket = self.buckets[index]
        if bucket then
            bucket[e.id] = nil
            if not next(bucket) then self.buckets[index] = nil end
        end
    end
    e.trailCells = {}
    e.trailSet = {}
    e.nodes = {}
    e.drawing = false
    e.outsideDistance = 0
    e.visualVersion += 1
    e.trailGeneration = (e.trailGeneration or 0) + 1
end

function Trails:Begin(e, point)
    e.drawing = true
    e.nodes = {point}
    e.outsideDistance = 0
    e.visualVersion += 1
    e.trailGeneration = (e.trailGeneration or 0) + 1
end

function Trails:Register(e, index, p, time)
    if not index or e.trailSet[index] then return end
    e.trailSet[index] = true
    e.trailCells[#e.trailCells + 1] = index
    local bucket = self.buckets[index]
    if not bucket then
        bucket = {}
        self.buckets[index] = bucket
    end
    bucket[e.id] = {point = p, time = time}
end

function Trails:HitList(e, point, time)
    local gx, gy = self.grid:Coords(point)
    local result = {}
    local radiusSquared = self.cfg.HitRadius^2
    for y = gy - 1, gy + 1 do
        for x = gx - 1, gx + 1 do
            local index = self.grid:Index(x, y)
            local bucket = index and self.buckets[index]
            if bucket then
                for owner, sample in pairs(bucket) do
                    if (owner ~= e.id or (self.cfg.SelfTrailKills and time - sample.time &gt; 0.8))
                        and (sample.point - point):Dot(sample.point - point) &lt;= radiusSquared then
                        local delta=sample.point-point
                        local distance=delta:Dot(delta)
                        local current=result[owner]
                        if not current or distance&lt;current.distance
                            or (distance==current.distance and index&lt;current.index) then
                            result[owner]={index=index,point=sample.point,distance=distance}
                        end
                    end
                end
            end
        end
    end
    return result
end

-- Sample more densely than one territory cell, and bridge diagonal corners
-- to make the flood-filled closed boundary watertight.
function Trails:Advance(e, from, to, time, onSample, onClosed)
    local length = (to - from).Magnitude
    local steps = math.max(1, math.ceil(length / (self.cfg.Cell * 0.23)))
    local last = from
    for n = 1, steps do
        if not e.alive then return end
        local point = from:Lerp(to, n / steps)
        if onSample(point, time) == false then return end
        local index = self.grid:At(point)
        if index then
            if self.grid.owners[index] == e.id then
                if e.drawing then
                    if #e.trailCells &gt;= 3 then
                        onClosed(e)
                    else
                        self:Clear(e)
                    end
                    -- CRITICAL: a closed loop ends this movement sweep.
                    -- Continuing to sample can cause another collision/death
                    -- AFTER World has awarded victory.
                    return
                end
            else
                if not e.drawing then self:Begin(e, last) end
                e.outsideDistance += (point - last).Magnitude
                local ax, ay = self.grid:Coords(last)
                local bx, by = self.grid:Coords(point)
                if ax ~= bx and ay ~= by then
                    self:Register(e, self.grid:Index(bx, ay), point, time)
                    self:Register(e, self.grid:Index(ax, by), point, time)
                end
                self:Register(e, index, point, time)
                local anchor = e.nodes[#e.nodes]
                if (point - anchor).Magnitude &gt;= self.cfg.TrailSpacing then
                    e.nodes[#e.nodes + 1] = point
                    e.visualVersion += 1
                end
            end
        end
        last = point
    end
end

return Trails
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleUIController"><Properties><string name="Name">UIController</string><ProtectedString name="Source">-- V39: illustrated main menu and responsive gameplay HUD.
local Fonts=require(script.Parent.Fonts)
local TweenService=game:GetService("TweenService")
local UIS=game:GetService("UserInputService")
local MinimapController=require(script.Parent.MinimapController)
local LeaderboardService=require(script.Parent.LeaderboardService)
local HUDCanvas=require(script.Parent.HUDCanvas)
local LeaderboardController=require(script.Parent.LeaderboardController)
local ButtonEffects=require(script.Parent.ButtonEffects)
local MainMenu=require(script.Parent.MainMenu)
local ResultsScreen=require(script.Parent.ResultsScreen)
local WalletHUD=require(script.Parent.WalletHUD)
local AbilityHUD=require(script.Parent.AbilityHUD)
local UI={}
UI.__index=UI
local INK=Color3.fromRGB(17,27,43)
local PANEL=Color3.fromRGB(25,39,59)
local WHITE=Color3.fromRGB(243,249,255)
local MUTED=Color3.fromRGB(166,187,205)
local MINT=Color3.fromRGB(82,230,186)
local EDGE=Color3.fromRGB(67,91,117)
local function make(parent,class,name,props)
    local obj=Instance.new(class)
    obj.Name=name
    for k,v in pairs(props or {}) do obj[k]=v end
    obj.Parent=parent
    return obj
end
local function round(obj,px)
    make(obj,"UICorner","Round",{CornerRadius=UDim.new(0,px)})
end
local function edge(obj,color,width)
    return make(obj,"UIStroke","Edge",{Color=color or EDGE,Thickness=width or 1})
end
local function text(parent,name,value,size,color,z)
    return make(parent,"TextLabel",name,{Text=value,TextSize=size,TextColor3=color or WHITE,
        BackgroundTransparency=1,BorderSizePixel=0,FontFace=Fonts.Bold,
        ZIndex=z or 44,TextTruncate=Enum.TextTruncate.AtEnd})
end
local function button(parent,name,value,color,z)
    local b=make(parent,"TextButton",name,{Text=value,TextSize=16,FontFace=Fonts.Bold,
        TextColor3=INK,BackgroundColor3=color or MINT,BorderSizePixel=0,AutoButtonColor=true,
        ZIndex=z or 46})
    round(b,14)
    return b
end
local function tween(obj,goals)
    TweenService:Create(obj,TweenInfo.new(.18,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),goals):Play()
end
function UI.new(renderer,cfg,callbacks)
    local self=setmetatable({renderer=renderer,cfg=cfg,callbacks=callbacks,
        mode="menu",skin=1,best=0,toastVersion=0,muted=cfg.SoundMutedByDefault==true},UI)
    local screen=renderer.screen
    self.wallet=WalletHUD.new(screen,cfg)
    self.abilities=AbilityHUD.new(screen,cfg,function(id) if callbacks.onAbility then callbacks.onAbility(id) end end)
    self.hud=make(screen,"Frame","HUD",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=20})
    self.progress=HUDCanvas.new(self.hud,cfg)
    self.leaderboard=LeaderboardController.new(self.hud,cfg)
    self.killCard=make(self.hud,"Frame","Eliminations",{Size=UDim2.fromOffset(142,60),
        Position=UDim2.fromOffset(18,56),BackgroundColor3=PANEL,BackgroundTransparency=.06,
        BorderSizePixel=0,ZIndex=32})
    round(self.killCard,16);edge(self.killCard)
    local kLabel=text(self.killCard,"Caption","ELIMINATIONS",9,MUTED,33)
    kLabel.Position=UDim2.fromOffset(12,8);kLabel.Size=UDim2.new(1,-24,0,16)
    kLabel.TextXAlignment=Enum.TextXAlignment.Left
    self.killCounter=text(self.killCard,"Count","0",23,WHITE,33)
    self.killCounter.Position=UDim2.fromOffset(12,24);self.killCounter.Size=UDim2.fromOffset(118,28)
    self.killCounter.TextXAlignment=Enum.TextXAlignment.Left
    self.toast=text(self.hud,"Notice","",14,WHITE,36)
    self.toast.AnchorPoint=Vector2.new(.5,0)
    self.toast.Position=UDim2.new(.5,0,0,132)
    self.toast.Size=UDim2.fromOffset(320,30)
    self.toast.TextStrokeTransparency=.45
    self.toast.TextStrokeColor3=INK
    self.toast.TextTransparency=1
    self.minimap=MinimapController.new(cfg,self.hud,renderer)

    self.overlay=make(screen,"Frame","MenuOverlay",{Size=UDim2.fromScale(1,1),
        BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=.5,BorderSizePixel=0,ZIndex=40})
    make(self.overlay,"UIGradient","Atmosphere",{Rotation=35,
        Color=ColorSequence.new(Color3.fromRGB(45,154,218),Color3.fromRGB(75,86,194))})
    self.menu=MainMenu.new(self.overlay,cfg,function(index) self.skin=index end,function()
        if (self.mode=="menu" or self.mode=="win") and callbacks.onPlay then callbacks.onPlay(self.skin) end
    end,function(action)
        if self.mode=="menu" and callbacks.onRooms then callbacks.onRooms(action) end
    end)
    self.card=self.menu.root
    for _,key in ipairs({"title","subtitle","badge","skinTitle","skins","play","help"}) do self[key]=self.menu[key] end
    self.results=ResultsScreen.new(screen,cfg,{
        onPlay=function() if self.mode=="defeat" and callbacks.onPlay then callbacks.onPlay(self.skin) end end,
        onMainMenu=function()
            if self.mode~="defeat" then return end
            if callbacks.onMainMenu then callbacks.onMainMenu() end
            self:SetMode("menu")
        end,
    })
    self.defeatOverlay=self.results.root
    self.replay=self.results.play;self.returnMenu=self.results.menuButton
    self.result=self.results.percentLabel;self.defeatDetails=self.results.details
    self.soundButton=button(screen,"ToggleSound","SOUND: OFF",PANEL,150)
    self.soundButton.TextColor3=MUTED;self.soundButton.TextSize=11
    self.soundButton.AnchorPoint=Vector2.new(.5,.5)
    self.soundButton.Position=UDim2.new(1,-84,1,-40)
    ButtonEffects.SetSize(self.soundButton,UDim2.fromOffset(132,44))
    edge(self.soundButton)
    self.soundButton.Activated:Connect(function()
        if cfg.SoundEnabled==false then return end
        self.muted=not self.muted
        if callbacks.onSoundToggle then callbacks.onSoundToggle(self.muted) end
        self:UpdateSoundLabel()
    end)
    for _,view in ipairs(self.skins) do ButtonEffects.Bind(view.button,cfg) end
    ButtonEffects.Bind(self.play,cfg,{play=true,depth=self.menu.playBase})
    for _,b in ipairs({self.soundButton}) do ButtonEffects.Bind(b,cfg) end
    self:UpdateSoundLabel()
    self.resize=renderer.viewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() self:Resize() end)
    self:Resize()
    self:SetMode("menu")
    task.defer(function() if screen.Parent then self:Resize() end end)
    return self
end
function UI:UpdateSoundLabel()
    local disabled=self.cfg.SoundEnabled==false
    self.soundButton.Text=disabled and "SOUND: DISABLED" or (self.muted and "SOUND: OFF" or "SOUND: ON")
    self.soundButton.TextColor3=(self.muted or disabled) and MUTED or MINT
end
function UI:Resize()
    local s=self.renderer.viewport.AbsoluteSize
    if s.X&lt;1 or s.Y&lt;1 then return end
    local narrow=s.X&lt;900
    self.progress:Resize(s);self.leaderboard:Resize(s);self.minimap:Resize(s)
    self.killCard.Position=UDim2.fromOffset(narrow and 12 or 18,s.Y&lt;350 and 124 or (s.Y&lt;500 and 132 or (narrow and 168 or 56)))
    self.killCard.Size=UDim2.fromOffset(narrow and 116 or 142,60)
    self.killCounter.Size=UDim2.new(1,-24,0,28)
    self.wallet:Resize(s,self.mode)
    self.abilities:Resize(s)
    self.menu:Resize(s)
    self.results:Resize(s)
    self.toast.Size=UDim2.fromOffset(math.min(s.X-24,320),30)
    self.toast.Position=UDim2.new(.5,0,0,s.Y&lt;500 and 184 or 132)
    self.soundButton.Position=UDim2.new(1,-78,1,-34)
    ButtonEffects.SetSize(self.soundButton,UDim2.fromOffset(132,44))
end
function UI:NewRun()
    self.best=0;self.defeatStats=nil;self.progress:Reset()
end
function UI:SetMode(mode)
    self.mode=mode
    self.wallet.root.Visible=mode=="menu" or mode=="playing" or mode=="win"
    self.abilities:SetActive(mode=="playing")
    self.overlay.Visible=mode=="menu" or mode=="win"
    if mode~="defeat" then self.results:Hide() end
    self.hud.Visible=mode~="menu" and mode~="win" and mode~="defeat" and mode~="lobby"

    self.soundButton.Visible=mode~="revive" and mode~="defeat" and mode~="lobby"
    self.title.Text=mode=="win" and "ALL YOURS!" or "PAINTLAND"
    self.menu.titleShadow.Text=self.title.Text
    self.badge.Text=mode=="win" and "100% CONQUERED" or "THE ARENA IS YOUR CANVAS"
    self.subtitle.Text=mode=="win" and "Every last tile. All yours." or "Small trail. Big takeover."
    self.play.Text=mode=="win" and "PAINT AGAIN   →" or "PLAY NOW   →"
    self.menu:Show(mode=="menu" or mode=="win")
    self:Resize()
end
-- Snapshot at death, before any revive choice or delayed HUD update.
function UI:RecordDefeat(world)
    local player=world.entities[1]
    local count=world.grid.counts[1] or 0
    local total=world.grid.playableTotal
    self.defeatStats={count=count,percent=count/math.max(1,total)*100,
        kills=player and player.kills or 0,color=player and player.color or MINT,
        size=world.grid.size or 1,mask={},cells={}}
    for index=1,(world.grid.total or 0) do
        self.defeatStats.mask[index]=world.grid.mask[index]==true
        self.defeatStats.cells[index]=world.grid.owners[index]==1
    end
end
function UI:ShowDefeat(world)
    if not self.defeatStats then self:RecordDefeat(world) end
    self:SetMode("defeat")
    self.results:Show(self.defeatStats)
end
function UI:SetWallet(data) self.wallet:Set(data) end
function UI:SetAbilityState(data)
    self.abilities:SetState(data)
    if data.accepted==false and data.reason then self:Toast(data.reason,Color3.fromRGB(255,225,175)) end
end
function UI:UpdatePresentation(dt)
    self.wallet:Update(dt)
    self.abilities:Update(dt)
    self.results:Update(dt)
end
function UI:Toast(message,color)
    self.toastVersion+=1
    local version=self.toastVersion
    self.toast.Text=message;self.toast.TextColor3=color or WHITE;self.toast.TextTransparency=0
    task.delay(1.2,function()
        if version==self.toastVersion and self.toast.Parent then tween(self.toast,{TextTransparency=1}) end
    end)
end
function UI:Update(world)
    local player=world.entities[1]
    if not player then return end
    local value=world.completed and 100 or (world.grid.counts[1] or 0)/math.max(1,world.grid.playableTotal)*100
    self.best=math.max(self.best,value)
    self.progress:Update(value,player.color)
    self.killCounter.Text=tostring(player.kills or 0)
    local ordered,leader=LeaderboardService.Get(world)
    self.renderer:SetLeader(leader and leader.id or nil)
    self.minimap:UpdateStats(world);self.leaderboard:Update(ordered,leader,world)
end
function UI:Destroy()
    self.toastVersion+=1
    if self.resize then self.resize:Disconnect() end
    self.progress:Destroy();self.leaderboard:Destroy();self.minimap:Destroy()
    self.wallet:Destroy()
    self.abilities:Destroy()
    self.menu:Destroy()
    self.hud:Destroy();self.overlay:Destroy();self.results:Destroy();self.soundButton:Destroy()
end
return UI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleVictoryController"><Properties><string name="Name">VictoryController</string><ProtectedString name="Source">-- V41: bright victory presentation with native-size actions on phones.
local Fonts=require(script.Parent.Fonts)
local TweenService=game:GetService("TweenService")
local ButtonEffects=require(script.Parent.ButtonEffects)
local Controller={}
Controller.__index=Controller
local INK=Color3.fromRGB(29,34,102)
local WHITE=Color3.new(1,1,1)
local LIME=Color3.fromRGB(153,246,65)
local COLORS={Color3.fromRGB(255,209,79),Color3.fromRGB(80,240,192),Color3.fromRGB(255,125,172),Color3.fromRGB(157,119,255)}
local function make(parent,class,name,props)
    local o=Instance.new(class);o.Name=name
    for k,v in pairs(props) do o[k]=v end
    o.Parent=parent;return o
end
local function frame(parent,name,props)
    props.BorderSizePixel=0;props.Active=false;props.Selectable=false
    return make(parent,"Frame",name,props)
end
local function round(o,r) make(o,"UICorner","Corner",{CornerRadius=UDim.new(0,r)}) end
local function stroke(o,c,w) make(o,"UIStroke","Outline",{Color=c,Thickness=w,ApplyStrokeMode=Enum.ApplyStrokeMode.Border}) end
local function text(parent,name,value,size,color,regular)
    return make(parent,"TextLabel",name,{BackgroundTransparency=1,BorderSizePixel=0,
        FontFace=regular and Fonts.Regular or Fonts.Bold,Text=value,TextSize=size,TextColor3=color or WHITE,
        TextStrokeColor3=INK,TextStrokeTransparency=regular and .6 or 0,Active=false,Selectable=false,ZIndex=206})
end
function Controller.new(screen,cfg,onReplay)
    local self=setmetatable({cfg=cfg,onReplay=onReplay,active=false,confetti={},elapsed=0,tweens={},rng=Random.new()},Controller)
    self.overlay=frame(screen,"VictoryOverlay",{Size=UDim2.fromScale(1,1),Visible=false,BackgroundColor3=WHITE,
        BackgroundTransparency=.06,ZIndex=200})
    self.overlay.Active=true
    make(self.overlay,"UIGradient","BlueSky",{Rotation=40,Color=ColorSequence.new(Color3.fromRGB(20,92,230),Color3.fromRGB(5,204,222))})
    self.confettiLayer=frame(self.overlay,"ConfettiLayer",{Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ClipsDescendants=true,ZIndex=201})
    self.card=frame(self.overlay,"VictoryContent",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),
        Size=UDim2.fromOffset(460,480),BackgroundTransparency=1,ZIndex=205})
    self.stars=text(self.card,"Stars","★    ★    ★",35,Color3.fromRGB(255,224,99))
    self.title=text(self.card,"VictoryTitle","ARENA CONQUERED!",34)
    self.title.TextScaled=true
    make(self.title,"UITextSizeConstraint","FitTitle",{MinTextSize=18,MaxTextSize=36})
    self.subtitle=text(self.card,"VictorySubtitle","EVERY LAST TILE. ALL YOURS.",12,WHITE,true)
    self.medallion=frame(self.card,"TerritoryMedallion",{AnchorPoint=Vector2.new(.5,.5),BackgroundColor3=Color3.fromRGB(11,109,185),
        Size=UDim2.fromOffset(220,180),ZIndex=205})
    round(self.medallion,80);stroke(self.medallion,INK,4)
    make(self.medallion,"UIGradient","Aqua",{Rotation=90,Color=ColorSequence.new(WHITE,Color3.fromRGB(95,218,237))})
    self.percent=text(self.medallion,"VictoryPercent","100%",72,WHITE)
    self.percent.Size=UDim2.fromScale(1,.68);self.percent.Position=UDim2.fromScale(0,.05)
    self.percent.TextScaled=true
    make(self.percent,"UITextSizeConstraint","FitPercent",{MinTextSize=24,MaxTextSize=76})
    self.caption=text(self.medallion,"TerritoryLabel","TERRITORY CLAIMED",11,Color3.fromRGB(193,255,237),true)
    self.caption.Position=UDim2.fromScale(0,.72);self.caption.Size=UDim2.fromScale(1,.18)
    self.results=text(self.card,"MatchStats","0 KILLS  •  0 BEST STREAK",12,WHITE,true)
    self.play=make(self.card,"TextButton","PlayAgain",{AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(300,60),
        Text="PLAY AGAIN",TextSize=23,TextColor3=INK,FontFace=Fonts.Bold,AutoButtonColor=false,
        BackgroundColor3=LIME,BorderSizePixel=0,Active=true,Selectable=true,ZIndex=207})
    round(self.play,18);stroke(self.play,INK,3)
    make(self.play,"UIGradient","ButtonShine",{Rotation=90,Color=ColorSequence.new(WHITE,Color3.fromRGB(169,223,98))})
    ButtonEffects.Bind(self.play,cfg,{play=true})
    self.play.Activated:Connect(function() if self.active and self.onReplay then self.onReplay() end end)
    self.sizeConnection=self.overlay:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() self:Resize(self.overlay.AbsoluteSize) end)
    self:Resize(self.overlay.AbsoluteSize or Vector2.new(1280,720))
    return self
end
function Controller:StopTweens()
    for _,t in ipairs(self.tweens) do t:Cancel() end
    table.clear(self.tweens)
end
function Controller:Resize(viewport)
    if not viewport or viewport.X&lt;1 or viewport.Y&lt;1 then return end
    self:StopTweens()
    self.viewport=viewport
    local wide=viewport.X&gt;=568 and viewport.X/viewport.Y&gt;1.4
    local w=math.min(wide and 720 or 460,viewport.X-32)
    local h=math.min(wide and 320 or 480,viewport.Y-32)
    self.card.Size=UDim2.fromOffset(w,h);self.card.Position=UDim2.fromScale(.5,.5)
    self.stars.Visible=not wide
    self.stars.Position=UDim2.fromOffset(0,0);self.stars.Size=UDim2.new(1,0,0,44)
    self.title.Position=UDim2.fromOffset(0,wide and 0 or 48);self.title.Size=UDim2.new(1,0,0,48)
    self.subtitle.Position=UDim2.fromOffset(0,wide and 49 or 98);self.subtitle.Size=UDim2.new(1,0,0,24)
    if wide then
        local diameter=math.min(180,h-106)
        self.medallion.Size=UDim2.fromOffset(diameter,diameter)
        self.medallion.Position=UDim2.new(.25,0,0,76+diameter/2)
        self.results.Position=UDim2.new(.5,0,0,100);self.results.Size=UDim2.new(.5,0,0,42)
        ButtonEffects.SetSize(self.play,UDim2.new(.5,-16,0,60))
        self.play.Position=UDim2.new(.75,0,0,h-62)
    else
        local diameter=math.min(220,w-48,h-230)
        self.medallion.Size=UDim2.fromOffset(diameter,diameter*.86)
        self.medallion.Position=UDim2.new(.5,0,0,132+diameter*.43)
        self.results.Position=UDim2.new(0,0,1,-113);self.results.Size=UDim2.new(1,0,0,30)
        ButtonEffects.SetSize(self.play,UDim2.new(1,-24,0,60))
        self.play.Position=UDim2.new(.5,0,1,-40)
    end
end
function Controller:Show(world)
    if self.active then return end
    self.active=true;self.elapsed=0;self.overlay.Visible=true
    self:Resize(self.overlay.AbsoluteSize or self.viewport or Vector2.new(1280,720))
    local e=world and world.entities and world.entities[1]
    self.results.Text=string.format("%d KILLS  •  %d BEST STREAK",e and e.kills or 0,e and e.bestKillStreak or 0)
    self.percent.Text="100%"
    if not self.cfg.ReducedMotion then
        self.card.Position=UDim2.new(.5,0,.5,12)
        local t=TweenService:Create(self.card,TweenInfo.new(.3,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Position=UDim2.fromScale(.5,.5)})
        table.insert(self.tweens,t);t:Play()
        local count=(self.viewport and self.viewport.X&lt;730) and (self.cfg.VictoryConfettiCountMobile or 20) or (self.cfg.VictoryConfettiCount or 34)
        for i=1,math.clamp(count,0,48) do
            local p=frame(self.confettiLayer,"VictoryConfetti",{BackgroundColor3=COLORS[(i-1)%#COLORS+1],
                Size=UDim2.fromOffset(self.rng:NextInteger(5,9),self.rng:NextInteger(9,17)),ZIndex=201})
            table.insert(self.confetti,{gui=p,x=self.rng:NextNumber(.02,.98),y=self.rng:NextNumber(-.7,-.06),
                vy=self.rng:NextNumber(.18,.4),vx=self.rng:NextNumber(-.035,.035),rot=self.rng:NextNumber(0,360),spin=self.rng:NextNumber(-180,180)})
        end
    end
end
function Controller:Update(dt)
    if not self.active then return end
    dt=math.clamp(dt or 0,0,.1);self.elapsed+=dt
    for _,p in ipairs(self.confetti) do
        p.y+=p.vy*dt;p.x+=p.vx*dt;p.rot+=p.spin*dt
        if p.y&gt;1.15 then p.y=-.12;p.x=self.rng:NextNumber(.02,.98) end
        p.gui.Position=UDim2.fromScale(p.x,p.y);p.gui.Rotation=p.rot
    end
end
function Controller:Hide()
    self.active=false;self.overlay.Visible=false;self:StopTweens()
    for _,p in ipairs(self.confetti) do p.gui:Destroy() end
    table.clear(self.confetti)
end
function Controller:Destroy()
    self:Hide();if self.sizeConnection then self.sizeConnection:Disconnect() end
    self.overlay:Destroy()
end
return Controller
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleVictoryWorldFX"><Properties><string name="Name">VictoryWorldFX</string><ProtectedString name="Source">-- V24: light Workspace celebration anchored at the winning player.
-- Visual only. All generated objects are capped and cleaned on replay.
local TweenService=game:GetService("TweenService")
local FX={}
FX.__index=FX
function FX.new(renderer,cfg)
    return setmetatable({renderer=renderer,cfg=cfg,active={},generation=0},FX)
end
function FX:Clear()
    self.generation+=1
    for _,obj in ipairs(self.active) do if obj.Parent then obj:Destroy() end end
    table.clear(self.active)
end
local function makePart(parent, name, pos, size, color)
    local p=Instance.new("Part")
    p.Name=name;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
    p.CastShadow=false;p.Material=Enum.Material.Neon
    p.Color=color;p.Transparency=.15;p.Size=size;p.Position=pos;p.Parent=parent
    return p
end
function FX:Play(entity)
    self:Clear()
    if self.cfg.VictoryEffectsEnabled==false or not entity then return end
    local arena=self.renderer.arena
    local parent=arena and arena.effectsFolder
    if not parent then return end
    local pos=Vector3.new(entity.pos.X,(self.cfg.CharacterHeight or 3.7)+1.8,entity.pos.Y)
    local anchor=makePart(parent,"VictoryBurstAnchor",pos,Vector3.new(.1,.1,.1),Color3.new(1,1,1))
    anchor.Transparency=1
    table.insert(self.active,anchor)
    local particles=Instance.new("ParticleEmitter")
    particles.Name="VictorySparks"
    particles.Texture="rbxasset://textures/particles/sparkles_main.dds"
    particles.Rate=0
    particles.Lifetime=NumberRange.new(.55,1.25)
    particles.Speed=NumberRange.new(11,22)
    particles.SpreadAngle=Vector2.new(180,180)
    particles.Acceleration=Vector3.new(0,-16,0)
    particles.Drag=2
    particles.LightEmission=.45
    particles.Color=ColorSequence.new({
        ColorSequenceKeypoint.new(0,Color3.fromRGB(255,245,185)),
        ColorSequenceKeypoint.new(.5,entity.color),
        ColorSequenceKeypoint.new(1,Color3.fromRGB(255,255,255))})
    particles.Size=NumberSequence.new({
        NumberSequenceKeypoint.new(0,.85),NumberSequenceKeypoint.new(.5,.52),
        NumberSequenceKeypoint.new(1,0)})
    particles.Parent=anchor
    particles:Emit(self.cfg.ReducedMotion and 14 or 45)
    local mobile=game:GetService("UserInputService").TouchEnabled
    local count=mobile and (self.cfg.VictoryWorldSparkCountMobile or 12)
        or (self.cfg.VictoryWorldSparkCount or 22)
    if self.cfg.ReducedMotion then count=math.floor(count*.4) end
    for i=1,count do
        local angle=i*math.pi*2/math.max(count,1)
        local dir=Vector3.new(math.cos(angle),0,math.sin(angle))
        local p=makePart(parent,"VictoryGlint",pos+dir*1.5,Vector3.new(.65,.65,.65),
            i%3==0 and Color3.fromRGB(255,219,90) or entity.color)
        p.Shape=Enum.PartType.Ball
        table.insert(self.active,p)
        TweenService:Create(p,TweenInfo.new(.72,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{
            Position=pos+dir*(12+(i%5)*1.5)+Vector3.new(0,(i%4)*.7,0),
            Transparency=1,Size=Vector3.new(.12,.12,.12)
        }):Play()
    end
    local version=self.generation
    task.delay(3,function()
        if self.generation==version then self:Clear() end
    end)
end
return FX
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleWalletHUD"><Properties><string name="Name">WalletHUD</string><ProtectedString name="Source">-- Compact server-confirmed wallet. Loading/failure never pretends the balance is zero.
local Fonts=require(script.Parent.Fonts)
local Wallet={};Wallet.__index=Wallet
local INK=Color3.fromRGB(40,35,76)
local function make(parent,class,name,p)
    local o=Instance.new(class);o.Name=name;for k,v in pairs(p) do o[k]=v end;o.Parent=parent;return o
end
local function short(n)
    n=math.max(0,math.floor(tonumber(n) or 0))
    if n&gt;=1000000 then return string.format("%.1fM",n/1000000) end
    if n&gt;=10000 then return string.format("%.1fK",n/1000) end
    return tostring(n)
end
function Wallet.new(screen,cfg)
    local self=setmetatable({cfg=cfg,timer=0,loaded=false},Wallet)
    self.root=make(screen,"Frame","Wallet",{AnchorPoint=Vector2.new(0,1),Position=UDim2.new(0,12,1,-12),
        Size=UDim2.fromOffset(160,44),BackgroundTransparency=1,Active=false,ZIndex=160})
    self.cards={};self.values={};self.captions={}
    for i,data in ipairs({{"Coins",Color3.fromRGB(255,211,77)},{"Gems",Color3.fromRGB(178,139,255)}}) do
        local card=make(self.root,"Frame",data[1],{Position=UDim2.new((i-1)*.5,(i-1)*3,0,0),
            Size=UDim2.new(.5,-3,1,0),BackgroundColor3=Color3.fromRGB(255,250,232),BorderSizePixel=0,Active=false,ZIndex=160})
        make(card,"UICorner","Round",{CornerRadius=UDim.new(0,12)})
        make(card,"UIStroke","Edge",{Color=INK,Thickness=2})
        local icon=make(card,"Frame","Icon",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.new(0,13,.5,0),
            Size=UDim2.fromOffset(i==1 and 17 or 13,i==1 and 17 or 13),Rotation=i==2 and 45 or 0,
            BackgroundColor3=data[2],BorderSizePixel=0,Active=false,ZIndex=161})
        make(icon,"UICorner","Round",{CornerRadius=UDim.new(i==1 and 1 or 0,i==2 and 3 or 0)})
        make(icon,"UIStroke","Edge",{Color=INK,Thickness=1})
        self.captions[i]=make(card,"TextLabel","Caption",{Position=UDim2.fromOffset(25,4),Size=UDim2.new(1,-28,0,12),Text=data[1]:upper(),
            FontFace=Fonts.Bold,TextSize=8,TextColor3=INK,BackgroundTransparency=1,Active=false,ZIndex=161})
        self.values[i]=make(card,"TextLabel","Balance",{Position=UDim2.fromOffset(23,16),Size=UDim2.new(1,-25,0,23),Text="…",
            FontFace=Fonts.Bold,TextSize=16,TextColor3=INK,BackgroundTransparency=1,Active=false,ZIndex=161})
        self.cards[i]=card
    end
    if cfg.MultiplayerEnabled==false then
        self:Set({loaded=true,coins=0,gems=0,persistent=false})
        self.captions[1].Text="PRACTICE";self.captions[2].Text="PRACTICE"
    else self:Captions() end
    return self
end
function Wallet:Captions()
    local data=self.data or {}
    local status=data.saving and "SAVE PENDING" or (not self.loaded and "LOADING" or nil)
    self.captions[1].Text=status or (data.persistent==false and "COINS · TEST" or "COINS")
    self.captions[2].Text=status or (data.persistent==false and "GEMS · TEST" or "GEMS")
end
function Wallet:Set(data)
    self.loaded=data.loaded==true;self.data=data
    self.values[1].Text=self.loaded and short(data.coins) or "…"
    self.values[2].Text=self.loaded and short(data.gems) or "…"
    local coins,gems=math.max(0,data.deltaCoins or 0),math.max(0,data.deltaGems or 0)
    if coins&gt;0 or gems&gt;0 then
        self.timer=2.2
        self:Captions()
        if coins&gt;0 then self.captions[1].Text="+"..short(coins).." COINS" end
        if gems&gt;0 then self.captions[2].Text="+"..short(gems).." GEMS!" end
    elseif self.timer&lt;=0 or data.saving then self:Captions() end
end
function Wallet:Update(dt)
    if self.timer&lt;=0 then return end
    self.timer=math.max(0,self.timer-dt)
    if self.timer==0 then self:Captions() end
end
function Wallet:Resize(size,mode)
    local playing=mode=="playing"
    local stacked=playing and size.X&lt;600 and size.Y&gt;=500
    self.root.AnchorPoint=Vector2.new(0,1)
    self.root.Position=UDim2.new(0,12,1,-12)
    self.root.Size=UDim2.fromOffset(size.X&lt;600 and 160 or 224,44)
    if playing then
        self.root.AnchorPoint=Vector2.zero
        if stacked then
            self.root.Position=UDim2.fromOffset(12,240);self.root.Size=UDim2.fromOffset(116,94)
        elseif size.X&lt;900 or size.Y&lt;500 then
            self.root.AnchorPoint=Vector2.new(.5,0);self.root.Position=UDim2.new(.5,0,0,132)
            self.root.Size=UDim2.fromOffset(size.X&lt;620 and 208 or 224,44)
        else self.root.Position=UDim2.fromOffset(18,128) end
    end
    for i,card in ipairs(self.cards) do
        card.Position=stacked and UDim2.fromOffset(0,(i-1)*50) or UDim2.new((i-1)*.5,(i-1)*3,0,0)
        card.Size=stacked and UDim2.new(1,0,0,44) or UDim2.new(.5,-3,0,44)
    end
end
function Wallet:Destroy() self.root:Destroy() end
return Wallet
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleWorkspaceArena"><Properties><string name="Name">WorkspaceArena</string><ProtectedString name="Source">-- V21 toy-like 3D playfield. One world-render path, no SurfaceGui terrain.
local Arena = {}
Arena.__index = Arena
local function part(parent, name, size, cf, color, material)
    local p=Instance.new("Part")
    p.Name=name
    p.Anchored=true
    p.Size=size
    p.CFrame=cf
    p.Color=color
    p.Material=material or Enum.Material.SmoothPlastic
    p.CanCollide=false
    p.CanTouch=false
    p.CanQuery=false
    p.CastShadow=false
    p.Parent=parent
    return p
end
local function asset(v)
    if type(v)=="number" and v&gt;0 then return "rbxassetid://"..math.floor(v) end
    if type(v)=="string" and v:match("^%d+$") then return "rbxassetid://"..v end
    if type(v)=="string" and v:match("^rbxassetid://%d+$") then return v end
    return nil
end
local function disk(parent,name,radius,thickness,y,color)
    local d=part(parent,name,Vector3.new(thickness,radius*2,radius*2),
        CFrame.new(0,y,0)*CFrame.Angles(0,0,math.pi/2),color)
    d.Shape=Enum.PartType.Cylinder
    return d
end

function Arena.new(_,cfg)
    for _,name in ipairs({"PaintlandRuntime","PaperPrototype","PaintlandWorld"}) do
        local old=workspace:FindFirstChild(name)
        if old then old:Destroy() end
    end
    local folder=Instance.new("Folder")
    folder.Name="PaintlandRuntime"
    folder.Parent=workspace
    local size=cfg.Grid*cfg.Cell
    local radius=cfg.ArenaRadius or (size/2-cfg.Cell*2)
    part(folder,"OutsideGround",Vector3.new(size+1000,.4,size+1000),
        CFrame.new(0,-1.3,0),cfg.OutsideColor)
    disk(folder,"CircularDropShadow",radius+14,.8,-.90,Color3.fromRGB(58,57,90))
    disk(folder,"NavyArenaRing",radius+9,.52,-.50,Color3.fromRGB(51,58,105))
    disk(folder,"CandyArenaRing",radius+4,.36,-.32,Color3.fromRGB(248,151,90))
    local floor=disk(folder,"Playfield",radius,.28,-.12,cfg.FloorColor)
    floor.CanQuery=true
    local textureId = asset(cfg.FloorTextureId)
    if textureId then
        local surface=Instance.new("Texture")
        surface.Name="OptionalFloorTexture"
        -- Cylinder's local +X end-cap points upward after our rotation.
        surface.Face=Enum.NormalId.Right
        surface.Texture=textureId
        surface.StudsPerTileU=cfg.FloorTextureTileStuds or 32
        surface.StudsPerTileV=cfg.FloorTextureTileStuds or 32
        surface.Transparency=cfg.FloorTextureTransparency or .65
        surface.Parent=floor
    end
    -- Straight tile guides are clipped mathematically to the circle.
    local grid=Instance.new("Folder")
    grid.Name="FloorTileGrid"
    grid.Parent=folder
    local interval=cfg.ArenaTileStuds or 16
    local color=cfg.ArenaGridColor or Color3.fromRGB(213,218,223)
    local thick=cfg.ArenaGridThickness or .11
    for offset=-radius+interval,radius-interval,interval do
        local extent=math.sqrt(math.max(0,radius*radius-offset*offset))-1.0
        if extent&gt;4 then
            local xline=part(grid,"TileLineX",Vector3.new(thick,.025,2*extent),
                CFrame.new(offset,.035,0),color)
            xline.Transparency=.63
            local zline=part(grid,"TileLineZ",Vector3.new(2*extent,.025,thick),
                CFrame.new(0,.035,offset),color)
            zline.Transparency=.63
        end
    end
    local land=Instance.new("Folder") land.Name="Land" land.Parent=folder
    local trails=Instance.new("Folder") trails.Name="Trails" trails.Parent=folder
    local actors=Instance.new("Folder") actors.Name="Characters" actors.Parent=folder
    local fx=Instance.new("Folder") fx.Name="LandEffects" fx.Parent=folder
    return setmetatable({folder=folder,floor=floor,half=size/2,cfg=cfg,
        landFolder=land,trailFolder=trails,actorsFolder=actors,effectsFolder=fx},Arena)
end
function Arena:Resize() end
function Arena:Destroy()
    if self.folder then self.folder:Destroy() end
end
return Arena
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXModuleWorld"><Properties><string name="Name">World</string><ProtectedString name="Source">local Grid = require(script.Parent.Grid)
local TrailMerge = require(script.Parent.TrailMerge)
local Trails = require(script.Parent.Trails)
local Movement = require(script.Parent.Movement)
local BotAI = require(script.Parent.BotAI)
local CollisionSystem = require(script.Parent.CollisionSystem)
local TerritorySystem = require(script.Parent.TerritorySystem)
local SpawnService = require(script.Parent.SpawnService)

local World = {}
World.__index = World

local function dark(color)
    return Color3.new(color.R * 0.79, color.G * 0.79, color.B * 0.79)
end

function World.new(cfg, onChanged, events)
    local self = setmetatable({}, World)
    self.cfg = cfg
    self.grid = Grid.new(cfg, onChanged)
    self.trails = Trails.new(self.grid, cfg)
    self.ai = BotAI.new(cfg)
    self.entities = {}
    self.time = 0
    self.events = events or {}
    self.completed = false
    self.rng = Random.new()
    return self
end

function World:NewEntity(id, name, color, style)
    local e = {
        id = id, name = name, color = color, darkColor = dark(color),
        personality = style, isHuman = id == 1,
        pos = Vector2.zero, heading = 0, targetHeading = 0,
        alive = false, drawing = false, trailCells = {}, trailSet = {},
        nodes = {}, visualVersion = 0, trailGeneration = 0, spawnRevision = 0, kills = 0, outsideDistance = 0,
        respawnAt = 0, home = Vector2.zero, aiTimer = 0,
        killStreak = 0, bestKillStreak = 0, lastKillAt = -math.huge,
        abilityReadyAt = {}, dashRemaining = 0, dashMultiplier = 1,
    }
    self.entities[id] = e
    return e
end

function World:ChooseSpawn(entity)
    return SpawnService.Choose(self, entity)
end

function World:Spawn(e)
    if self.completed then return false end
    local spawnPosition = self:ChooseSpawn(e)
    if not spawnPosition then
        -- No contested/random fallback: retry when safe unclaimed space exists.
        e.alive = false
        -- Offset retries to avoid scanning the whole map for every bot in one frame.
        e.respawnAt = self.time + (self.cfg.SpawnRetrySeconds or 2.5) + e.id * 0.18
        return false
    end
    self.trails:Clear(e)
    e.spawnRevision += 1
    e.dashRemaining=0
    e.pos = spawnPosition
    e.heading = self.rng:NextNumber(-math.pi, math.pi)
    e.targetHeading = e.heading
    e.home = e.pos
    e.alive = true
    e.respawnAt = 0
    e.aiTimer = 0
    e.waypoints = nil
    self.grid:SpawnLand(e.id, e.pos)
    if not e.isHuman then self.ai:Plan(e, self) end
    if self.events.onSpawn then self.events.onSpawn(e) end
    return true
end

-- Presentation callbacks must not interrupt ownership, elimination or victory.
local function present(callback, ...)
    if not callback then return end
    local ok, err = xpcall(callback, debug.traceback, ...)
    if not ok then warn("[Paintland V27] Presentation callback: " .. tostring(err)) end
end

-- Used by both closed-loop captures and trail joins. Resolve covered heads and
-- exhausted owners, then keep losing owners' largest landmass. Never prune the winner.
function World:ResolveClaims(actor, claimedCells, affectedOwners)
    if not actor.alive or self.completed then return end
    while true do
        local defeated={}
        for _,opponent in ipairs(self.entities) do
            if opponent.alive and opponent.id~=actor.id then
                local headIndex=self.grid:At(opponent.pos)
                if (headIndex and claimedCells[headIndex])
                    or (self.grid.counts[opponent.id] or 0)&lt;=0 then
                    defeated[#defeated+1]=opponent
                end
            end
        end
        if #defeated==0 then break end
        for _,opponent in ipairs(defeated) do
            self:Eliminate(opponent,actor,"enclosed",claimedCells)
        end
    end
    for ownerId in pairs(affectedOwners or {}) do
        local opponent=self.entities[ownerId]
        if ownerId~=actor.id and opponent and opponent.alive then
            self.grid:RemoveDetachedLand(ownerId,opponent.pos)
            if (self.grid.counts[ownerId] or 0)&lt;=0 then
                self:Eliminate(opponent,actor,"enclosed",claimedCells)
            end
        end
    end
end

function World:Eliminate(victim, killer, cause, claimContext, hit)
    -- End-state is immutable: no late trail hit can kill the winner.
    if self.completed then return end
    if not victim or not victim.alive then return end
    local route
    if cause=="trail" and killer and killer~=victim and killer.alive then
        route=TrailMerge.Route(self.grid,killer,victim,hit)
    end
    victim.alive = false
    victim.dashRemaining=0
    victim.killStreak = 0
    victim.lastKillAt = -math.huge
    -- Human's territory remains reserved for the revive choice, unchanged.
    victim.respawnAt = victim.isHuman and math.huge or (self.time + self.cfg.RespawnDelay)
    self.trails:Clear(victim)

    local absorbed, absorbedCount = {}, 0
    local connected, affectedOwners
    if not victim.isHuman then
        if killer and killer ~= victim and killer.alive then
            absorbed, absorbedCount, connected, affectedOwners = self.grid:AbsorbDefeatedLand(victim.id, killer.id, route)
            if connected then
                -- These trail cells are solid land now, not exposed collision targets.
                self.trails:Clear(killer)
            end

            -- NEVER remove the KILLER's territory here. V25's cleanup
            -- could seed from a tiny newly acquired region under the head and
            -- wipe the original majority of the map, causing ~74% -&gt; 0%.
            -- Inherited territory may contain disconnected islands.
            for index in pairs(absorbed) do
                if self.grid.owners[index] ~= killer.id then
                    absorbed[index] = nil
                    absorbedCount -= 1
                elseif claimContext then
                    claimContext[index] = true
                end
            end
        else
            self.grid:TransferAll(victim.id, 0)
        end
    end

    if killer and killer ~= victim then
        killer.kills += 1
        killer.killStreak += 1
        killer.bestKillStreak = math.max(killer.bestKillStreak, killer.killStreak)
        killer.lastKillAt = self.time
    end
    if absorbedCount &gt; 0 and killer then
        -- Purely visual. All owner changes happened instantly above.
        if self.events.onMerge then
            present(self.events.onMerge, killer, victim, absorbed, hit)
        end
        -- Reward transferred territory and the completed route. The killer's
        -- trail is cleared only when that entire exposed route became land.
        if not claimContext and self.events.onAbsorb then
            present(self.events.onAbsorb, killer, absorbedCount, absorbed)
        end
    end
    if self.events.onEliminate then
        present(self.events.onEliminate, victim, killer, cause, hit)
    end
    if connected and killer and killer.alive then
        self:ResolveClaims(killer,absorbed,affectedOwners)
    end
    -- A final trail elimination may transfer the last enemy cells.
    if killer and killer.isHuman then
        -- The last opponent's land can be absorbed during a normal capture
        -- too. Capture will also check after all claims are finalized.
        if not claimContext then self:CheckVictory() end
    end
end

-- Victory is a WORLD state, never inferred later from a HUD refresh.
-- Once the arena is fully owned, the whole match freezes until explicit replay.
function World:CheckVictory()
    if self.completed then return true end
    local player = self.entities[1]
    local total = self.grid.playableTotal
    if not player or not player.alive or total &lt;= 0 then return false end
    -- Cheap fast path: World:Step checks Victory 60 times/second.
    -- Only do a full ownership audit at the very end of the round.
    if (self.grid.counts[player.id] or 0) &lt; total - 2 then return false end
    self.grid:Recount()
    if (self.grid.counts[player.id] or 0) &lt; total then return false end
    self.completed = true
    -- Clear unfinished trails without disturbing the winning territory.
    for _, entity in ipairs(self.entities) do
        self.trails:Clear(entity)
    end
    if self.events.onVictory then
        local ok, err = xpcall(function()
            self.events.onVictory(player, self)
        end, debug.traceback)
        if not ok then
            warn("[Paintland V25] Victory callback error: " .. tostring(err))
        end
    end
    print(string.format("[Paintland V25] VICTORY LOCKED: %d/%d cells", self.grid.counts[player.id] or 0, total))
    return true
end

function World:Capture(e)
    if self.completed then return end
    return TerritorySystem.Capture(self, e)
end

-- Re-enter safely inside existing land. Don't reuse an unfinished trail.
function World:ReviveHuman()
    if self.completed then return false end
    local e = self.entities[1]
    if not e or e.alive then return false end
    self.trails:Clear(e)
    local safePosition = self.grid:FindNearestOwned(e.id, e.pos)
    if not safePosition then
        safePosition = self:ChooseSpawn(e)
        if not safePosition then
            safePosition = SpawnService.ChooseEmergencyRevive(self, e)
        end
        if not safePosition then return false end
        -- Emergency paid revive may overwrite an enemy's area when the
        -- arena is fully occupied. Clean up any disconnected enemy pieces.
        local affected = self.grid:SpawnLand(e.id, safePosition)
        for ownerId in pairs(affected) do
            local opponent = self.entities[ownerId]
            if opponent and opponent.alive then
                if (self.grid.counts[ownerId] or 0) &lt;= 0
                    or self.grid:GetOwnerAt(opponent.pos) == e.id then
                    self:Eliminate(opponent, nil, "enclosed")
                else
                    self.grid:RemoveDetachedLand(ownerId, opponent.pos)
                end
            end
        end
    end
    e.pos = safePosition
    e.home = e.pos
    e.alive = true
    e.respawnAt = 0
    e.spawnRevision += 1
    e.dashRemaining=0
    e.heading = self.rng:NextNumber(-math.pi, math.pi)
    e.targetHeading = e.heading
    if self.events.onSpawn then self.events.onSpawn(e) end
    return true
end

function World:CollisionCheck(mover, position, now)
    if self.completed then return false end
    return CollisionSystem.Check(self, mover, position, now)
end

function World:Step(dt, getHumanHeading)
    if self.completed then return end
    -- Safety net: even a missed capture callback cannot leave a fully owned
    -- arena running long enough for the winner to be eliminated.
    if self:CheckVictory() then return end
    self.time += dt
    for _, e in ipairs(self.entities) do
        if not e.alive then
            if self.time &gt;= e.respawnAt then self:Spawn(e) end
        else
            if e.isHuman then
                local desired = getHumanHeading(e)
                -- No finger / no valid input = stop turning immediately.
                -- Preserve the current heading rather than a stale target angle.
                if desired ~= nil then
                    e.targetHeading = desired
                else
                    e.targetHeading = e.heading
                end
            else
                self.ai:Update(e, self, dt)
            end
            local from = e.pos
            Movement.Step(e, dt, self.cfg, self.grid.half)
            self.trails:Advance(e, from, e.pos, self.time,
                function(p, time)
                    return self:CollisionCheck(e, p, time)
                end,
                function(actor)
                    self:Capture(actor)
                end
            )
            if self.completed then return end
        end
    end
end

function World:Start(playerName, selectedColor)
    local names = table.clone(self.cfg.BotNames)
    for i = #names, 2, -1 do
        local j = self.rng:NextInteger(1, i)
        names[i], names[j] = names[j], names[i]
    end
    self:NewEntity(1, playerName, self.cfg.Colors[selectedColor], "Human")
    self:Spawn(self.entities[1])
    for n = 1, self.cfg.BotCount do
        local id = n + 1
        local color = self.cfg.Colors[(n % (#self.cfg.Colors - 1)) + 2]
        local personality = self.cfg.BotStyles[((n - 1) % #self.cfg.BotStyles) + 1]
        local e = self:NewEntity(id, names[((n - 1) % #names) + 1], color, personality)
        self:Spawn(e)
    end
end

return World
</ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBXInstallStarterPlayerScripts"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBXPaintlandClient"><Properties><string name="Name">PaintlandClient</string><ProtectedString name="Source">-- Full bootstrap guard. If a required module crashes, print the error on screen
-- instead of leaving players staring at an empty arena.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local function showStartupError(message)
    warn("[Paintland V42] " .. tostring(message))
    local old = playerGui:FindFirstChild("PaintlandStartupError")
    if old then old:Destroy() end
    local gui = Instance.new("ScreenGui")
    gui.Name = "PaintlandStartupError"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 999
    gui.Parent = playerGui
    local label = Instance.new("TextLabel")
    label.AnchorPoint = Vector2.new(0.5, 0.5)
    label.Position = UDim2.fromScale(0.5, 0.5)
    label.Size = UDim2.new(0.85, 0, 0, 155)
    label.BackgroundColor3 = Color3.fromRGB(28, 43, 51)
    label.TextColor3 = Color3.fromRGB(255, 241, 236)
    label.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Bold)
    label.TextSize = 17
    label.TextWrapped = true
    label.Text = "PAINTLAND STARTUP ERROR\n" .. tostring(message)
        .. "\nCheck View &gt; Output in Roblox Studio."
    label.Parent = gui
end

local ok, errorMessage = xpcall(function()
    local modules = ReplicatedStorage:WaitForChild("PaintlandModules", 15)
    assert(modules, "Install PaintlandModules under ReplicatedStorage (V42 uses shared modules)")
    local loader = require(modules:WaitForChild("GameLoader", 10))
    loader.Start()
end, debug.traceback)
if not ok then showStartupError(errorMessage) end
</ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item><Item class="Folder" referent="RBXInstallServerScriptService"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBXPaintlandServer"><Properties><string name="Name">PaintlandServer</string><ProtectedString name="Source">-- Paintland V42 server bootstrap. Install under ServerScriptService.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local modules = ReplicatedStorage:WaitForChild("PaintlandModules", 15)
assert(modules, "Install PaintlandModules in ReplicatedStorage")
local Config = require(modules:WaitForChild("Config"))
if Config.MultiplayerEnabled ~= false then
    Players.CharacterAutoLoads = false
    local ok, err = xpcall(function()
        require(modules:WaitForChild("MultiplayerServer")).Start(Config)
    end, debug.traceback)
    if not ok then
        warn("[Paintland V42] Server startup failed: " .. tostring(err))
        ReplicatedStorage:SetAttribute("PaintlandServerError", tostring(err))
    end
end
